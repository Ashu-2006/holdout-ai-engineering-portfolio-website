# ---- build output -------------------------------------------------
# Regenerated by `pnpm build`. Cloudflare builds from source, so the
# committed repo must never carry a stale dist/.
dist/
.output/

# ---- generated ----------------------------------------------------
# Astro writes content-collection types here on dev/build.
.astro/
*.tsbuildinfo

# ---- dependencies -------------------------------------------------
node_modules/
.pnpm-store/

# ---- deploy tooling -----------------------------------------------
# Vercel's local project link (contains project + org ids).
.vercel/
# Wrangler's local state, caches and dev sqlite. Never deployed.
.wrangler/
.dev.vars
.dev.vars.*

# ---- environment --------------------------------------------------
# Secrets. Cloudflare env vars are set in the dashboard, not in-repo.
.env
.env.*
!.env.example
*.local

# ---- editor / OS --------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# ---- agent + MCP scratch ------------------------------------------
# Local AI tooling state. Useful while developing, meaningless to a
# deployment or to anyone cloning the repo.
.playwright-mcp/
.claude/
.agents/
skills-lock.json

# ---- local dev tooling -------------------------------------------
# public/ is copied verbatim into dist/, so anything dropped in here
# would ship. This directory is where per-machine dev tools live
# (see initDevTools in src/scripts/site.ts): each clone decides for
# itself what runs there, and a machine with no such file simply
# gets nothing.
public/_dev/

# ---- personal assets ---------------------------------------------
# Raw source photography. public/avatar.jpg (the cropped, optimised
# 320px version the site actually uses) IS committed; the untouched
# original is not, since nothing needs it.
Pfp image.png
public/avatar.local.*

# ---- verification artefacts --------------------------------------
# Screenshots from browser checks. Regenerated on demand, large, and
# never interesting in a diff.
.shots/

# ---- logs ---------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- test / coverage ----------------------------------------------
coverage/
test-results/
playwright-report/
