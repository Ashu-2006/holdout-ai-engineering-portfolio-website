# Copy to .dev.vars for local `wrangler dev`, or set with
# `npx wrangler secret put <NAME>` for production.
#
# Nothing here is required to run the site. The contact endpoint
# stores messages in D1 with or without these; they only enable
# email forwarding on top of the store.

# Resend API key. Without it, submissions are stored and readable via
#   npx wrangler d1 execute holdout-contact --command "SELECT * FROM submissions"
RESEND_API_KEY=

# Where forwarded submissions go. Also set as a plain var in
# wrangler.jsonc, which is fine: it is not a secret.
CONTACT_TO=you@example.com
