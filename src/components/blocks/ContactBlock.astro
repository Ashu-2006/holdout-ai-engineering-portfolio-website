---
/**
 * The contact surface, shared by the /contact page and the footer.
 *
 * One component on purpose: the footer teaser and the page are the
 * same conversation, and two copies would drift. `full` renders the
 * page variant (adds direct-line rows); the footer gets the compact
 * one.
 *
 * The whole stack is width-capped to the message block (--measure
 * below), per the annotation feedback: cards spanning the full
 * column read as a form, and this is meant to read as a note.
 */
import { Icon } from "astro-icon/components";
import { site } from "../../config/site";

interface Props {
  full?: boolean;
}
const { full = false } = Astro.props;

/* Prefilled, because a blank compose window is a small act of work
   handed to the person kind enough to get in touch. */
const mailto = `mailto:${site.email}?subject=${encodeURIComponent(
  "Your portfolio"
)}&body=${encodeURIComponent(`Hi Ashutosh,\n\n`)}`;

const askAbout = [
  "Why gradient-boosted trees beat a CNN on 41 hours of vibration data",
  "How to pick a refusal threshold without guessing",
  "What INT4 actually costs, with the histogram",
];

const connect = [
  { label: "LinkedIn", icon: "ph:linkedin-logo", url: "https://linkedin.com/" },
  { label: "X", icon: "ph:x-logo", url: "https://x.com/" },
  { label: "GitHub", icon: "ph:github-logo", url: "https://github.com/" },
];

const serverTime = new Intl.DateTimeFormat("en-GB", {
  timeZone: site.timezone,
  hour: "2-digit",
  minute: "2-digit",
  hour12: false,
}).format(new Date());
---

<div class="contact-stack">
  {/* Opening, in his voice. */}
  <div class="reveal flex items-start gap-3">
    <img
      src="/avatar.jpg"
      alt=""
      width="128"
      height="128"
      loading="lazy"
      decoding="async"
      class="mt-0.5 size-9 shrink-0 rounded-xl bg-raised object-cover"
    />
    <div class="min-w-0 space-y-2">
      <p class="bubble">
        I read everything. Internships, questions about the write-ups, or
        telling me a number on this site is wrong.
      </p>
      <p class="bubble">
        Fastest way to reach me is email. It is
        <span class="numeric text-ink" data-clock data-tz={site.timezone} data-seconds="false"
          >{serverTime}</span
        > here right now, so allow for the timezone.
      </p>
    </div>
  </div>

  {/* Two ways in, side by side, no wider than the message block. */}
  <div class="mt-7 grid gap-4 sm:grid-cols-2">
    {/* The compose card: the entire card is a mailto with subject and
        greeting prefilled, so the click lands in a half-written email
        rather than an empty one. Mono field keys, because keys are
        mono everywhere on this site. */}
    <a href={mailto} class="reveal contact-card group" style="--enter-index:1">
      <span class="contact-head">
        <span class="label">Compose</span>
        <Icon
          name="ph:arrow-up-right"
          class="contact-arrow size-4 text-ink-4"
          aria-hidden="true"
        />
      </span>
      <span class="mt-3 block space-y-1.5">
        <span class="field"><span class="field-key">To</span>{site.email}</span>
        <span class="field"><span class="field-key">Subj</span>Your portfolio</span>
        <span class="field"><span class="field-key">From</span>you</span>
      </span>
      <span class="mt-3 block text-ink-3">Hi Ashutosh,</span>
      <span class="caret" aria-hidden="true"></span>
      {/* The block's one CTA. The whole card is the link; this pill
          names what clicking it does, in the site's single emphasis
          shape. */}
      <span class="pill pill-solid w-fit" style="margin-top:1.25rem">
        <Icon name="ph:paper-plane-tilt" class="size-4" aria-hidden="true" />
        Compose this email
      </span>
    </a>

    {/* What we would even talk about: three specifics beat an
        invitation. */}
    <div class="reveal contact-card" style="--enter-index:2">
      <span class="contact-head">
        <span class="label">Ask me about</span>
        <Icon name="ph:chats-circle" class="size-4 text-ink-4" aria-hidden="true" />
      </span>
      <ul class="bullets mt-3">
        {askAbout.map((q) => <li>{q}</li>)}
      </ul>
    </div>
  </div>

  {
    full && (
      <div class="reveal mt-5 grid gap-3 sm:grid-cols-2" style="--enter-index:3">
        {/* The direct lines, for the page variant only: the footer
            teaser stays compact. Copy buttons rather than bare text,
            because the next step after reading an address is always
            putting it somewhere. */}
        <div class="contact-card">
          <span class="contact-head">
            <span class="label">Email</span>
            <Icon name="ph:envelope-simple" class="size-4 text-ink-4" aria-hidden="true" />
          </span>
          <p class="numeric mt-2 text-ink">{site.email}</p>
          <button type="button" data-copy-email={site.email} class="pill mt-3">
            <Icon name="ph:copy" class="size-4" aria-hidden="true" />
            <span data-copy-label>Copy address</span>
          </button>
        </div>
        <div class="contact-card">
          <span class="contact-head">
            <span class="label">Phone</span>
            <Icon name="ph:phone" class="size-4 text-ink-4" aria-hidden="true" />
          </span>
          <p class="numeric mt-2 text-ink">{site.phone}</p>
          <a href="tel:+918780894071" class="pill mt-3">
            <Icon name="ph:phone-call" class="size-4" aria-hidden="true" />
            Call
          </a>
        </div>
      </div>
    )
  }

  {/* Platform rows: hug their content, flow as a row. */}
  <ul class="mt-7 flex flex-wrap gap-2">
    {
      connect.map((c, i) => (
        <li class="reveal" style={`--enter-index:${4 + i}`}>
          <a href={c.url} rel="me noopener" target="_blank" class="connect group">
            <Icon name={c.icon} class="size-4 shrink-0 text-ink-2" aria-hidden="true" />
            <span class="text-ink">{c.label}</span>
            <Icon
              name="ph:arrow-up-right"
              class="contact-arrow size-3.5 shrink-0 text-ink-4"
              aria-hidden="true"
            />
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  /* Fills its column. An inner cap left a dead gutter on the right
     and made the cards read as a narrow form pasted into a wide
     page; the column (768px) is already the measure. */
  .contact-stack {
    width: 100%;
  }

  /* A rounded surface with a hairline, not a filled grey blob: it
     reads as an utterance because of the radius and the stacking,
     which is all the metaphor needs. */
  .bubble {
    display: block;
    border: 1px solid var(--color-line-2);
    background-color: var(--color-surface);
    border-radius: var(--radius-bubble);
    border-top-left-radius: 0.375rem;
    padding: 0.625rem 0.875rem;
    color: var(--color-ink-2);
    text-wrap: pretty;
  }
  .bubble + .bubble {
    border-top-left-radius: var(--radius-bubble);
  }

  .contact-card {
    position: relative;
    display: block;
    border: 1px solid var(--color-line-2);
    background-color: var(--color-surface);
    border-radius: var(--radius-card);
    padding: 1.125rem 1.25rem;
    transition:
      border-color var(--motion-hover),
      background-color var(--motion-hover);
  }
  a.contact-card:hover {
    border-color: var(--color-ink-4);
    background-color: var(--color-sunken);
  }
  /* Card and CTA read as one control: hovering anywhere lights both. */
  a.contact-card:hover :global(.pill-solid) {
    opacity: 0.88;
  }
  .contact-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .contact-arrow {
    transition: transform var(--motion-hover);
  }
  .group:hover .contact-arrow {
    transform: translate(2px, -2px);
  }

  .field {
    display: flex;
    gap: 0.5rem;
    color: var(--color-ink-2);
    min-width: 0;
  }
  .field-key {
    flex: none;
    inline-size: 2.75rem;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    line-height: var(--text-body--line-height);
    letter-spacing: var(--text-label--letter-spacing);
    text-transform: uppercase;
    color: var(--color-ink-4);
  }

  /* A blinking caret after "Hi Ashutosh," so the card reads as a
     message already partway written. */
  .caret {
    display: inline-block;
    width: 1px;
    height: 1.05em;
    margin-left: -0.35rem;
    vertical-align: text-bottom;
    background-color: var(--color-ink);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  /* Platform pills hug their content. */
  .connect {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid var(--color-line-2);
    border-radius: 999px;
    padding: 0.4375rem 0.875rem;
    transition:
      border-color var(--motion-hover),
      background-color var(--motion-hover);
  }
  .connect:hover {
    border-color: var(--color-ink-4);
    background-color: var(--color-sunken);
  }

  @media (prefers-reduced-motion: reduce) {
    .caret {
      animation: none;
    }
  }
</style>
