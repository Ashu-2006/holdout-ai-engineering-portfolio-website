---
/**
 * Compact post rows, used on the home page's Writing teaser. The
 * full shelf at /writing uses the card grid; this row form exists
 * because the home page is a sampler and three rows scan faster
 * than three cards.
 */
import type { CollectionEntry } from "astro:content";

interface Props {
  items: CollectionEntry<"posts">[];
}
const { items } = Astro.props;

const fmt = (d: Date) =>
  new Intl.DateTimeFormat("en-GB", {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
  })
    .format(d)
    .replace(/\//g, ".");
---

{
  items.length === 0 ? (
    <p class="text-ink-3">No posts published yet.</p>
  ) : (
    <div class="rows border-t border-line-2">
      {items.map((post) => (
        <a
          href={`/writing/${post.id}`}
          class="row-interactive group flex items-center gap-3 py-3"
        >
          <img
            src={post.data.cover}
            alt=""
            width="1000"
            height="500"
            loading="lazy"
            decoding="async"
            class="h-11 w-16 shrink-0 rounded-md border border-line-2 bg-surface object-cover"
          />
          <span class="min-w-0 flex-1">
            <span class="link-draw-child relative inline-block max-w-full truncate align-bottom text-ink">
              {post.data.title}
            </span>
            <span class="mt-0.5 line-clamp-1 block text-ink-3">
              {post.data.description}
            </span>
          </span>
          <span class="numeric hidden shrink-0 text-right text-label tracking-[0.04em] text-ink-4 sm:block">
            <span class="block">{fmt(post.data.date)}</span>
            <span class="block">{post.data.readingTime}</span>
          </span>
        </a>
      ))}
    </div>
  )
}
