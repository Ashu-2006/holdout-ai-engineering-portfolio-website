---
import { Icon } from "astro-icon/components";
---

<div>
  <img
    src="https://github.com/fayazara.png"
    alt="Fayaz Ahmed"
    height="52"
    width="52"
    class="rounded"
  />
  <h1 class="mt-4 font-medium">Fayaz Ahmed</h1>
  <p class="mt-3 text-neutral-600 text-pretty">
    I work as a Senior Developer Educator at Cloudflare. I live in Bengaluru,
    India. I love building things and making them {" "}
    <a
      href="https://github.com/fayazara"
      class="text-neutral-700 inline-flex items-center gap-0.5"
      >open source <Icon name="ph:arrow-square-up-right-bold" class="size-4" />
    </a>
  </p>
  <p class="mt-2 text-neutral-600 text-pretty">
    I build a lot of things and I genuinely enjoy sharing what I learn with
    others.
  </p>
</div>
