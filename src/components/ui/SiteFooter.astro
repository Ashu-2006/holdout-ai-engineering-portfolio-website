---
/**
 * Footer: the contact teaser and the outline wordmark, nothing else.
 * The contact surface lives in ContactBlock, shared with /contact so
 * the two cannot drift; the footer renders the compact variant and
 * links the page for the rest.
 */
import ContactBlock from "../blocks/ContactBlock.astro";
---

{/*
  The footer reverses against the page: dark under a light page, light
  under a dark one.

  It needs no top border any more. A hairline separates two things
  sharing a ground; here the ground itself changes, so a rule on top of
  that is a second separator doing a job already done. It would also
  have been drawn in the footer's OWN inverted --color-line-2, which is
  a white alpha and invisible against the light page above it.

  The compose card inside carries .invert-surface too. Nested, it
  resolves to the same palette rather than flipping back, so the card
  becomes a raised panel within the dark footer instead of a hole
  punched through it. That is the right relationship: on /contact the
  card is the emphasis against a light page, and here the footer is.
*/}
<footer class="invert-surface relative mt-12">
  <div class="column py-10">
    <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
      <h2 class="band-title">Get in touch</h2>
      <a
        href="/contact"
        class="label transition-colors duration-fast ease-out hover:text-ink"
      >
        Contact page &#8594;
      </a>
    </div>

    <div class="mt-5">
      <ContactBlock />
    </div>

  </div>

  {/*
    The outline wordmark. Clipped to half its height so it reads as a
    watermark rising out of the page edge rather than as a heading;
    stroked SVG rather than -webkit-text-stroke so it renders the
    same off Chromium.
  */}
  <div
    class="pointer-events-none overflow-hidden border-t border-line-2 select-none"
    aria-hidden="true"
  >
    <svg
      viewBox="0 0 1200 150"
      class="mark -mb-px block h-16 w-full sm:h-24"
      preserveAspectRatio="xMidYMax slice"
    >
      <text
        x="600"
        y="140"
        text-anchor="middle"
        font-family="Geist, system-ui, sans-serif"
        font-size="150"
        font-weight="600"
        letter-spacing="-6"
        fill="none"
        stroke="currentColor"
        stroke-width="1.25">ASHUTOSH</text
      >
    </svg>
  </div>
</footer>

<style>
  .mark {
    color: var(--color-line);
  }
</style>
