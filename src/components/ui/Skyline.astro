---
/**
 * The bottom bar: a pixel-art city, drawn at build time.
 *
 * Adapted from ritikgoyal.in's footer scene. What was taken is the
 * STYLE, extracted with designlang: flat material, one flat colour on
 * the page ground, zero corner radius, pixel-grid artwork, a small sign
 * in mono type, and a pill CTA over the scene.
 *
 * What was deliberately NOT taken:
 *
 *  1. THEIR BLUE. #0a3bae is a brand colour this site does not have,
 *     and a saturated blue silhouette would be the only chroma on the
 *     page outside the status tokens and the contribution graph. The
 *     city is drawn in --color-ink instead, so it reads as one more
 *     thing drawn on the sheet and inverts correctly in dark mode,
 *     which the reference never has to handle because it is light only.
 *  2. THE CANVAS. Theirs is a <canvas> and every pixel depends on
 *     JavaScript. This is an SVG built in frontmatter: it renders with
 *     JS off, survives a failed bundle, and costs the main thread
 *     nothing. Same output, fewer ways to end up with an empty band.
 *  3. THE AUDIO. Their pill plays birdsong. Sound is a preference, not
 *     a default, and the same delight is available without reaching for
 *     the speaker: this pill lights the windows.
 *
 * SEEDED, so a rebuild is byte-identical. An unseeded generator would
 * redraw the skyline on every deploy and turn a decorative band into a
 * diff, which is why the contribution heatmap is seeded too.
 *
 * SPRITES ARE AUTHORED AS BITMAP STRINGS. A cloud written as rows of
 * dots and Xs is legible in review and editable by anyone; the same
 * shape as a list of rect coordinates is neither.
 */

/* One pixel, in viewBox units. Everything snaps to this, which is the
   whole trick: nothing is allowed a half-pixel edge. */
const PX = 4;
const W = 960;

/*
 * VIEWBOX HEIGHT IS 152, AND THE RATIO IS THE POINT.
 *
 * The first version was 224 tall inside a fixed-height band with
 * preserveAspectRatio="slice". At 1440px that scales 1.5x, so only
 * 224/1.5 = 149 units of the viewBox fit and the top third was cropped
 * away: every cloud and bird sat in the part nobody could see. The band
 * is sized by aspect ratio now (height:auto, "meet"), so nothing is
 * ever cropped and the sky is guaranteed to be on screen.
 *
 * The cost is a band whose height tracks viewport width, 15.8% of it:
 * about 61px on a phone and 228px at 1440. That is the correct trade
 * for scenery, and it is why the sky is kept shallow.
 */
const H = 152;
const COLS = W / PX; // 240
const GROUND_Y = H - PX * 2;
const ROWS = GROUND_Y / PX; // 36

/* Same seeded generator the heatmap uses. */
function rng(seed: number) {
  let a = seed >>> 0;
  return () => {
    a = (a + 0x6d2b79f5) >>> 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const r = rng(20260902);
const pick = (n: number) => Math.floor(r() * n);

interface Cell {
  x: number;
  y: number;
  w: number;
  h: number;
}
const solids: Cell[] = [];
const panes: Cell[] = [];

const put = (cx: number, cy: number, cw = 1, ch = 1) =>
  solids.push({ x: cx * PX, y: cy * PX, w: cw * PX, h: ch * PX });

/**
 * A tower: a block, then a window grid inside it.
 *
 * Windows are inset two columns and spaced three apart so the lit dots
 * never touch each other or the silhouette edge. Touching dots stop
 * reading as windows and start reading as a texture.
 */
function tower(cx: number) {
  const cw = 4 + pick(9); // 4..12 columns
  const ch = 4 + pick(23); // 4..26 rows, capped clear of the sky
  const top = ROWS - ch;
  put(cx, top, cw, ch);

  /* An occasional roof mast, on tall towers only. Every tower wearing
     one reads as a pattern rather than as a skyline. */
  if (ch > 18 && r() < 0.4) put(cx + Math.floor(cw / 2), top - 2 - pick(2), 1, 3);

  for (let wy = top + 2; wy < ROWS - 2; wy += 3) {
    for (let wx = cx + 2; wx < cx + cw - 2; wx += 3) {
      if (r() < 0.62) panes.push({ x: wx * PX, y: wy * PX, w: PX, h: PX });
    }
  }
  return cw;
}

/**
 * A tree: a canopy narrowing toward the top, on a one-pixel trunk.
 * Drawn row by row rather than as a shape, so the edge stays stepped.
 */
function tree(cx: number) {
  const cw = 5 + pick(3) * 2; // odd widths keep the trunk centred
  const ch = 4 + pick(3);
  const top = ROWS - ch - 2;
  for (let row = 0; row < ch; row++) {
    /* Only the top row narrows. Tapering all the way down would read as
       a triangle rather than a tree. */
    const inset = row === 0 ? 1 : 0;
    put(cx + inset, top + row, cw - inset * 2, 1);
  }
  put(cx + Math.floor(cw / 2), ROWS - 2, 1, 2);
  return cw;
}

/* Lay the block out left to right, leaving a one-column gap so the
   silhouette has a rhythm instead of being one continuous wall. */
let col = 0;
while (col < COLS) {
  col += (r() < 0.17 ? tree(col) : tower(col)) + 1;
}

/* ================================================================
   Sprites. "X" is a pixel, anything else is a gap.
   ================================================================ */
const CLOUD = ["...XXXX...", ".XXXXXXXX.", "XXXXXXXXXX"];
const CLOUD_SM = ["..XXX..", ".XXXXX.", "XXXXXXX"];
const BIRD = ["XX...XX", "..X.X..", "...X..."];

/*
 * The cyclist, 24x15. Built from two 6-wide wheel rings on a frame,
 * with the rider leaning forward over the bars.
 *
 * The first attempt drew the legs as free diagonals and it read as a
 * stick figure falling over, because a diagonal on a pixel grid needs a
 * stepped edge to look drawn rather than drifted. Each limb here moves
 * one column per row.
 */
const CYCLIST = [
  "...........XX...........",
  "..........X..X..........",
  "...........XX...........",
  ".........XXX............",
  "........X..X............",
  ".......X...XX...........",
  "......X......X..........",
  ".....XXXXXXXXXX.........",
  "....X....X....X.........",
  "..XXXX...X...XXXX.......",
  ".X....X.X.X.X....X......",
  "X......X...X......X.....",
  "X......X...X......X.....",
  ".X....X.....X....X......",
  "..XXXX.......XXXX.......",
];

/** Bitmap to cells, at an origin given in COLUMNS/ROWS. */
function sprite(map: string[], cx: number, cy: number) {
  const out: Cell[] = [];
  map.forEach((row, ry) => {
    [...row].forEach((ch, rx) => {
      if (ch === "X") out.push({ x: (cx + rx) * PX, y: (cy + ry) * PX, w: PX, h: PX });
    });
  });
  return out;
}

/* Clouds drift, so each is authored at x=0 and moved by CSS. The
   durations are deliberately not multiples of each other, or they
   resynchronise into a single clump every few minutes. */
const clouds = [
  { map: CLOUD, y: 1, dur: 61, delay: 0, o: 1 },
  { map: CLOUD_SM, y: 5, dur: 47, delay: -18, o: 0.72 },
  { map: CLOUD, y: 3, dur: 79, delay: -41, o: 0.5 },
];

const birds = [
  { x: 172, y: 2, dur: 2.6, delay: 0 },
  { x: 180, y: 5, dur: 2.6, delay: -0.6 },
  { x: 188, y: 1, dur: 2.6, delay: -1.2 },
];

/*
 * The sign and the rider get composed positions rather than random
 * ones: they are the two things a reader actually looks at.
 *
 * Both are painted after the city, so they sit in front of whatever
 * towers happen to generate behind them.
 */
const SIGN_X = 94;
const SIGN_TOP = 11;
const SIGN_W = 44;
const SIGN_H = 8;
const RIDER_X = 52;
const RIDER_Y = ROWS - 17;
const riderCells = sprite(CYCLIST, RIDER_X, RIDER_Y);

/**
 * KNOCKOUTS.
 *
 * The sign and the rider are drawn in ink, and so is every tower behind
 * them, so at first pass both vanished into the silhouette: a bicycle
 * rendered in the same flat colour as the building it is standing in
 * front of is not a bicycle, it is texture.
 *
 * Each therefore gets a ground-filled backing one pixel larger than its
 * own bounding box, painted first. It reads as a deliberate cut-out in
 * the block, which is how flat pixel art separates a foreground subject
 * from its background without a second colour or an outline.
 */
function knockout(cells: Cell[], pad = PX) {
  const x = Math.min(...cells.map((c) => c.x)) - pad;
  const y = Math.min(...cells.map((c) => c.y)) - pad;
  const x2 = Math.max(...cells.map((c) => c.x + c.w)) + pad;
  const y2 = Math.max(...cells.map((c) => c.y + c.h)) + pad;
  return [{ x, y, w: x2 - x, h: y2 - y }];
}

/**
 * A one-pixel outline around a sprite: every grid position touching a
 * sprite pixel that is not itself one.
 *
 * The rider used the rectangular knockout above and it was wrong. A
 * bbox punches a clean rectangle through whatever is behind it, and
 * behind the bicycle is a tower, so it sliced a building in half and
 * left the remaining sliver standing there looking like a stray pole.
 * An outline separates the subject and touches nothing else.
 *
 * The billboard keeps the bbox, because a billboard IS a rectangle and
 * a rectangular hole around it reads as intended.
 */
function outline(cells: Cell[]) {
  const key = (x: number, y: number) => `${x},${y}`;
  const filled = new Set(cells.map((c) => key(c.x, c.y)));
  const ring = new Map<string, Cell>();
  for (const c of cells) {
    for (let dy = -1; dy <= 1; dy++) {
      for (let dx = -1; dx <= 1; dx++) {
        const x = c.x + dx * PX;
        const y = c.y + dy * PX;
        if (!filled.has(key(x, y))) ring.set(key(x, y), { x, y, w: PX, h: PX });
      }
    }
  }
  return [...ring.values()];
}

/* Billboard: a ground-filled panel so the type has something to sit on,
   an ink border, and two legs down into the block. */
const signPanel: Cell[] = [
  { x: SIGN_X * PX, y: SIGN_TOP * PX, w: SIGN_W * PX, h: SIGN_H * PX },
];
const signFrame: Cell[] = [
  { x: SIGN_X * PX, y: SIGN_TOP * PX, w: SIGN_W * PX, h: PX },
  { x: SIGN_X * PX, y: (SIGN_TOP + SIGN_H - 1) * PX, w: SIGN_W * PX, h: PX },
  { x: SIGN_X * PX, y: SIGN_TOP * PX, w: PX, h: SIGN_H * PX },
  { x: (SIGN_X + SIGN_W - 1) * PX, y: SIGN_TOP * PX, w: PX, h: SIGN_H * PX },
  { x: (SIGN_X + 7) * PX, y: (SIGN_TOP + SIGN_H) * PX, w: PX, h: 9 * PX },
  { x: (SIGN_X + SIGN_W - 8) * PX, y: (SIGN_TOP + SIGN_H) * PX, w: PX, h: 9 * PX },
];

/** Cells to one path. One node instead of hundreds of <rect>. */
const path = (cells: Cell[]) =>
  cells.map((c) => `M${c.x} ${c.y}h${c.w}v${c.h}h-${c.w}z`).join("");
---

<div class="skyline" data-skyline>
  {/*
    The pill sits ABOVE the scene in normal flow, not floated over the
    sky like the reference's. Its sky is 400px tall and has room; this
    band is a third of that, so an absolutely positioned pill landed on
    top of the billboard at every width. In flow it cannot collide with
    anything, at any viewport, without a single media query.
  */}
  <div class="skyline-bar">
    <button type="button" class="pill pill-solid skyline-toggle" data-lights hidden>
      <span class="skyline-bulb" aria-hidden="true"></span>
      <span data-lights-label>Turn the lights on</span>
    </button>
  </div>

  {/*
    aria-hidden and role=presentation: it is scenery. A screen reader
    announcing 300 rectangles, three birds and a bicycle at the end of
    every page is noise, and nothing here carries information the rest
    of the page does not already state.
  */}
  <svg
    class="skyline-svg"
    viewBox={`0 0 ${W} ${H}`}
    preserveAspectRatio="xMidYMax slice"
    aria-hidden="true"
    role="presentation"
    focusable="false"
  >
    <g class="sky">
      {
        clouds.map((c) => (
          <g class="cloud" style={`--dur:${c.dur}s; --delay:${c.delay}s; opacity:${c.o}`}>
            <path d={path(sprite(c.map, 0, c.y))} />
          </g>
        ))
      }
      {
        birds.map((b) => (
          <g class="bird" style={`--dur:${b.dur}s; --delay:${b.delay}s`}>
            <path d={path(sprite(BIRD, b.x, b.y))} />
          </g>
        ))
      }
    </g>

    {/*
      ONE PATH FOR THE WHOLE CITY, not 300 <rect> elements. Same pixels,
      one node: the DOM stays small, the browser styles and paints a
      single shape, and the markup does not add tens of kilobytes of
      attributes to every page.
    */}
    <path class="city" d={path(solids)} />
    <path class="panes" d={path(panes)} />

    <g class="sign">
      {/* Knockout, then panel, then frame: the legs need the same
          separation from the towers behind them as the panel does. */}
      <path class="knockout" d={path(knockout(signFrame))} />
      <path class="sign-panel" d={path(signPanel)} />
      <path d={path(signFrame)} />
      <text
        class="sign-text"
        x={(SIGN_X + SIGN_W / 2) * PX}
        y={(SIGN_TOP + 5) * PX}
        text-anchor="middle">SHIP IT MEASURED</text
      >
    </g>

    <g class="rider">
      <path class="knockout" d={path(outline(riderCells))} />
      <path d={path(riderCells)} />
    </g>

    {/* The ground line, painted last so it sits over every footing. */}
    <path class="ground" d={path([{ x: 0, y: GROUND_Y, w: W, h: PX }])} />
  </svg>
</div>

<style>
  .skyline {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .skyline-bar {
    display: flex;
    justify-content: center;
    padding-block: 1.5rem 1.25rem;
  }

  .skyline-svg {
    display: block;
    width: 100%;
    /*
     * max(8rem, 15.84vw) with "slice", and the two numbers are doing
     * different jobs.
     *
     * 15.84vw is exactly the viewBox ratio (152/960). At or above that
     * height, "slice" resolves identically to "meet": the whole city
     * fits and nothing is cropped. That is the wide case.
     *
     * The 8rem floor takes over below ~810px, and there "slice" crops
     * the sides instead of shrinking everything. That is the point.
     * With height:auto the band was 59px on a phone, the pixels were
     * under 2px and the billboard was unreadable. Cropping to the
     * middle of the city keeps the pixel size honest and shows less
     * scenery, which for scenery is the right thing to give up.
     *
     * xMidYMax anchors that crop to the horizon and the centre, so the
     * billboard, which sits at 39-58% across, survives on every width.
     */
    height: max(8rem, 15.84vw);
    color: var(--color-ink);
  }

  .city,
  .sign,
  .rider,
  .ground {
    fill: currentColor;
  }
  .sky {
    fill: currentColor;
    opacity: 0.24;
  }

  /* The panel is the page ground, so the sign reads as a lit board and
     the mono type on it needs no second colour token. */
  .sign-panel,
  .knockout {
    fill: var(--color-ground);
  }
  .sign-text {
    fill: var(--color-ink);
    font-family: var(--font-mono);
    font-size: 13px; /* user units; lands near the label step once scaled */
    letter-spacing: 0.04em;
  }

  /*
   * Windows are cut out of the city in the page ground rather than
   * painted on top, so they stay correct in both themes and through the
   * lights toggle without a second colour token.
   */
  .panes {
    fill: var(--color-ground);
    opacity: 0.5;
    transition: opacity var(--duration-slow) var(--ease-out);
  }
  :global([data-skyline][data-lit]) .panes {
    opacity: 1;
  }

  /* ---- motion ------------------------------------------------
     All three are transforms on a group, so they composite and never
     touch layout. translate() in an SVG CSS transform is in user units,
     which is why these are written against the 960-wide viewBox. */
  .cloud {
    animation: drift var(--dur) linear var(--delay) infinite;
  }
  @keyframes drift {
    from {
      transform: translate(-120px, 0);
    }
    to {
      transform: translate(1000px, 0);
    }
  }

  .bird {
    animation: bob var(--dur) ease-in-out var(--delay) infinite;
  }
  @keyframes bob {
    0%,
    100% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(-5px, -4px);
    }
  }

  /* steps(), not an ease: pixel art that eases looks like pixel art
     sliding around, and a two-frame bob is what a sprite does. */
  .rider {
    animation: pedal 0.9s steps(2, jump-none) infinite;
  }
  @keyframes pedal {
    0%,
    100% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(0, -4px);
    }
  }

  /* ---- the pill ---------------------------------------------- */
  .skyline-toggle {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--text-label--letter-spacing);
    text-transform: uppercase;
    line-height: 1;
    white-space: nowrap;
  }
  .skyline-bulb {
    width: 7px;
    height: 7px;
    flex: none;
    background-color: currentColor;
    opacity: 0.45;
    transition: opacity var(--motion-hover);
  }
  :global([data-skyline][data-lit]) .skyline-bulb {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .cloud,
    .bird,
    .rider {
      animation: none;
    }
    .panes {
      transition: none;
    }
  }

  /* Scenery is not worth a page of toner. */
  @media print {
    .skyline {
      display: none;
    }
  }
</style>

<script>
  /*
   * Lights toggle. The windows already render without this, so the
   * button is revealed only once the script is running: a visible
   * control that cannot do anything is worse than no control.
   */
  const scene = document.querySelector<HTMLElement>("[data-skyline]");
  const btn = scene?.querySelector<HTMLButtonElement>("[data-lights]");
  const label = btn?.querySelector<HTMLElement>("[data-lights-label]");

  if (scene && btn && label) {
    btn.hidden = false;
    btn.setAttribute("aria-pressed", "false");

    btn.addEventListener("click", () => {
      const lit = scene.toggleAttribute("data-lit");
      btn.setAttribute("aria-pressed", String(lit));
      /* The label states what the NEXT press does, which is the
         convention for a toggle rendered as a button. aria-pressed
         carries the current state for anyone not reading the label. */
      label.textContent = lit ? "Turn the lights off" : "Turn the lights on";
    });
  }
</script>
