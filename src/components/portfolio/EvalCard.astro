---
import type { CollectionEntry } from "astro:content";

interface Props {
  result: CollectionEntry<"systems">["data"]["evals"][number];
}
const { result } = Astro.props;

/** Scores may be "0.94" or "94%"; normalise both to a percentage width. */
function toPercent(raw: string): number {
  const n = parseFloat(raw.replace(/[^0-9.]/g, ""));
  if (Number.isNaN(n)) return 0;
  return Math.min(100, Math.round(n <= 1 ? n * 100 : n));
}

const scorePct = toPercent(result.score);
const basePct = toPercent(result.baseline);
const delta = scorePct - basePct;
/** The baseline string carries its own label, e.g. "0.71 (dense-only)". */
const baselineNote = result.baseline.replace(/^[^\s(]+\s*/, "").replace(/[()]/g, "");
---
<div class="card reveal overflow-hidden">
  <div class="flex items-baseline justify-between gap-4 border-b border-line p-5">
    <h3 class="text-[13px] font-medium text-ink">{result.metric}</h3>
    <p class="text-[11px] text-ink-4">{result.method}</p>
  </div>

  <div class="space-y-4 p-5">
    <div>
      <div class="mb-2 flex items-baseline justify-between">
        <span class="text-[13px]">measured</span>
        <span class="numeric text-xl font-medium text-measured">{result.score}</span>
      </div>
      <div class="h-1.5 overflow-hidden rounded-full bg-sunken">
        <div class="bar h-full rounded-full bg-measured" style={`--target:${scorePct}%`}></div>
      </div>
    </div>

    <div>
      <div class="mb-2 flex items-baseline justify-between">
        <span class="text-[11px] text-ink-4">baseline{baselineNote && `, ${baselineNote}`}</span>
        <span class="numeric text-base text-ink-3">{result.baseline.split(" ")[0]}</span>
      </div>
      <div class="h-1.5 overflow-hidden rounded-full bg-sunken">
        <div class="bar h-full rounded-full bg-ink-4" style={`--target:${basePct}%; --bar-delay:100ms`}></div>
      </div>
    </div>

    <dl class="flex gap-8 pt-1">
      <div>
        <dd class="numeric text-base font-medium text-ink">{result.datasetSize.toLocaleString("en")}</dd>
        <dt class="mt-0.5 text-[11px] text-ink-4">cases evaluated</dt>
      </div>
      <div>
        <dd class="numeric text-base font-medium text-measured">+{delta}pt</dd>
        <dt class="mt-0.5 text-[11px] text-ink-4">over baseline</dt>
      </div>
    </dl>
  </div>

  <div class="flex gap-3 border-t border-line bg-sunken p-5">
    <p class="shrink-0 pt-0.5 text-[11px] text-caution">where it fails</p>
    <p class="text-[13px] leading-relaxed">{result.failureNotes}</p>
  </div>
</div>

<style>
  /* The bar is sized at its target and grown with a transform, not a
     width transition. Width triggers layout on every frame; scaleX
     runs on the compositor. transform-origin pins it to the left so it
     grows out of the track rather than out of its own centre. */
  .bar {
    width: var(--target);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--motion-reveal);
    transition-delay: var(--bar-delay, 0ms);
  }
  [data-seen="true"] .bar { transform: scaleX(1); }
</style>
