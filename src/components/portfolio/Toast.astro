---
/* Driven by the copy shortcut in scripts/dock.ts. */
---
<p
  data-toast
  role="status"
  aria-live="polite"
  class="toast pointer-events-none fixed bottom-24 left-1/2 z-60 -translate-x-1/2 rounded-full bg-ink px-3 py-1.5 text-xs text-ground"
>
  email copied
</p>

<style>
  .toast {
    opacity: 0;
    transform: translate(-50%, 8px);
    transition:
      opacity var(--motion-hover),
      transform var(--motion-disclose);
  }
  .toast[data-show] { opacity: 1; transform: translate(-50%, 0); }
</style>
