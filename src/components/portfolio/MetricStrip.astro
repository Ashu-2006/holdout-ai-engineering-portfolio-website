---
import type { CollectionEntry } from "astro:content";
import EvidenceChip from "./EvidenceChip.astro";

interface Props {
  metrics: CollectionEntry<"systems">["data"]["metrics"];
}
const { metrics } = Astro.props;
---

{
  /* auto-fit, not a fixed column count. Three metrics in a four-column
     grid leaves a hole that reads as a missing fourth number. */
}
<dl class="strip reveal">
  {metrics.map((m) => <EvidenceChip metric={m} />)}
</dl>

<style>
  .strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    gap: var(--space-block) var(--space-group);
  }
</style>
