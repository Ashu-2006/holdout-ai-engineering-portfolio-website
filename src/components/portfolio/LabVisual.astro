---
interface Props {
  kind: "tokens" | "heatmap" | "histogram";
}
const { kind } = Astro.props;

/** Deterministic so server and client markup match. */
function pseudoRandom(i: number): number {
  return Math.abs((Math.sin(i * 12.9898) * 43758.5453) % 1);
}

const tokens = Array.from({ length: 11 }, (_, i) => i % 3 === 0);
const cells = Array.from({ length: 40 }, (_, i) => pseudoRandom(i) * 0.6 + 0.06);
const bars = Array.from({ length: 16 }, (_, i) => ({
  height: 18 + Math.abs(Math.sin(i * 0.9)) * 60,
  strong: i > 9,
}));
---
<div class="relative h-28 overflow-hidden bg-sunken" aria-hidden="true">
  {kind === "tokens" && (
    <div class="absolute inset-0 flex items-center gap-[3px] px-4">
      {tokens.map((strong, i) => (
        <span
          class:list={["piece h-6 flex-1 rounded-md", strong ? "bg-ink-3 opacity-55" : "bg-ink-4 opacity-30"]}
          style={`--piece-index:${i}`}
        />
      ))}
    </div>
  )}

  {kind === "heatmap" && (
    <div class="absolute inset-0 grid grid-cols-8 grid-rows-5 gap-[3px] p-4">
      {cells.map((opacity, i) => (
        <span class="piece rounded-sm bg-measured" style={`opacity:${opacity.toFixed(3)}; --piece-index:${i}`} />
      ))}
    </div>
  )}

  {kind === "histogram" && (
    <div class="absolute inset-0 flex items-end gap-[3px] px-4 pb-4">
      {bars.map((bar, i) => (
        <span
          class:list={["piece flex-1 rounded-t-sm bg-ink-4", bar.strong ? "opacity-55" : "opacity-30"]}
          style={`height:${bar.height.toFixed(1)}%; --piece-index:${i}`}
        />
      ))}
    </div>
  )}
</div>

<style>
  .piece {
    transition:
      opacity var(--motion-disclose),
      transform var(--motion-disclose);
    /* Sub-frame stagger. Pieces of one figure, not a list of items,
       so this is deliberately tighter than --stagger-step. */
    transition-delay: calc(var(--piece-index) * var(--stagger-figure));
  }
  .lab:hover .piece { opacity: 0.8; }
  :global(.lab:hover) .piece { transform: scaleY(1.15); transform-origin: bottom; }
</style>
