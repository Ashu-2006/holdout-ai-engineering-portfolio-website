---
import type { CollectionEntry } from "astro:content";
import LabVisual from "./LabVisual.astro";

interface Props {
  items: CollectionEntry<"lab">[];
}
const { items } = Astro.props;
---
<ul class="reveal grid gap-3 sm:grid-cols-3">
  {items.map(({ id, data }) => (
    <li>
      <a href={`/lab/${id}`} class="lab card card-interactive block overflow-hidden">
        <LabVisual kind={data.visual} />
        <div class="p-4">
          <h3 class="text-[14px] font-medium text-ink">{data.title}</h3>
          <p class="mt-1 text-[13px] leading-snug text-ink-3">{data.blurb}</p>
        </div>
      </a>
    </li>
  ))}
</ul>
