---
import type { CollectionEntry } from "astro:content";
import LabVisual from "./LabVisual.astro";
import CollectionCount from "./CollectionCount.astro";

interface Props {
  items: CollectionEntry<"lab">[];
}
const { items } = Astro.props;
---

<div class="reveal">
  <CollectionCount count={items.length} noun="explainers" />

  <ul class="lab-grid">
    {
      items.map(({ id, data }) => (
        <li>
          {/* The visual is the only fill here. It is a well, not a raised
              card: it sits below the page ground, which is how a figure
              reads without a border around it. */}
          <a href={`/lab/${id}`} class="lab-item">
            <span class="lab-figure">
              <LabVisual kind={data.visual} />
            </span>
            <span class="lab-title">{data.title}</span>
            <span class="lab-blurb">{data.blurb}</span>
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .lab-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: var(--space-group);
  }

  .lab-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-tight);
  }

  .lab-figure {
    display: block;
    overflow: hidden;
    border-radius: var(--radius-card);
    margin-bottom: var(--space-tight);
  }

  .lab-title {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-ink);
    transition: color var(--motion-hover);
  }
  .lab-blurb {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-ink-3);
  }

  /* The figure dims slightly on hover rather than the card lifting. The
     title is what sharpens, because the title is the target. */
  .lab-item:hover .lab-figure {
    opacity: 0.88;
  }
  .lab-figure {
    transition: opacity var(--motion-hover);
  }
</style>
