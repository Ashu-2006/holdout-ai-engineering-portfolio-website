---
/**
 * A count is more scannable than a folder, and it makes an empty
 * collection impossible to hide. Fayaz Ahmed's site labels every
 * collection this way ("9 things I built", "23 posts", "14 places") and
 * it is the cheapest honesty mechanism on the reference board: you cannot
 * write "0 things I built" and leave it there.
 *
 * `noun` is a noun, not a unit. "9 things I built" reads as a person
 * talking; "9 items" reads as a database.
 */
interface Props {
  count: number;
  noun: string;
  href?: string;
  label?: string;
}
const { count, noun, href, label } = Astro.props;
---

<p class="count">
  {label && <span class="count-label">{label}</span>}
  {label && <span class="sep" aria-hidden="true">·</span>}
  {
    href ? (
      <a href={href} class="count-n">
        {count} {noun}
      </a>
    ) : (
      <span class="count-n">
        {count} {noun}
      </span>
    )
  }
</p>

<style>
  .count {
    display: flex;
    align-items: baseline;
    gap: var(--space-tight);
    font-size: 0.75rem;
    margin-bottom: var(--space-row);
  }
  .count-label {
    color: var(--color-ink-2);
  }
  .sep {
    color: var(--color-ink-4);
  }
  .count-n {
    color: var(--color-ink-4);
    font-variant-numeric: tabular-nums;
  }
  a.count-n {
    transition: color var(--motion-hover);
  }
  a.count-n:hover {
    color: var(--color-ink-2);
  }
</style>
