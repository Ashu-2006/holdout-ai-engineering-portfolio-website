---
import { site } from "../../config/site";

/**
 * Tier 1 recognition shortcut.
 *
 * Rendered as an inline run of names in prose, not as a logo wall. Three
 * names in three bordered cards read as a thin logo wall and invite the
 * question "is that all"; the same three inside a sentence read as a
 * person mentioning where they have worked. Lorenzo de Lijser's site does
 * this and it is the one thing it does better than anything else on the
 * reference board.
 */
const { label, items, note } = site.proofRow;
---

{
  items.length > 0 && (
    <p class="proof note-measure">
      <span class="proof-label">{label}</span>{" "}
      {items.map((name, i) => (
        <>
          <span class="proof-name">{name}</span>
          {i < items.length - 2 ? ", " : i === items.length - 2 ? ", and " : ""}
        </>
      ))}
      {note && <span class="proof-note">{note}</span>}
    </p>
  )
}

<style>
  .proof {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-ink-3);
  }
  .proof-label {
    color: var(--color-ink-2);
  }
  /* The names carry full ink because they are the signal. Everything
     else in the sentence is grammar holding them together. */
  .proof-name {
    color: var(--color-ink);
  }
  .proof-note {
    display: block;
    margin-top: var(--space-tight);
    font-size: 0.75rem;
    color: var(--color-ink-4);
  }
</style>
