---
import { record } from "../../config/site";
---
<ul class="reveal grid gap-3 sm:grid-cols-3">
  {record.map((r) => (
    <li class="card p-4">
      <p class="numeric text-lg font-medium text-ink">{r.rank}</p>
      <p class="mt-0.5 text-[11px] text-ink-4">of {r.of}</p>
      <p class="mt-2 text-[13px] leading-snug">{r.what}</p>
    </li>
  ))}
</ul>
