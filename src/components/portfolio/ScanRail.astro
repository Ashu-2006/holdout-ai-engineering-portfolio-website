---
/**
 * The F-pattern's third movement is a vertical scan down the left edge,
 * catching the first word or two of each line. The research uses that to
 * argue for a visually distinct left edge per block. This goes one step
 * further and puts something there worth catching: a marker naming which
 * reading tier the page is currently in.
 *
 * It is a progress indicator that also teaches the page's structure, so
 * the tier model becomes an affordance instead of a fact in a doc.
 */
const tiers = [
  { id: "filter", label: "Filter" },
  { id: "hook", label: "Hook" },
  { id: "depth", label: "Depth" },
];
---

<nav class="rail" aria-label="Reading tiers">
  <ol>
    {
      tiers.map((t) => (
        <li>
          <a href={`#${t.id === "filter" ? "measured" : t.id === "hook" ? "work" : "lab"}`} data-rail={t.id}>
            <span class="tick" aria-hidden="true" />
            <span class="label">{t.label}</span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .rail {
    position: fixed;
    left: 1.75rem;
    top: 50%;
    transform: translateY(-50%);
    z-index: var(--layer-rail);
  }
  .rail ol {
    display: flex;
    flex-direction: column;
    gap: var(--space-row);
  }
  .rail a {
    display: flex;
    align-items: center;
    gap: var(--space-tight);
  }

  .tick {
    display: block;
    width: 0.875rem;
    height: 1px;
    background-color: var(--color-ink-4);
    transition:
      width var(--motion-hover),
      background-color var(--motion-hover);
  }

  /*
   * The label is hidden until the rail is hovered or its tick is current.
   * A permanently visible label turns a peripheral cue into furniture.
   */
  .label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--color-ink-4);
    opacity: 0;
    transition: opacity var(--motion-hover);
  }
  .rail:hover .label,
  .rail a[aria-current="true"] .label {
    opacity: 1;
  }

  .rail a[aria-current="true"] .tick {
    width: 1.5rem;
    background-color: var(--color-ink);
  }

  /*
   * Below the width where the rail would overlap the content column it is
   * removed, not shrunk. A cue that covers the thing it describes is worse
   * than no cue.
   */
  @media (max-width: 72rem) {
    .rail {
      display: none;
    }
  }
</style>
