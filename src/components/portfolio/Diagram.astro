---
import type { CollectionEntry } from "astro:content";

interface Props {
  diagram: NonNullable<CollectionEntry<"systems">["data"]["diagram"]>;
}
const { diagram } = Astro.props;
---

{
  /*
   * A diagram has to be legible in about 15 seconds without reading prose,
   * which in practice means four nodes and three edges, not fifteen. None
   * of the four portfolios on the reference board has one at all, so this
   * is the largest single differentiator left in the template.
   *
   * Strokes and text read from tokens rather than being baked into the
   * SVG, so the figure repaints on theme change instead of being a
   * light-mode image sitting in a dark page.
   */
}
<figure class="diagram">
  {
    diagram.kind === "svg" ? (
      <div class="diagram-canvas" role="img" aria-label={diagram.alt} set:html={diagram.source} />
    ) : (
      <pre class="mermaid" aria-label={diagram.alt}>{diagram.source}</pre>
    )
  }
  {diagram.caption && <figcaption>{diagram.caption}</figcaption>}
</figure>

<style>
  .diagram {
    margin-block: var(--space-group);
  }

  /*
   * A wide diagram scrolls inside its own box. The page body must never
   * scroll sideways, and a figure is the one element likely to force it.
   */
  .diagram-canvas {
    overflow-x: auto;
    padding-block: var(--space-row);
  }

  .diagram-canvas :global(svg) {
    max-width: 100%;
    height: auto;
    display: block;
    stroke: var(--color-ink-4);
  }
  .diagram-canvas :global(svg text) {
    fill: var(--color-ink-2);
    stroke: none;
    font-family: var(--font-mono);
    font-size: 10.5px;
  }
  .diagram-canvas :global(svg rect) {
    fill: none;
  }

  figcaption {
    margin-top: var(--space-tight);
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--color-ink-4);
    max-width: var(--measure-note);
  }

  .mermaid {
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-3);
  }
</style>
