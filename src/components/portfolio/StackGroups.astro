---
import { stackGroups } from "../../config/site";
---

<div class="reveal grid gap-(--space-block) sm:grid-cols-2">
  {
    stackGroups.map((g) => (
      <section>
        {/* The count sits beside the label, not pushed to the column's far
            edge. justify-between worked when a card bounded the row; with
            the card gone there is no right edge to align to, so the number
            detached from its heading and drifted into the next column. */}
        <h3 class="group-head">
          <span class="group-name">{g.group}</span>
          <span class="numeric group-count">{g.items.length}</span>
        </h3>
        <ul class="chips">
          {g.items.map((item) => (
            <li class="chip">{item}</li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .group-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-tight);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-ink);
  }
  .group-count {
    font-size: 0.6875rem;
    font-weight: 400;
    color: var(--color-ink-4);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: var(--space-row);
  }

  /*
   * A chip is the one place a fill survives the shadow purge. It is not
   * elevation, it is a shape: the fill is what makes a two-word tool name
   * read as one token rather than as loose text. It stays sunken, never
   * raised.
   */
  .chip {
    padding: 0.1875rem 0.5rem;
    /* radius-chip, not radius-well: a chip is smaller than a panel and a
       0.5rem radius on a 22px-tall box reads as a stadium. */
    border-radius: var(--radius-chip);
    background-color: var(--color-sunken);
    font-size: 0.75rem;
    color: var(--color-ink-2);
    /* Descenders drag the optical baseline low inside a tight pill. */
    transform: translateY(var(--nudge-y-chip-label));
    transition: color var(--motion-hover);
  }
  .chip:hover {
    color: var(--color-ink);
  }
</style>
