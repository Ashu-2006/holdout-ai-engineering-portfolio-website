---
/**
 * A section is a label, an optional note, and content.
 *
 * There is no container, no border, no fill. What separates one section
 * from the next is --space-section, applied by the .spine class on the
 * parent, and nothing else. That is the whole reason the label can stay
 * this quiet: it is not competing with a box for the reader's attention,
 * it is just the first line after a large gap.
 */
interface Props {
  id: string;
  title: string;
  note?: string;
  /** Which reading tier this belongs to. Drives the density control. */
  tier?: "filter" | "hook" | "depth";
}
const { id, title, note, tier } = Astro.props;
---

<section id={id} class="section scroll-mt-16" data-tier={tier}>
  {
    /*
     * One wrapper around everything, so the density control has a single
     * grid child to collapse. With the head and the slot as two siblings,
     * `grid-template-rows: 0fr` sizes only the first row and the content
     * gets an implicit auto row, which collapses the heading and leaves
     * the body at full height.
     */
  }
  <div class="section-inner">
    <div class="section-head">
      <h2 class="section-title">{title}</h2>
      {note && <p class="section-note note-measure">{note}</p>}
    </div>
    <slot />
  </div>
</section>

<style>
  /* The label is deliberately subordinate to the content under it.
     Uppercase tracking would shout; a small medium-weight line at full
     ink contrast reads as a heading without needing size. */
  .section-title {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--color-ink);
  }

  .section-note {
    margin-top: var(--space-tight);
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--color-ink-4);
  }

  /* Heading to content. Large enough that the label reads as belonging
     to what follows rather than floating between two sections. */
  .section-head {
    margin-bottom: var(--space-group);
  }
</style>
