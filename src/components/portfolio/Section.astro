---
interface Props {
  id: string;
  title: string;
  note?: string;
}
const { id, title, note } = Astro.props;
---
<section id={id} class="scroll-mt-8">
  <div class="mb-4">
    <h2 class="text-[13px] font-medium tracking-wide text-ink">{title}</h2>
    {note && <p class="mt-1 max-w-md text-[12px] leading-snug text-ink-4">{note}</p>}
  </div>
  <slot />
</section>
