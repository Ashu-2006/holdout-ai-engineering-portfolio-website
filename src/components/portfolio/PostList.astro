---
import type { CollectionEntry } from "astro:content";

interface Props {
  posts: CollectionEntry<"posts">[];
}
const { posts } = Astro.props;

const formatter = new Intl.DateTimeFormat("en", { month: "short", day: "numeric" });
---
<ul class="card reveal divide-y divide-line">
  {posts.map(({ id, data }) => (
    <li>
      {data.status === "live" ? (
        <a href={`/writing/${id}`} class="group flex items-baseline gap-4 p-5">
          <span class="numeric w-14 shrink-0 text-[11px] text-ink-4">
            {data.date ? formatter.format(data.date) : ""}
          </span>
          <span class="link-draw-child relative flex-1 text-[14.5px] text-ink">{data.title}</span>
          <span class="shrink-0 text-[11px] text-ink-4">{data.readingTime}</span>
        </a>
      ) : (
        /* Drafts stay visible: a queue reads better than an empty shelf. */
        <p class="flex items-baseline gap-4 p-5">
          <span class="w-14 shrink-0 text-[11px] text-ink-4">draft</span>
          <span class="flex-1 text-[14.5px] text-ink-4">{data.title}</span>
        </p>
      )}
    </li>
  ))}
</ul>
