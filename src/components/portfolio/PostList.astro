---
import type { CollectionEntry } from "astro:content";
import CollectionCount from "./CollectionCount.astro";

interface Props {
  posts: CollectionEntry<"posts">[];
}
const { posts } = Astro.props;

const live = posts.filter((p) => p.data.status === "live");
const queued = posts.filter((p) => p.data.status !== "live");

const formatter = new Intl.DateTimeFormat("en", {
  month: "long",
  day: "numeric",
  year: "numeric",
});
---

<div class="reveal">
  <CollectionCount count={live.length} noun="published" href="/writing" />

  {
    live.length === 0 && (
      <p class="empty">
        Nothing published yet. {queued.length} in the queue, with where each one
        actually is.
      </p>
    )
  }

  {
    /*
     * The excerpt is the post's own argument, not a summary of it. A
     * summary says "this post is about retrieval evals"; three lines of
     * the actual argument prove the person can write, which is the thing
     * Anthropic said it looks for. So description gets room to be two
     * lines rather than being truncated into a subtitle.
     */
  }
  <ul class="posts">
    {
      live.map(({ id, data }) => (
        <li class="post">
          <a href={`/writing/${id}`} class="group post-link">
            <span class="link-draw-child relative post-title">{data.title}</span>
          </a>
          {data.description && <p class="post-excerpt prose-measure">{data.description}</p>}
          <p class="post-meta">
            {data.date && (
              <time datetime={data.date.toISOString()}>{formatter.format(data.date)}</time>
            )}
            {data.readingTime && <span>{data.readingTime}</span>}
          </p>
        </li>
      ))
    }
  </ul>

  {
    queued.length > 0 && (
      <ul class="queue">
        {queued.map(({ data }) => (
          <li class="queued">
            <span class="queued-title">{data.title}</span>
            {/* The real state, never "coming soon". */}
            <span class="queued-state">{data.stage ?? "queued"}</span>
          </li>
        ))}
      </ul>
    )
  }
</div>

<style>
  .posts {
    display: flex;
    flex-direction: column;
    gap: var(--space-block);
  }

  .post-title {
    font-size: 0.9375rem;
    color: var(--color-ink);
  }
  .post-excerpt {
    margin-top: var(--space-tight);
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-ink-2);
  }
  .post-meta {
    display: flex;
    gap: var(--space-row);
    margin-top: var(--space-tight);
    font-size: 0.6875rem;
    color: var(--color-ink-4);
    font-variant-numeric: tabular-nums;
  }

  /* The queue is a quieter tier than the published list, separated from it
     by air rather than by a rule. */
  .queue {
    display: flex;
    flex-direction: column;
    gap: var(--space-row);
    margin-top: var(--space-block);
  }
  .queued {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-group);
    font-size: 0.875rem;
    color: var(--color-ink-3);
  }
  .queued-state {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-ink-4);
    transform: translateY(var(--nudge-y-chip-label));
  }

  .empty {
    font-size: 0.875rem;
    color: var(--color-ink-3);
    margin-bottom: var(--space-group);
  }
</style>
