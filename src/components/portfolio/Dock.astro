---
import { site } from "../../config/site";

interface Props {
  nav?: { id: string; label: string }[];
}

const { nav = [] } = Astro.props;
const initials = site.name
  .split(" ")
  .map((w) => w[0])
  .join("");
---

<nav
  aria-label="Page sections"
  class="dock fixed bottom-[max(1rem,env(safe-area-inset-bottom))] left-1/2 z-40 -translate-x-1/2"
>
  <div
    class="glass flex items-center gap-0.5 rounded-full p-1 ring-1 ring-line"
  >
    <a
      href="/"
      class="grid h-7 shrink-0 place-items-center rounded-full bg-ink px-2.5 font-mono text-[10.5px] tracking-wider text-ground"
      >{initials}</a
    >

    {
      nav.map((item) => (
        <a
          href={`#${item.id}`}
          data-section={item.id}
          class="dock-link rounded-full px-3 py-1.5 text-[13px] whitespace-nowrap text-ink-3 transition-colors duration-fast ease-out hover:text-ink"
        >
          {item.label}
        </a>
      ))
    }

    <span class="mx-1 h-4 w-px shrink-0 bg-line"></span>

    <button
      type="button"
      data-theme-toggle
      aria-label="Toggle colour scheme"
      class="grid h-7 w-7 shrink-0 place-items-center rounded-full text-ink-3 transition-[color,transform] duration-moderate ease-out hover:rotate-60 hover:text-ink"
    >
      <svg
        width="13"
        height="13"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.9"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="3.6"></circle>
        <path d="M12 3v1.6M12 19.4V21M3 12h1.6M19.4 12H21M5.6 5.6l1.1 1.1M17.3 17.3l1.1 1.1M5.6 18.4l1.1-1.1M17.3 6.7l1.1-1.1"></path>
      </svg>
    </button>

    <a
      href={`mailto:${site.email}`}
      class="shrink-0 rounded-full bg-ink px-3.5 py-1.5 text-[13px] whitespace-nowrap text-ground transition-[opacity,transform] duration-fast ease-out hover:-translate-y-px hover:opacity-90"
      >Email</a
    >
  </div>
</nav>

<style>
  /* Enters once, after the page content has landed. Never hides on scroll. */
  .dock {
    animation: dock-enter var(--motion-reveal) var(--delay-dock) both;
  }

  /*
   * Y only. Tailwind v4 implements `-translate-x-1/2` with the independent
   * `translate` property rather than `transform`, so a keyframe animating
   * `transform` no longer overrides the utility, it composes with it. The
   * previous `translate(-50%, …)` here applied the centering a second time
   * and pushed the dock 143px left of centre, which clipped it off-screen
   * at 390px wide.
   */
  @keyframes dock-enter {
    from {
      opacity: 0;
      transform: translateY(130%);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .dock-link[data-active] {
    color: var(--color-ink);
    background-color: color-mix(in oklab, var(--color-ink) 8%, transparent);
  }
  @media (max-width: 26.875rem) {
    .dock-link {
      padding-inline: 0.55rem;
      font-size: 12px;
    }
  }
</style>

<script>
  import { initDock } from "../../scripts/dock";
  initDock();
</script>
