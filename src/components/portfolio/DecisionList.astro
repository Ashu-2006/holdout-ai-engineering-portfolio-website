---
import type { CollectionEntry } from "astro:content";

interface Props {
  decisions: CollectionEntry<"systems">["data"]["decisions"];
}
const { decisions } = Astro.props;
---

{
  /*
   * Five decision records written as prose are five paragraphs nobody
   * reads. The same five in a fixed grammar scan as a table, because the
   * label column aligns across every record and the eye can read down one
   * field at a time.
   *
   * Nothing is collapsed. This was previously a <details> that hid every
   * field behind a click, which meant `it cost` (the one field that
   * separates mid from senior) was closed by default. A disclosure is the
   * wrong mechanism when the hidden content is the point.
   */
}
<ol class="decisions reveal">
  {
    decisions.map((d, i) => (
      <li class="decision">
        <p class="d-head">
          <span class="numeric d-index">D{i + 1}</span>
          <span class="d-title">{d.decision}</span>
        </p>

        <dl class="d-body">
          <dt>instead of</dt>
          <dd>{d.alternatives.join(", ")}</dd>

          <dt>because</dt>
          <dd>{d.rationale}</dd>

          <dt class="d-cost-label">it cost</dt>
          <dd class="d-cost">{d.tradeoff}</dd>

          <dt>knock-on</dt>
          <dd>
            <ul class="d-knock">
              {d.secondOrder.map((o) => (
                <li>{o}</li>
              ))}
            </ul>
          </dd>
        </dl>
      </li>
    ))
  }
</ol>

<style>
  .decisions {
    display: flex;
    flex-direction: column;
    gap: var(--space-block);
  }

  .d-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-row);
    margin-bottom: var(--space-row);
  }
  .d-index {
    flex-shrink: 0;
    font-size: 0.6875rem;
    color: var(--color-ink-4);
  }
  .d-title {
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.45;
    color: var(--color-ink);
  }

  /*
   * The fixed label column is what turns four records into one scannable
   * table. It aligns with the title above it, not with the D-index, so
   * the record reads as a heading with an indented body.
   */
  .d-body {
    display: grid;
    grid-template-columns: 5.25rem 1fr;
    gap: var(--space-row) var(--space-row);
    margin-left: 1.75rem;
    font-size: 0.84375rem;
    line-height: 1.6;
  }
  .d-body dt {
    font-size: 0.6875rem;
    color: var(--color-ink-4);
    padding-top: 0.25rem;
  }
  .d-body dd {
    color: var(--color-ink-2);
  }

  /*
   * The cost is never muted and never behind a click. Scoped under .d-body
   * so it outranks `.d-body dt/dd` on specificity rather than on
   * !important, which would just move the problem to the next override.
   */
  .d-body .d-cost-label {
    color: var(--color-caution);
  }
  .d-body .d-cost {
    color: var(--color-ink);
  }

  .d-knock {
    display: flex;
    flex-direction: column;
    gap: var(--space-tight);
  }
  .d-knock li {
    padding-left: 0.875rem;
    position: relative;
    color: var(--color-ink-3);
  }
  .d-knock li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.5625rem;
    width: 0.375rem;
    height: 1px;
    background-color: var(--color-ink-4);
  }

  @media (max-width: 34rem) {
    .d-body {
      grid-template-columns: 1fr;
      gap: 0.125rem;
      margin-left: 0;
    }
    .d-body dt {
      padding-top: var(--space-tight);
    }
  }
</style>
