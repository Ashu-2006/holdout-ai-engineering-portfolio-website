---
import { profiles } from "../../config/site";

/* Artifact platforms lead; rating platforms follow. Evidence before proxies. */
const artifacts = profiles.filter((p) => p.kind === "artifact");
const ratings = profiles.filter((p) => p.kind === "rating");
---
<div class="reveal space-y-4">
  <ul class="grid gap-(--space-row) sm:grid-cols-3">
    {artifacts.map((p) => (
      <li>
        <a href={p.url} class="group card card-interactive block p-4">
          <span class="flex items-baseline justify-between gap-2">
            <span class="text-[14px] font-medium text-ink">{p.platform}</span>
            <span class="arrow text-xs text-ink-4">&nearr;</span>
          </span>
          <span class="mt-1 block text-[11px] text-ink-4">{p.stat}</span>
        </a>
      </li>
    ))}
  </ul>

  <p class="flex flex-wrap items-baseline gap-x-5 gap-y-2">
    <span class="text-[11px] text-ink-4">also on</span>
    {ratings.map((p) => (
      <a href={p.url} class="link-draw text-[13px]">
        {p.platform} <span class="numeric text-[11px] text-ink-4">{p.stat}</span>
      </a>
    ))}
  </p>
</div>

<style>
  .arrow {
    transition:
      transform var(--motion-hover),
      color var(--motion-hover);
  }
  .group:hover .arrow { transform: translate(2px, -2px); color: var(--color-ink); }
</style>
