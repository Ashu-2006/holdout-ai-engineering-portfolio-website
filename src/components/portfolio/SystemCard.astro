---
import type { CollectionEntry } from "astro:content";

interface Props {
  system: CollectionEntry<"systems">;
  index: number;
  total: number;
}
const { system, index, total } = Astro.props;
const { data } = system;
---
<article class="card card-interactive reveal overflow-hidden">
  <div class="p-6">
    <div class="flex items-start justify-between gap-4">
      <div class="min-w-0">
        {data.featured && <p class="text-[11px] tracking-wide text-ink-4">Selected work</p>}
        <h3 class="mt-1.5 text-xl font-medium tracking-tight text-ink">{data.title}</h3>
      </div>
      <p class="numeric shrink-0 pt-1 text-[11px] text-ink-4">
        {String(index).padStart(2, "0")}/{String(total).padStart(2, "0")}
      </p>
    </div>

    <p class="mt-3 max-w-xl text-[14.5px] leading-relaxed">{data.outcome}</p>

    <dl class="mt-6 flex flex-wrap gap-x-8 gap-y-4">
      {data.metrics.map((m) => (
        <div>
          <dd class="numeric text-lg font-medium text-measured">{m.value}{m.unit}</dd>
          <dt class="mt-0.5 text-[11px] text-ink-4">{m.label}</dt>
        </div>
      ))}
    </dl>

    <ul class="mt-5 flex flex-wrap gap-1.5">
      {data.stack.map((t) => (
        <li class="rounded-well bg-sunken px-2 py-1 text-xs text-ink-3">{t}</li>
      ))}
    </ul>
  </div>

  <div class="flex items-stretch border-t border-line">
    {data.liveDemo ? (
      <a href={data.liveDemo} class="flex flex-1 items-center gap-2 px-6 py-3.5 text-[13px] transition-colors duration-fast ease-out hover:bg-sunken hover:text-ink">
        <span class="h-1.5 w-1.5 rounded-full bg-measured"></span>
        Live demo
      </a>
    ) : (
      /* Absence is rendered, not hidden: a missing demo should read as a gap. */
      <p class="flex flex-1 items-center gap-2 px-6 py-3.5 text-[13px] text-ink-4">
        <span class="h-1.5 w-1.5 rounded-full ring-1 ring-ink-4 ring-inset"></span>
        Not deployed
      </p>
    )}
    <a href={`/work/${system.id}`} class="border-l border-line px-6 py-3.5 text-[13px] transition-colors duration-fast ease-out hover:bg-sunken hover:text-ink">
      Case study &rarr;
    </a>
  </div>
</article>
