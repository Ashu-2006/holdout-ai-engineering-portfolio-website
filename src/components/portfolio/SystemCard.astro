---
import type { CollectionEntry } from "astro:content";

interface Props {
  system: CollectionEntry<"systems">;
  index: number;
  total: number;
}
const { system, index, total } = Astro.props;
const { data } = system;

/**
 * Maturity drives the whole treatment, not a badge in a corner.
 *
 * The research asks that a missing live demo read as a gap. Omitting the
 * field hides it; a four-case state names it. `tone` is what the demo slot
 * does, `dim` is how much the card recedes.
 */
const treatment = {
  deployed: { text: "Live demo", tone: "live" as const },
  shipped: { text: "No public instance", tone: "muted" as const },
  prototype: { text: "Not deployed", tone: "gap" as const },
  archived: { text: "Archived", tone: "muted" as const },
}[data.maturity];

const showDemoLink = data.maturity === "deployed" && Boolean(data.liveDemo);
---

<article class="system reveal" data-maturity={data.maturity}>
  <header class="sys-head">
    <div class="min-w-0">
      {data.featured && <p class="sys-eyebrow">Selected work</p>}
      <h3 class="sys-title">{data.title}</h3>
    </div>
    <p class="numeric sys-index">
      {String(index).padStart(2, "0")}/{String(total).padStart(2, "0")}
    </p>
  </header>

  <p class="sys-outcome prose-measure">{data.outcome}</p>

  <dl class="sys-metrics">
    {
      data.metrics.map((m) => (
        <div>
          <dd class="numeric sys-metric-value">
            {m.value}
            {m.unit}
          </dd>
          <dt class="sys-metric-label">{m.label}</dt>
          {/* Context travels with the number here too. A metric that is
              legible on the case study and bare on the card teaches the
              reader that the card is the marketing version. */}
          <dd class="sys-metric-context">{m.context}</dd>
        </div>
      ))
    }
  </dl>

  <ul class="sys-stack">
    {data.stack.map((t) => <li class="chip">{t}</li>)}
  </ul>

  <footer class="sys-actions">
    {
      showDemoLink ? (
        <a href={data.liveDemo} class="sys-action">
          <span class="dot dot-live" aria-hidden="true" />
          {treatment.text}
        </a>
      ) : (
        <p class="sys-action" data-tone={treatment.tone}>
          <span class:list={["dot", `dot-${treatment.tone}`]} aria-hidden="true" />
          {treatment.text}
        </p>
      )
    }
    <a href={`/work/${system.id}`} class="sys-action sys-action-link">
      Case study &rarr;
    </a>
  </footer>
</article>

<style>
  /*
   * No card, no border, no shadow. What separates one system from the next
   * is 48px of air, set by the parent. The internal rhythm below is what
   * makes the block read as one unit without a rectangle around it.
   */
  .system {
    display: flex;
    flex-direction: column;
    gap: var(--space-row);
  }

  .sys-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-group);
  }
  .sys-eyebrow {
    font-size: 0.6875rem;
    letter-spacing: 0.03em;
    color: var(--color-ink-4);
    margin-bottom: 0.25rem;
  }
  .sys-title {
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }
  .sys-index {
    flex-shrink: 0;
    font-size: 0.6875rem;
    color: var(--color-ink-4);
    padding-top: 0.375rem;
  }

  .sys-outcome {
    font-size: 0.90625rem;
    line-height: 1.65;
    color: var(--color-ink-2);
  }

  .sys-metrics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-group) var(--space-block);
    margin-top: var(--space-row);
  }
  .sys-metric-value {
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--color-measured);
  }
  .sys-metric-label {
    margin-top: 0.125rem;
    font-size: 0.6875rem;
    color: var(--color-ink-3);
  }
  .sys-metric-context {
    font-size: 0.6875rem;
    color: var(--color-ink-4);
    max-width: 20ch;
  }

  .sys-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: var(--space-tight);
  }
  .chip {
    padding: 0.1875rem 0.5rem;
    border-radius: var(--radius-chip);
    background-color: var(--color-sunken);
    font-size: 0.75rem;
    color: var(--color-ink-3);
    transform: translateY(var(--nudge-y-chip-label));
  }

  /* Actions sit on air with a generous gap, not in a bordered strip. */
  .sys-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-block);
    margin-top: var(--space-row);
  }
  .sys-action {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--color-ink-2);
    transition: color var(--motion-hover);
  }
  a.sys-action:hover {
    color: var(--color-ink);
  }
  .sys-action-link {
    color: var(--color-ink-3);
  }

  .dot {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 9999px;
    flex-shrink: 0;
  }
  .dot-live {
    background-color: var(--color-measured);
  }
  /* An admitted gap: hollow, in the caution tone, so it reads as
     "deliberately absent" rather than as a link that failed to render. */
  .dot-gap {
    box-shadow: inset 0 0 0 1px var(--color-caution);
  }
  .dot-muted {
    box-shadow: inset 0 0 0 1px var(--color-ink-4);
  }
  .sys-action[data-tone="gap"] {
    color: var(--color-caution);
  }
  .sys-action[data-tone="muted"] {
    color: var(--color-ink-4);
  }

  /*
   * A prototype recedes and an archived system recedes further. With no
   * shadow to demote, opacity is the honest lever: it says "this is real
   * but it is not the thing to look at".
   */
  .system[data-maturity="prototype"] {
    opacity: 0.86;
  }
  .system[data-maturity="archived"] {
    opacity: 0.62;
  }
</style>
