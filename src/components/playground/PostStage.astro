---
/**
 * The post row lab stage. A short list, dead centre, driven entirely
 * by custom properties so the dial can move anything without a
 * re-render.
 *
 * WHY A LIST AND NOT ONE ROW. A card can be judged alone; a list item
 * cannot. Half of what a row is made of only exists in relation to its
 * neighbours: the separating rule, the vertical rhythm, and the right
 * column that has to form a rail down the page rather than three
 * independently placed dates. One row in isolation hides all three, so
 * the stage renders three by default and the Rows dial collapses it to
 * one when the question really is about a single item.
 *
 * V1 IS WHAT SHIPS, MEASURED. Every default below was read off the
 * rendered home page rather than guessed:
 *
 *   row      736 wide, 12px block padding, 12px gap, centred
 *   rule     1px solid line-2, on the container and between rows
 *   thumb    64 x 44, 6px radius, 1px line-2 border, object-cover
 *   title    16 / 24, tracking 0.01em, weight 400, ink, one line
 *   desc     2px below the title, 16 / 24, ink-3, clamped at 1
 *   meta     mono 12 / 16, tracking 0.04em, ink-3, right-aligned,
 *            date over reading time
 *
 * ONE CORRECTION IS BAKED IN. The shipped row asks for `line-clamp-1
 * block`, and the `block` utility overrides the clamp's own
 * `display: -webkit-box`, so the clamp never applied and every
 * "one-line" description was silently running to two. V1 renders the
 * row as written rather than as broken; the fix is in PostRows.astro.
 *
 * ORDERING IS THE LAB'S, NOT THE HOME PAGE'S. Straight reverse
 * chronological over live and draft together, because that is the
 * stream V5 argues about. The home page filters to live and /writing
 * splits the two into separate sections.
 */
import { getCollection } from "astro:content";

const posts = (await getCollection("posts")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const fmt = (d: Date) =>
  new Intl.DateTimeFormat("en-GB", {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
  })
    .format(d)
    .replace(/\//g, ".");

/* A draft's stage is the honest label. "Draft" alone says nothing
   about whether it is a sentence or a finished argument. */
const stateLabel = (p: (typeof posts)[number]) =>
  p.data.status === "live" ? "Live" : (p.data.stage ?? "draft");
---

<div
  class="stage"
  id="stage"
  data-variant="v1"
  data-thumb="on"
  data-desc="on"
  data-meta="on"
  data-read="on"
  data-tags="off"
  data-state="off"
  data-rule="solid"
  data-fit="cover"
  data-hoverzoom="on"
  data-hoverground="on"
  data-bounds="off"
  data-grid="off"
  data-backdrop="ground"
  data-title-lines="1"
  data-desc-clamp="on"
  data-rows="3"
>
  <div class="stage-scroll">
    <div class="pr-list">
      {
        posts.map((post, i) => (
          <a
            href={`/writing/${post.id}`}
            class="pr"
            style={`--enter-i:${i}`}
            data-post={post.id}
            data-status={post.data.status}
          >
            {/* V2 only. The date leads the row at a fixed width, so six
                of them form a column instead of six ragged strings. */}
            <span class="numeric pr-lead">{fmt(post.data.date)}</span>

            <span class="pr-thumb">
              <img
                src={post.data.cover}
                alt=""
                width="1000"
                height="500"
                loading={i < 3 ? "eager" : "lazy"}
                decoding="async"
                class="pr-img"
              />
            </span>

            <span class="pr-mid">
              {/* V3 only. The date becomes an eyebrow, which buys the
                  title a bigger step and costs the right-hand rail. */}
              <span class="numeric pr-eyebrow">{fmt(post.data.date)}</span>

              <span class="pr-title" id={i === 0 ? "pr-title" : undefined}>
                {post.data.title}
              </span>

              <span class="pr-desc">{post.data.description}</span>

              <span class="pr-tags">
                {post.data.tags.slice(0, 3).map((t) => (
                  <span class="pr-tag">{t}</span>
                ))}
              </span>
            </span>

            <span class="pr-meta">
              {/* V5 only by default. One list instead of the two
                  sections /writing splits into today. */}
              <span class="pr-state">
                <span
                  class:list={[
                    "pr-dot",
                    post.data.status === "live" ? "is-live" : "is-draft",
                  ]}
                  aria-hidden="true"
                />
                <span>{stateLabel(post)}</span>
              </span>
              <span class="numeric pr-date">{fmt(post.data.date)}</span>
              <span class="numeric pr-read">{post.data.readingTime}</span>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</div>

<style>
  /* ============================================================
     THE CONTRACT.

     Every value the dial can move is declared once here. The dial
     writes the same names onto #stage's inline style, which wins on
     specificity without touching a class, so "Copy CSS" from the panel
     produces a block that drops straight into a component.

     NOTHING HERE DEPENDS ON JS. With scripting off the stage still
     renders V1 at shipped spec; the dial only overrides.
     ============================================================ */
  .stage {
    --pr-w: 736px;
    --pr-py: 12px;
    --pr-gap: 12px;
    --pr-rule: 1px;
    --pr-radius: 0px;

    --pr-thumb-w: 64px;
    --pr-thumb-h: 44px;
    --pr-thumb-radius: 6px;
    --pr-hover: 1.03;

    --pr-title-size: 16px;
    --pr-title-lead: 1.5;
    --pr-title-track: 0.01em;
    --pr-title-weight: 400;

    --pr-desc-gap: 2px;
    --pr-desc-size: 16px;
    --pr-desc-lead: 1.5;
    --pr-desc-clamp: 1;

    --pr-tags-gap: 8px;

    --pr-meta-size: 12px;
    --pr-meta-gap: 0px;
    --pr-meta-w: 0px;

    --pr-lead-w: 92px;
  }

  /* ============================================================
     V1: the shipped row.
     ============================================================ */
  .pr-list {
    width: var(--pr-w);
    max-width: 100%;
    border-top: var(--pr-rule) solid var(--color-line-2);
  }
  .pr-list > * + * {
    border-top: var(--pr-rule) solid var(--color-line-2);
  }
  .stage[data-rule="dashed"] .pr-list,
  .stage[data-rule="dashed"] .pr-list > * + * {
    border-top-style: dashed;
  }
  .stage[data-rule="none"] .pr-list,
  .stage[data-rule="none"] .pr-list > * + * {
    border-top-style: none;
  }

  /* The row count is a dial rather than a slice in the frontmatter, so
     the same six records answer "what does one look like" and "what
     does a page of them look like" without a rebuild. */
  .stage[data-rows="1"] .pr:nth-child(n + 2),
  .stage[data-rows="3"] .pr:nth-child(n + 4),
  .stage[data-rows="5"] .pr:nth-child(n + 6) {
    display: none;
  }

  .pr {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--pr-gap);
    padding-block: var(--pr-py);
    border-radius: var(--pr-radius);
    color: inherit;
    transition: background-color var(--motion-hover);
  }

  /* ---- thumbnail ---- */
  .pr-thumb {
    position: relative;
    flex: none;
    display: block;
    overflow: hidden;
    width: var(--pr-thumb-w);
    height: var(--pr-thumb-h);
    border: 1px solid var(--color-line-2);
    border-radius: var(--pr-thumb-radius);
    background-color: var(--color-surface);
  }
  .pr-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-moderate) var(--ease-out);
  }
  .stage[data-fit="contain"] .pr-img {
    object-fit: contain;
  }
  .stage[data-thumb="off"] .pr-thumb {
    display: none;
  }

  /* ---- the middle column ---- */
  .pr-mid {
    display: block;
    min-width: 0;
    flex: 1;
  }

  .pr-title {
    display: inline-block;
    position: relative;
    max-width: 100%;
    font-size: var(--pr-title-size);
    line-height: var(--pr-title-lead);
    letter-spacing: var(--pr-title-track);
    font-weight: var(--pr-title-weight);
    color: var(--color-ink);
    /* One line, ellipsis, sized to the text. Sized to the text is the
       part that matters: the underline below is drawn on this box, and
       on a full-width block it would run past the end of the title. */
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    vertical-align: bottom;
  }
  /*
     Two and three lines need a different mechanism, not a different
     number. `white-space: nowrap` cannot wrap, so the multi-line steps
     switch to a -webkit-box clamp and give up the text-width underline
     for a full-width one. That trade is the reason this is a segmented
     control rather than a slider.
  */
  .stage[data-title-lines="2"] .pr-title,
  .stage[data-title-lines="3"] .pr-title {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    white-space: normal;
    text-overflow: clip;
  }
  .stage[data-title-lines="2"] .pr-title {
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }
  .stage[data-title-lines="3"] .pr-title {
    -webkit-line-clamp: 3;
    line-clamp: 3;
  }

  /* The site's own link underline, drawn from the left on row hover.
     Copied in behaviour, not in class, because the lab must be able to
     move its offset without touching the shipped utility. */
  .pr-title::after {
    content: "";
    position: absolute;
    inset: auto 0 -1px 0;
    height: 1px;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--motion-disclose);
  }

  .pr-desc {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: var(--pr-desc-clamp);
    line-clamp: var(--pr-desc-clamp);
    overflow: hidden;
    margin-top: var(--pr-desc-gap);
    font-size: var(--pr-desc-size);
    line-height: var(--pr-desc-lead);
    letter-spacing: 0.01em;
    color: var(--color-ink-3);
  }
  /* 0 is not a valid clamp: it collapses the paragraph instead of
     removing the clamp, so "no clamp" is an attribute. */
  .stage[data-desc-clamp="off"] .pr-desc {
    display: block;
    overflow: visible;
  }
  .stage[data-desc="off"] .pr-desc {
    display: none;
  }

  .pr-tags {
    display: none;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: var(--pr-tags-gap);
  }
  .stage[data-tags="on"] .pr-tags {
    display: flex;
  }
  .pr-tag {
    display: inline-flex;
    align-items: center;
    padding: 0.0625rem 0.4375rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    line-height: 1.125rem;
    letter-spacing: var(--text-label--letter-spacing);
    color: var(--color-ink-3);
    white-space: nowrap;
  }

  /* ---- the right rail ---- */
  .pr-meta {
    flex: none;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--pr-meta-gap);
    min-width: var(--pr-meta-w);
    font-family: var(--font-mono);
    font-size: var(--pr-meta-size);
    line-height: 1.3333;
    letter-spacing: 0.04em;
    text-align: right;
    color: var(--color-ink-3);
    transition: color var(--motion-hover);
  }
  .stage[data-meta="off"] .pr-meta {
    display: none;
  }
  .stage[data-read="off"] .pr-read {
    display: none;
  }

  .pr-state {
    display: none;
    align-items: center;
    gap: 0.375rem;
    text-transform: uppercase;
  }
  .stage[data-state="on"] .pr-state {
    display: flex;
  }
  .pr-dot {
    width: 6px;
    height: 6px;
    flex: none;
    border-radius: 999px;
  }
  .pr-dot.is-live {
    background-color: var(--color-live);
  }
  /*
     A ring, not a fill, for a draft. The two states then differ by
     something other than hue, so the list still reads as two kinds of
     thing in greyscale and for a red-green colour blind reader. Hue
     alone would carry the whole distinction, which is a WCAG 1.4.1
     failure and, more simply, a bad list.
  */
  .pr-dot.is-draft {
    background-color: transparent;
    box-shadow: inset 0 0 0 1.5px var(--color-caution);
  }

  /* V2 and V3 date carriers. Hidden until their variation asks. */
  .pr-lead,
  .pr-eyebrow {
    display: none;
    font-family: var(--font-mono);
    font-size: var(--pr-meta-size);
    line-height: 1.3333;
    letter-spacing: 0.04em;
    color: var(--color-ink-3);
  }

  /* ============================================================
     V2: INDEX. The date leads, nothing else survives.

     Answers "what is the whole archive, in order" at roughly a third
     of the row height: six titles fit where two V1 rows do. Costs the
     description and the cover, so a title has to carry the post on its
     own, which is a real test of the titles.
     ============================================================ */
  .stage[data-variant="v2"] .pr-lead {
    display: block;
    flex: none;
    width: var(--pr-lead-w);
  }
  .stage[data-variant="v2"] .pr-thumb,
  .stage[data-variant="v2"] .pr-desc,
  .stage[data-variant="v2"] .pr-date {
    display: none;
  }

  /* ============================================================
     V3: EDITORIAL. Date above, title at the card step.

     Answers "what is worth reading" rather than "what is here": the
     title gets the largest step on the page and the sentence gets two
     lines to make its case. Costs the right-hand rail, so scanning by
     date or by length is gone, and the rows roughly double in height.
     ============================================================ */
  .stage[data-variant="v3"] .pr-eyebrow {
    display: block;
    margin-bottom: 0.25rem;
    text-transform: uppercase;
  }
  .stage[data-variant="v3"] .pr-thumb,
  .stage[data-variant="v3"] .pr-date {
    display: none;
  }
  .stage[data-variant="v3"] .pr {
    align-items: flex-start;
  }
  .stage[data-variant="v3"] .pr-title {
    font-size: var(--text-card);
    line-height: var(--text-card--line-height);
    letter-spacing: var(--text-card--letter-spacing);
    font-weight: 500;
  }
  .stage[data-variant="v3"] .pr-desc {
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }

  /* ============================================================
     V4: PLATE. The cover becomes an artifact rather than an icon.

     Answers "what is this about" before the title is read, and it is
     the only variation where the generated cover does any work: at
     64px it is a texture, at 160 it is a diagram. Costs half the rows
     per screen, and it is a bet on the cover generator the same way
     the card's poster wall was.
     ============================================================ */
  .stage[data-variant="v4"] .pr-thumb {
    width: 160px;
    height: 90px;
  }
  .stage[data-variant="v4"] .pr-desc {
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }
  .stage[data-variant="v4"] .pr-tags {
    display: flex;
  }

  /* ============================================================
     V5: STATUS. One stream, live and draft together.

     Answers "what is finished and what is queued" in a single list.
     /writing currently splits those into two sections, which means the
     newest thing on the site can be invisible in the first one. Costs
     a column of the rail, and it only works while the draft stages are
     honest: "outlined" is information, "coming soon" would not be.
     ============================================================ */
  .stage[data-variant="v5"] .pr-state {
    display: flex;
  }
  .stage[data-variant="v5"] .pr-meta {
    min-width: 6.5rem;
    gap: 0.125rem;
  }
  /* A draft is dimmer than a published post, which is the whole point
     of showing them together. */
  .stage[data-variant="v5"] .pr[data-status="draft"] .pr-title {
    color: var(--color-ink-2);
  }

  /* ============================================================
     Hover and focus. Identical on both paths, or the keyboard route
     is a different and worse list.
     ============================================================ */
  @media (hover: hover) and (pointer: fine) {
    .stage[data-hoverground="on"] .pr:hover {
      background-color: var(--color-sunken);
    }
    .pr:hover .pr-title::after {
      transform: scaleX(1);
    }
    .stage[data-hoverzoom="on"] .pr:hover .pr-img {
      transform: scale(var(--pr-hover));
    }
    .pr:hover .pr-meta {
      color: var(--color-ink-2);
    }
  }
  .pr:focus-visible .pr-title::after {
    transform: scaleX(1);
  }
  .stage[data-hoverzoom="on"] .pr:focus-visible .pr-img {
    transform: scale(var(--pr-hover));
  }

  /* ------------------------------------------------------------
     ENTER, AND RE-ENTER ON VARIATION CHANGE.

     Row by row, 50ms apart, in reading order. Without the replay,
     V1 to V4 is a jump cut: the rows change height under the cursor
     and the eye has to re-find the list.
     ------------------------------------------------------------ */
  @keyframes pr-enter {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .pr {
    animation: pr-enter var(--duration-moderate) var(--ease-out) both;
    animation-delay: calc(var(--enter-i, 0) * 50ms);
  }
  /* The replay: DialKit strips this, forces a reflow, puts it back. */
  .stage[data-enter="off"] .pr {
    animation: none;
  }

  /* ------------------------------------------------------------
     Dragging a spacing dial outlines the boxes it moves.

     A 2px padding change is invisible on a flat row and obvious
     against an outlined one, so the outlines come up while a slider is
     held. It is the "Outline every box" switch, granted for the length
     of a drag.

     The thumbnail's outline goes on a pseudo-element: its image is a
     block child that paints above the parent's outline, so an `outline`
     there would sit under the picture.
     ------------------------------------------------------------ */
  .pr,
  .pr-mid,
  .pr-title,
  .pr-desc,
  .pr-meta {
    outline: 1px solid transparent;
    outline-offset: -1px;
    transition-property: outline-color, background-color, color;
    transition-duration: var(--duration-moderate);
    transition-timing-function: var(--ease-out);
  }
  .pr-thumb::after {
    content: "";
    position: absolute;
    inset: 0;
    border: 1px solid transparent;
    border-radius: inherit;
    pointer-events: none;
    transition: border-color var(--duration-moderate) var(--ease-out);
  }
  .stage[data-bounds="on"] .pr,
  .stage[data-bounds="on"] .pr-mid,
  .stage[data-bounds="on"] .pr-title,
  .stage[data-bounds="on"] .pr-desc,
  .stage[data-bounds="on"] .pr-meta,
  .stage[data-dragging="on"] .pr,
  .stage[data-dragging="on"] .pr-mid,
  .stage[data-dragging="on"] .pr-title,
  .stage[data-dragging="on"] .pr-desc,
  .stage[data-dragging="on"] .pr-meta {
    outline-color: color-mix(in oklab, var(--color-note) 45%, transparent);
  }
  .stage[data-bounds="on"] .pr-thumb::after,
  .stage[data-dragging="on"] .pr-thumb::after {
    border-color: color-mix(in oklab, var(--color-note) 45%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .pr,
    .pr-img,
    .pr-meta,
    .pr-title::after,
    .pr-thumb::after {
      transition: none;
    }
    .pr:hover .pr-img,
    .pr:focus-visible .pr-img {
      transform: none;
    }
    .pr {
      animation: none;
    }
  }
</style>
