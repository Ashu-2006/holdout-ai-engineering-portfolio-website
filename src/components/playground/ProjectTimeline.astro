---
/**
 * V4, TIMELINE. Six systems on a real time axis.
 *
 * THE ARGUMENT: this is the only variation that shows information the
 * shipped design does not contain. Every other layout here rearranges
 * the same fields; this one derives something new from them.
 *
 * The shipped row prints "09.2025 - ∞" and leaves the reader to do the
 * arithmetic. Six of those, and nobody works out that Spindle Sentinel
 * and Grounded overlap for six months, or that three things are live
 * right now, or that Tabular Cleanroom ended before Review Triage
 * began. Position on an axis answers all three without being read.
 *
 * What it is actually evidence of: whether someone runs work in
 * parallel, whether they finish things, and whether "ongoing" means
 * two months or two years. That is a different question from "is the
 * model good", and it is one a reviewer definitely asks.
 *
 * ALL GEOMETRY IS COMPUTED AT BUILD TIME. No script, no measurement,
 * no layout shift. Percentages against a shared axis, so the bars
 * stay aligned at every viewport width without a resize handler.
 */
import { Icon } from "astro-icon/components";
import { humanDuration, maturityMeta, type Project } from "../../data/work";
import { monthIndex, nowMonthIndex } from "../../lib/metric";

interface Props {
  items: Project[];
}
const { items } = Astro.props;

const now = nowMonthIndex();

/* The axis. Ongoing work is measured to today, so the axis grows with
   the site rather than needing an authored end date that goes stale. */
const starts = items.map((p) => monthIndex(p.start));
const ends = items.map((p) => (p.end ? monthIndex(p.end) : now));

/*
 * One month of padding on each side, so a bar that starts on the axis
 * origin does not sit flush against the frame edge and read as clipped.
 *
 * Math.max(1, ...) guards a real edge: ONE project whose start and end
 * fall in the same month gives span 0 and every width below divides by
 * it. The playground passes six, but this component should not be the
 * reason a single-project collection renders as NaN%.
 */
const axisStart = Math.min(...starts) - 1;
const axisEnd = Math.max(...ends, now) + 1;
const span = Math.max(1, axisEnd - axisStart);

const pct = (m: number) => ((m - axisStart) / span) * 100;

/* Year boundaries that fall inside the axis, for the tick rules. */
const firstYear = Math.ceil(axisStart / 12);
const lastYear = Math.floor(axisEnd / 12);
const years: { year: number; left: number }[] = [];
for (let y = firstYear; y <= lastYear; y++) {
  years.push({ year: y, left: pct(y * 12) });
}

const nowLeft = pct(now);

/* Chronological, oldest at the top: a timeline read downwards is the
   one convention nobody has to be taught. */
const rows = [...items]
  .sort((a, b) => a.start.localeCompare(b.start))
  .map((p) => {
    const s = monthIndex(p.start);
    const e = p.end ? monthIndex(p.end) : now;
    return {
      p,
      left: pct(s),
      /* A one-month project would render as a zero-width bar and
         disappear entirely, so every bar claims at least one month of
         the axis. The floor is visual, not a claim about duration:
         the mono label beside it carries the real figure. */
      width: Math.max(((e - s) / span) * 100, 100 / span),
      ongoing: p.end === null,
    };
  });
---

{
  rows.length === 0 ? (
    <div class="well text-center">
      <p class="text-body text-ink">No spans to plot.</p>
      <p class="mt-1 text-body text-ink-3">
        An axis with nothing on it is just a ruler, so the frame does not
        draw itself.
      </p>
    </div>
  ) : (
    <div class="timeline">
      {/* The axis header: year ticks and today. Sticky is deliberate,
          see the note in the style block. */}
      <div class="relative mb-2 hidden h-5 sm:block" aria-hidden="true">
        {/*
          The inner box is inset by the label column, so a tick at 50%
          means halfway along the TRACK.

          Padding on the outer box would not work: an absolutely
          positioned child resolves both `left: %` and its containing
          block against the PADDING box, so the padding shifts nothing
          and the percentage scale stays wrong by the width of the
          label column. An inset box is the only version where the
          percentages the axis and the bars use are the same number.
        */}
        <div class="timeline-grid-inner">
          {years.map((y) => (
            <span
              class="absolute top-0 -translate-x-1/2"
              style={`left: ${y.left}%`}
            >
              <span class="numeric text-label text-ink-3">{y.year}</span>
            </span>
          ))}
        </div>
      </div>

      <ul class="rows relative border-t border-line-2">
        {/*
          THE GRID BEHIND THE BARS. Year rules and the today marker are
          drawn once across the whole list rather than per row, so they
          are genuinely continuous lines instead of six aligned
          fragments that go out of register at the first rounding error.

          Absolutely positioned over the list and pointer-events-none,
          so they never intercept a hover meant for a bar.
        */}
        <div
          class="pointer-events-none absolute inset-0 hidden sm:block"
          aria-hidden="true"
        >
          <div class="timeline-grid-inner">
            {years.map((y) => (
              <span
                class="absolute inset-y-0 w-px bg-line-2"
                style={`left: ${y.left}%`}
              />
            ))}
            {/* Today. The one line with a job beyond decoration: it is
                what makes "ongoing" legible as a bar that reaches it. */}
            <span
              class="timeline-now absolute inset-y-0 w-px"
              style={`left: ${nowLeft}%`}
            />
          </div>
        </div>

        {rows.map(({ p, left, width, ongoing }) => {
          const m = maturityMeta[p.maturity];
          return (
            <li class="relative">
              <a
                href={`/work/${p.slug}`}
                class="row-interactive group/tl block py-3"
              >
                <div class="grid items-center gap-x-3 gap-y-1.5 sm:grid-cols-[11rem_1fr]">
                  {/*
                    Label column. Above the bar on narrow viewports and
                    beside it above the breakpoint: an 11rem label plus
                    a track at 360px leaves the track under 6rem wide,
                    at which point the geometry stops carrying any
                    information at all.
                  */}
                  <div class="flex min-w-0 items-center gap-2">
                    <Icon
                      name={p.icon}
                      class="size-4 shrink-0 text-ink-4 transition-colors duration-fast ease-out group-hover/tl:text-ink-2"
                      aria-hidden="true"
                    />
                    <span class="min-w-0 flex-1 truncate text-body text-ink">
                      {p.title}
                    </span>
                    <span class="numeric shrink-0 text-label text-ink-3">
                      {humanDuration(p.start, p.end)}
                    </span>
                  </div>

                  {/* The track. */}
                  <div class="timeline-track relative h-6">
                    <div
                      class:list={[
                        "timeline-bar absolute top-1/2 flex -translate-y-1/2 items-center rounded-full border",
                        ongoing && "timeline-bar-open",
                        m.tone === "live" && "timeline-bar-live",
                        m.tone === "caution" && "timeline-bar-caution",
                        m.tone === "muted" && "timeline-bar-muted",
                      ]}
                      style={`left: ${left}%; width: ${width}%`}
                    >
                      {/*
                        The value rides inside the bar. It is the one
                        number worth having on a chart, and putting it
                        in the bar means the bar is not just a shape
                        whose meaning lives elsewhere.

                        overflow-hidden on the bar clips it when the
                        span is too short to hold it, which is the
                        correct failure: a figure spilling out of its
                        bar would sit on top of the neighbouring one.
                      */}
                      <span class="numeric truncate px-2 text-label">
                        {p.metric.value}
                      </span>
                    </div>

                    {/* The open terminus. An ongoing bar should not end
                        in a cap, because a cap is what "finished"
                        looks like. */}
                    {ongoing && (
                      <span
                        class="timeline-fade absolute top-1/2 -translate-y-1/2"
                        style={`left: calc(${left}% + ${width}%)`}
                        aria-hidden="true"
                      />
                    )}
                  </div>
                </div>
              </a>
            </li>
          );
        })}
      </ul>

      {/* The key. A chart whose colours are not explained is a
          decoration, and three of these tones carry state meaning
          used across the whole site. */}
      <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1.5 border-t border-line-2 pt-3">
        {[
          { label: "Deployed or shipped", cls: "timeline-key-live" },
          { label: "Prototype", cls: "timeline-key-caution" },
          { label: "Open bar means ongoing", cls: "timeline-key-open" },
          { label: "Today", cls: "timeline-key-now" },
        ].map((k) => (
          <span class="flex items-center gap-1.5">
            <span class:list={["timeline-key", k.cls]} aria-hidden="true" />
            <span class="label label-quiet">{k.label}</span>
          </span>
        ))}
      </div>
    </div>
  )
}

<style>
  /* The grid overlay has to align with the TRACK, not with the row, so
     it is inset by the label column above the breakpoint. Hardcoding
     11rem + 0.75rem gap here duplicates the grid-template above, which
     is the one duplication this layout cannot avoid: a pseudo-element
     cannot read a grid track's resolved width. If the label column
     changes, this changes with it. */
  .timeline-grid-inner {
    position: absolute;
    inset: 0;
    left: calc(11rem + 0.75rem);
  }

  .timeline-now {
    background-color: var(--color-ink-4);
    /* Dashed, so it reads as a reference line rather than as another
       year boundary. Drawn with a gradient because border-style on a
       1px element renders inconsistently across engines. */
    background-image: repeating-linear-gradient(
      to bottom,
      var(--color-ink-4) 0 3px,
      transparent 3px 6px
    );
    background-color: transparent;
  }

  .timeline-bar {
    height: 1.25rem;
    min-width: 0.375rem;
    background-color: var(--color-surface);
    border-color: var(--color-line);
    color: var(--color-ink-2);
    overflow: hidden;
    transition:
      border-color var(--motion-hover),
      background-color var(--motion-hover);
  }
  .timeline-bar-live {
    border-color: color-mix(in oklab, var(--color-live) 45%, transparent);
    background-color: color-mix(in oklab, var(--color-live) 10%, var(--color-surface));
    color: var(--color-live);
  }
  .timeline-bar-caution {
    border-color: color-mix(in oklab, var(--color-caution) 45%, transparent);
    background-color: color-mix(
      in oklab,
      var(--color-caution) 10%,
      var(--color-surface)
    );
    color: var(--color-caution);
  }
  .timeline-bar-muted {
    border-color: var(--color-line);
    color: var(--color-ink-3);
  }

  /* Ongoing: the right cap comes off and the fill runs out. */
  .timeline-bar-open {
    border-right-color: transparent;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    mask-image: linear-gradient(to right, black 78%, transparent 100%);
  }
  .timeline-fade {
    width: 1.25rem;
    height: 1.25rem;
    /* Three dots continuing past the bar's end. Cheaper and clearer
       than an arrowhead, which at 20px reads as a glyph rather than as
       a direction. */
    background-image: radial-gradient(
      circle at 2px 50%,
      var(--color-ink-4) 1px,
      transparent 1.5px
    );
    background-size: 6px 100%;
    background-repeat: repeat-x;
    opacity: 0.7;
  }

  /* Hover is on the bar, driven from the row, so the whole row is the
     hit target rather than a 20px-tall bar. */
  .group\/tl:hover .timeline-bar {
    border-color: currentColor;
  }

  .timeline-key {
    width: 1.125rem;
    height: 0.625rem;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    background-color: var(--color-surface);
    flex-shrink: 0;
  }
  .timeline-key-live {
    border-color: color-mix(in oklab, var(--color-live) 45%, transparent);
    background-color: color-mix(in oklab, var(--color-live) 10%, var(--color-surface));
  }
  .timeline-key-caution {
    border-color: color-mix(in oklab, var(--color-caution) 45%, transparent);
    background-color: color-mix(
      in oklab,
      var(--color-caution) 10%,
      var(--color-surface)
    );
  }
  .timeline-key-open {
    border-right-color: transparent;
    mask-image: linear-gradient(to right, black 60%, transparent 100%);
  }
  .timeline-key-now {
    width: 1px;
    height: 0.875rem;
    border: 0;
    border-radius: 0;
    background-image: repeating-linear-gradient(
      to bottom,
      var(--color-ink-4) 0 3px,
      transparent 3px 6px
    );
  }

  /*
   * BELOW THE BREAKPOINT the label stacks above the track, so the
   * track occupies the full width and the overlay's left inset would
   * be wrong. The overlay is hidden there (sm:block in the markup) and
   * the bars carry their own tone, which is enough: without year rules
   * the chart reads as relative position rather than absolute date,
   * and the mono duration beside each title supplies the number.
   */
  @media (max-width: 40rem) {
    .timeline-grid-inner {
      left: 0;
    }
  }
</style>
