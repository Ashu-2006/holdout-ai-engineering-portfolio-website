---
/**
 * The card lab's spec. Everything that makes it a panel lives in
 * DialKit.astro; this file is only the list of decisions the project
 * card contains.
 */
import DialKit from "./DialKit.astro";
import {
  canvasGroup,
  dial,
  num,
  px,
  seg,
  toggle,
  type Group,
  type Variant,
} from "./dial-spec";

/*
 * THE FIVE VARIATIONS.
 *
 * Each states what it answers and what it costs, in the panel rather
 * than on the stage. A variation with no stated cost has not been
 * thought about, so the field is not optional.
 */
const variants: Variant[] = [
  {
    v: "v1",
    index: "V1",
    name: "Reference",
    note: "The Figma node, measured. 360 x 458, artifact first, split footer. This is what ships.",
  },
  {
    v: "v2",
    index: "V2",
    name: "Plate",
    note: "Measurement rides the artifact, top edge, because the generator already plates the bottom-left. No sentence, so a weak poster says nothing.",
  },
  {
    v: "v3",
    index: "V3",
    name: "Spec",
    note: "Four fields instead of the poster. A missing baseline becomes visible.",
  },
  {
    v: "v4",
    index: "V4",
    name: "Split",
    note: "Artifact left, body right. Half the height in a list, and it needs about 540px of width before the footer labels stop wrapping.",
  },
  {
    v: "v5",
    index: "V5",
    name: "Quiet",
    note: "Full-bleed artifact, no footer chrome. Tests whether plain links still read as actions.",
  },
];

const groups: Group[] = [
  canvasGroup(),
  {
    title: "Card",
    note: "342.4 is not arbitrary: 360 minus 16px of padding minus 1.6px of border.",
    controls: [
      px("pc-w", "Width", "--pc-w", 360, 240, 720),
      px("pc-pad", "Padding", "--pc-pad", 8, 0, 32),
      px("pc-radius", "Radius", "--pc-radius", 16, 0, 40),
      dial("pc-border", "Hairline", "--pc-border", "px", 0.8, 0, 3, 0.1),
      seg("border", "Border", "border", "dashed", [
        ["dashed", "Dashed"],
        ["solid", "Solid"],
        ["none", "None"],
      ]),
      px("pc-frame-radius", "Inner radius", "--pc-frame-radius", 8, 0, 32),
      dial("pc-split", "Split column", "--pc-split", "%", 40, 20, 70, 1),
    ],
  },
  {
    title: "Artifact",
    /*
     * The one place the reference and the generator disagree, so it is
     * stated on the control rather than buried in a commit message.
     */
    note: "1.274 is the shipped ratio and it crops these posters: they are generated at 1200x750, so 1.6 is the ratio that shows all of one. The Figma node measures 1.312.",
    controls: [
      toggle("f-poster", "Poster", "poster", true),
      num("pc-ratio", "Frame ratio", "--pc-ratio", 1.274, 0.6, 2.4, 0.001),
      seg("fit", "Fit", "fit", "cover", [
        ["cover", "Cover"],
        ["contain", "Contain"],
      ]),
      toggle("f-hoverzoom", "Hover scale", "hoverzoom", true),
      num("pc-hover", "Scale to", "--pc-hover", 1.03, 1, 1.2, 0.005),
    ],
  },
  {
    title: "Body spacing",
    controls: [
      px("pc-body-y", "Block padding", "--pc-body-y", 14, 0, 40),
      px("pc-body-x", "Inline padding", "--pc-body-x", 10, 0, 40),
      px("pc-desc-gap", "Title to copy", "--pc-desc-gap", 10, 0, 40),
      px("pc-metric-gap", "Title to metric", "--pc-metric-gap", 8, 0, 40),
      px("pc-chips-gap", "Copy to chips", "--pc-chips-gap", 14, 0, 40),
      num("pc-clamp", "Line clamp", "--pc-clamp", 3, 0, 8, 1, "clamp"),
    ],
  },
  {
    title: "Type",
    controls: [
      px("pc-title-size", "Title size", "--pc-title-size", 20, 12, 40),
      num("pc-title-lead", "Title leading", "--pc-title-lead", 1.28, 0.9, 1.8, 0.01),
      dial("pc-title-track", "Title tracking", "--pc-title-track", "em", -0.015, -0.06, 0.04, 0.001),
      num("pc-title-weight", "Title weight", "--pc-title-weight", 500, 400, 600, 100),
      px("pc-date-size", "Date size", "--pc-date-size", 12, 9, 20),
      px("pc-body-size", "Copy size", "--pc-body-size", 16, 11, 24),
      num("pc-body-lead", "Copy leading", "--pc-body-lead", 1.5, 1.1, 2, 0.01),
    ],
  },
  {
    title: "Footer",
    controls: [
      px("pc-foot-h", "Row height", "--pc-foot-h", 44, 28, 72),
      px("pc-foot-x", "Inline padding", "--pc-foot-x", 12, 0, 32),
      px("pc-action-gap", "Label to glyph", "--pc-action-gap", 8, 0, 24),
      px("pc-icon", "Glyph size", "--pc-icon", 16, 10, 28),
      toggle("f-icons", "Glyphs", "icons", true),
      seg("divider", "Rules", "divider", "dashed", [
        ["dashed", "Dashed"],
        ["solid", "Solid"],
        ["none", "None"],
      ]),
      seg("actions", "Actions", "actions", "2", [
        ["2", "Two"],
        ["1", "One"],
        ["0", "None"],
      ]),
    ],
  },
  {
    title: "Content",
    note: "Both off is the shipped card. They were on it and came off with the finalised design; the toggles stay so putting either back is still a question you can answer here rather than in the component.",
    controls: [
      toggle("f-date", "Date", "date", true),
      toggle("f-metric", "Measurement line", "metric", false),
      toggle("f-chips", "Stack chips", "chips", false),
    ],
  },
];
---

<DialKit
  eyebrow="Card lab"
  variants={variants}
  groups={groups}
  storageKey="cardlab.v1"
  selector=".pc"
  source="31:1950"
  lock={{
    label: "Lock concentric radii",
    target: "pc-frame-radius",
    from: "pc-radius",
    minus: "pc-pad",
    group: "Card",
    on: true,
  }}
  stress={{
    id: "f-longtitle",
    label: "Long title",
    target: "pc-title",
    /* Two of the six real records are close to this length, so it is a
       case, not a torture test. */
    text: "Spindle Sentinel, bearing-fault detection",
    group: "Content",
  }}
/>
