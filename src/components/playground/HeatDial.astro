---
/**
 * The contribution grid lab's spec. Everything that makes it a panel
 * lives in DialKit.astro; this file is only the list of decisions the
 * grid contains.
 *
 * NO STRESS TOGGLE HERE. The card and post labs each have one because
 * their content is prose and a long string is the case that breaks
 * them. This figure's content is 364 integers from a seeded generator,
 * so the equivalent stress is not "a longer title", it is a different
 * shaped year, and the Weeks and Direction controls cover the part of
 * that which is a layout question.
 */
import DialKit from "./DialKit.astro";
import {
  canvasGroup,
  dial,
  ms,
  num,
  px,
  seg,
  toggle,
  type Group,
  type Variant,
} from "./dial-spec";

const variants: Variant[] = [
  {
    v: "v1",
    index: "V1",
    name: "Figure",
    note: "What ships, measured. Bare grid, Fig. 1 caption with the total and the source, Less/More ramp. The caption is what makes it evidence rather than a vanity widget.",
  },
  {
    v: "v2",
    index: "V2",
    name: "Labelled",
    note: "Months across, weekdays down. A sprint can be located in calendar time instead of counted in columns. Costs 17px of height and adds 20 text elements to a figure whose austerity is part of the argument.",
  },
  {
    v: "v3",
    index: "V3",
    name: "Streak",
    note: "Current, longest, active share, busiest day. States what the shades only show. Costs the austerity: four figures over a contribution grid is the exact shape of a vanity widget, and every one is read off the same cells.",
  },
  {
    v: "v4",
    index: "V4",
    name: "Dense",
    note: "7px cells, no legend, 468px wide. Can sit beside something else instead of owning a band. Costs per-day readability: at 7px a shade cannot be placed on the ramp by eye, so it shows shape only.",
  },
  {
    v: "v5",
    index: "V5",
    name: "Bars",
    note: "One bar per week, height by volume. The two sprints and the two exam troughs are unmistakable. Costs day resolution entirely, and the GitHub-native form that reads without a caption.",
  },
];

const groups: Group[] = [
  canvasGroup(),
  {
    title: "Grid",
    note: "52 weeks at 11px with 3px gaps is 725px intrinsic, which is why the figure scrolls on its own axis rather than shrinking the cells.",
    controls: [
      seg("weeks", "Span", "weeks", "52", [
        ["26", "26w"],
        ["52", "52w"],
        ["78", "78w"],
      ]),
      px("hm-cell", "Cell", "--hm-cell", 11, 4, 24),
      px("hm-gap", "Gap", "--hm-gap", 3, 0, 10),
      px("hm-radius", "Cell radius", "--hm-radius", 2, 0, 12),
    ],
  },
  {
    title: "Ramp",
    /*
     * The one control here that is an argument rather than a number.
     */
    note: "Hue is the open question. The grid was monochrome first, because this design reserves chroma for state and for the artifact posters and 364 green cells is the loudest object on any page. It ships green because a page with no chroma reads unfinished. Both are one click apart.",
    controls: [
      seg("hue", "Hue", "hue", "live", [
        ["live", "Green"],
        ["ink", "Mono"],
        ["note", "Blue"],
      ]),
      dial("hm-l0", "Empty", "--hm-l0", "%", 7, 0, 30, 1),
      dial("hm-l1", "Level 1", "--hm-l1", "%", 26, 5, 60, 1),
      dial("hm-l2", "Level 2", "--hm-l2", "%", 50, 20, 80, 1),
      dial("hm-l3", "Level 3", "--hm-l3", "%", 74, 40, 95, 1),
    ],
  },
  {
    title: "Appear",
    note: "The delay comes off the week index, so the year fills like a timeline. 52 columns at 8ms is 416ms, which is inside the reveal budget and never holds up reading.",
    controls: [
      seg("direction", "Direction", "direction", "ltr", [
        ["ltr", "L to R"],
        ["rtl", "R to L"],
        ["days", "Scan"],
      ]),
      ms("hm-stagger", "Per column", "--hm-stagger", 8, 0, 40, 1),
      ms("hm-in-dur", "Duration", "--hm-in-dur", 260, 60, 900, 10),
      num("hm-in-scale", "From scale", "--hm-in-scale", 0.4, 0, 1, 0.05),
    ],
  },
  {
    title: "Hover",
    note: "The hovered cell grows and the field falls back behind one veil. One scrim at one opacity, not 363 filters: the per-cell version cost 73ms of style work per pointer move against 2ms for the shipped figure, and desaturation was most of it.",
    controls: [
      num("hm-hover", "Cell scale", "--hm-hover", 1.65, 1, 3, 0.05),
      toggle("f-dim", "Dim the field", "dim", true),
      num("hm-dim", "Veil opacity", "--hm-dim", 0.62, 0.2, 0.9, 0.02),
      toggle("f-cross", "Crosshair", "cross", true),
      toggle("f-readout", "Caption readout", "readout", true),
      toggle("f-outline", "Hairline outline", "outline", true),
    ],
  },
  {
    title: "Caption",
    controls: [
      toggle("f-caption", "Caption", "caption", true),
      toggle("f-legend", "Ramp legend", "legend", true),
      px("hm-cap-gap", "Grid to caption", "--hm-cap-gap", 12, 0, 40),
      px("hm-key", "Swatch", "--hm-key", 10, 6, 20),
      px("hm-key-gap", "Swatch gap", "--hm-key-gap", 6, 0, 16),
    ],
  },
  {
    title: "Labels",
    note: "Both off is what ships. Real GitHub carries them; this figure dropped them to stay a figure.",
    controls: [
      toggle("f-months", "Month labels", "months", false),
      toggle("f-days", "Weekday labels", "days", false),
      px("hm-label", "Label size", "--hm-label", 11, 8, 16),
    ],
  },
  {
    title: "Bars",
    note: "V5 only.",
    controls: [
      px("hm-bar-w", "Bar width", "--hm-bar-w", 8, 2, 20),
      px("hm-bar-h", "Bar height", "--hm-bar-h", 96, 40, 220),
    ],
  },
];
---

<DialKit
  eyebrow="Grid lab"
  variants={variants}
  groups={groups}
  storageKey="heatlab.v1"
  selector=".heat"
  source="1:15007"
  replay
/>
