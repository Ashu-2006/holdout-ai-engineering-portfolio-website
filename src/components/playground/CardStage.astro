---
/**
 * The card lab stage. One card, dead centre, driven entirely by
 * custom properties so the dial can move anything without a re-render.
 *
 * V1 IS THE REFERENCE, MEASURED. Every default below is the Figma node
 * (Portfolio-Template 31:1950), not an approximation of it:
 *
 *   card      360 x 458, 8px padding, 16px radius, 0.8px dashed line
 *   frame     342.4 x 261 sunken, 8px radius  -> ratio 1.312
 *   body      14px block / 10px inline
 *   title     20 / 25.6, weight 500, tracking -0.015em
 *   date      mono 12 / 16, tracking 0.04em, baseline-aligned
 *   desc      16 / 24, tracking 0.01em, clamped at 3 lines
 *   footer    44px rows, 12px inline, 8px gap, 16px glyph
 *
 * 342.4 is not a magic number: 360 minus 16px padding minus 1.6px of
 * border. The whole card is integers once you unwrap the border box.
 *
 * WHY CUSTOM PROPERTIES AND NOT FIVE MARKUPS. The five variations share
 * one DOM tree and differ only by rules under [data-variant]. That is
 * the reason a dial is worth building: turning the padding down moves
 * all five identically, so what is left on screen is the layout
 * argument rather than five drifting copies. It also makes "V1 exactly
 * as designed" structural instead of a promise, because V1 is the base
 * and the other four are deltas from it.
 *
 * NOTHING HERE DEPENDS ON JS. The defaults live in this stylesheet, so
 * with scripting off the stage still renders V1 at reference spec. The
 * dial only overrides.
 */
import { Icon } from "astro-icon/components";
import { dotDate, maturityMeta, projects } from "../../data/work";
import { leadingFigure } from "../../lib/metric";

/* Spindle Sentinel, because that is the record in the Figma node. */
const p = projects[0];
const m = maturityMeta[p.maturity];
const was = leadingFigure(p.metric.baseline);

/*
 * The footer's two actions, in the reference's own wording: the source
 * first, the writeup second. Ranked rather than filtered, so the two
 * slots always fill when the project can fill them.
 */
const actions = [
  { label: "GitHub", icon: "ph:github-logo", url: p.evidence[0].url },
  { label: "Failure modes", icon: "ph:article", url: p.evidence[1].url },
];

/* The four fields V3 turns the card into. Mono keys, aligned. */
const spec: [string, string][] = [
  ["State", m.label],
  ["Result", `${p.metric.value} ${p.metric.label}`],
  ["Baseline", p.metric.baseline ?? "none stated"],
  ["Stack", p.chips.slice(0, 3).join(", ")],
];
---

<div
  class="stage"
  id="stage"
  data-variant="v1"
  data-poster="on"
  data-date="on"
  data-metric="off"
  data-chips="off"
  data-icons="on"
  data-actions="2"
  data-border="dashed"
  data-divider="dashed"
  data-fit="cover"
  data-hoverzoom="on"
  data-bounds="off"
  data-grid="off"
  data-backdrop="ground"
  data-title="normal"
  data-clamp="on"
>
  <div class="stage-scroll">
    <article class="pc">
      {/*
        The frame clips and the poster scales inside it, so the only
        motion on hover reads as looking closer rather than as the card
        lifting off the sheet. data-poster="off" empties it back to the
        Figma node, which ships a bare sunken container.
      */}
      <div class="pc-frame">
        <img
          src={p.poster}
          alt={`${p.title}: ${p.metric.label} ${p.metric.value}, ${p.metric.context}`}
          width="1200"
          height="750"
          decoding="async"
          class="pc-img"
        />

        {/* V2 only. The measurement rides the artifact instead of a
            prose line, on a scrim so it survives a bright poster. */}
        <div class="pc-plate">
          <span class="pc-plate-state">{m.label}</span>
          <span class="numeric pc-plate-value">{p.metric.value}</span>
          <span class="pc-plate-label">{p.metric.label}</span>
        </div>
      </div>

      <div class="pc-body">
        <div class="pc-head">
          <h3 class="pc-title" id="pc-title">{p.title}</h3>
          <span class="numeric pc-date">{dotDate(p.start)}</span>
        </div>

        {/* Off by default, and off on the shipped card too: the
            finalised design is title, date, sentence, two actions. It
            stays reachable here because "should the card carry the
            number" is a live question, and this is where it gets
            answered. See the Content group note in CardDial. */}
        <p class="pc-metric">
          <span
            class:list={[
              "pc-dot",
              m.tone === "live" && "is-live",
              m.tone === "caution" && "is-caution",
              m.tone === "muted" && "is-muted",
            ]}
            aria-hidden="true"></span>
          <span class="pc-metric-key">{m.label}</span>
          <span class="pc-tick" aria-hidden="true"></span>
          <span class="numeric pc-metric-value">{p.metric.value}</span>
          <span class="pc-metric-key">{p.metric.label}</span>
          {
            was && (
              <>
                <span class="pc-tick" aria-hidden="true" />
                <span class="pc-metric-key">was {was}</span>
              </>
            )
          }
        </p>

        <p class="pc-desc" id="pc-desc">{p.outcome}</p>

        {/* V3 only. The same record as a field list, so a missing
            answer is visible rather than lost inside a sentence. */}
        <dl class="pc-spec">
          {
            spec.map(([k, v]) => (
              <>
                <dt class="pc-spec-key">{k}</dt>
                <dd class="pc-spec-val">{v}</dd>
              </>
            ))
          }
        </dl>

        <ul class="pc-chips">
          {p.chips.slice(0, 5).map((c) => <li class="pc-chip">{c}</li>)}
        </ul>
      </div>

      {/*
        grid-auto-flow: column with 1fr columns, so one action spans the
        card and two divide it evenly with no branch in the markup and
        no class per count. data-actions drives which are visible.
      */}
      <div class="pc-foot">
        {
          actions.map((a) => (
            <a href={a.url} rel="noopener" target="_blank" class="pc-action">
              <span>{a.label}</span>
              <Icon name={a.icon} class="pc-icon" aria-hidden="true" />
            </a>
          ))
        }

        {/* The named gap. Reached at data-actions="0". An empty footer
            reads as an oversight; a named one reads as a decision. */}
        <span class="pc-action pc-action--empty">
          <Icon name="ph:warning" class="pc-icon" aria-hidden="true" />
          <span>Nothing public yet</span>
        </span>
      </div>
    </article>
  </div>
</div>

<style>
  /* ============================================================
     THE CONTRACT.

     Every value the dial can move is declared once here. The dial
     writes the same names onto #stage's inline style, which wins on
     specificity without touching a class, so "Copy CSS" from the panel
     produces a block that drops straight into a component.
     ============================================================ */
  .stage {
    /* geometry */
    --pc-w: 360px;
    --pc-pad: 8px;
    --pc-radius: 16px;
    --pc-border: 0.8px;
    --pc-frame-radius: 8px;
    /* 1.274 is the shipped ratio. The Figma node measures 1.312; see
       the Artifact group note in CardDial for what the difference
       costs. This default is what renders with scripting off. */
    --pc-ratio: 1.274;
    --pc-split: 40%;

    /* body */
    --pc-body-x: 10px;
    --pc-body-y: 14px;
    --pc-desc-gap: 10px;
    --pc-metric-gap: 8px;
    --pc-chips-gap: 14px;
    --pc-clamp: 3;

    /* type */
    --pc-title-size: 20px;
    --pc-title-lead: 1.28;
    --pc-title-track: -0.015em;
    --pc-title-weight: 500;
    --pc-date-size: 12px;
    --pc-body-size: 16px;
    --pc-body-lead: 1.5;

    /* footer */
    --pc-foot-h: 44px;
    --pc-foot-x: 12px;
    --pc-action-gap: 8px;
    --pc-icon: 16px;

    --pc-hover: 1.03;
  }

  /* The stage itself, the 8px lattice and the zoom wrapper live in
     LabShell, because "centred on a ground you can change, at a zoom
     you can change" is the same job in every lab. */

  /* ============================================================
     V1: the reference card.
     ============================================================ */
  .pc {
    position: relative;
    display: flex;
    flex-direction: column;
    width: var(--pc-w);
    max-width: 100%;
    padding: var(--pc-pad);
    border: var(--pc-border) dashed var(--color-line);
    border-radius: var(--pc-radius);
    background-color: var(--color-surface);
    transition: border-color var(--motion-hover);
  }

  .stage[data-border="solid"] .pc {
    border-style: solid;
  }
  .stage[data-border="none"] .pc {
    border-style: none;
  }

  .pc-frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: var(--pc-ratio);
    border-radius: var(--pc-frame-radius);
    background-color: var(--color-sunken);
  }
  .pc-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-moderate) var(--ease-out);
  }
  .stage[data-fit="contain"] .pc-img {
    object-fit: contain;
  }
  /* The Figma node ships this frame empty. Kept reachable, because an
     empty frame is also the real loading and no-artifact state. */
  .stage[data-poster="off"] .pc-img {
    display: none;
  }

  .pc-body {
    padding: var(--pc-body-y) var(--pc-body-x);
  }

  /* Baseline alignment, not centre. The date is 12px mono against 20px
     sans; centring them puts the mono figures visibly high. */
  .pc-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .pc-title {
    min-width: 0;
    font-size: var(--pc-title-size);
    line-height: var(--pc-title-lead);
    letter-spacing: var(--pc-title-track);
    font-weight: var(--pc-title-weight);
    color: var(--color-ink);
    text-wrap: balance;
  }

  .pc-date {
    flex: none;
    font-size: var(--pc-date-size);
    line-height: 1.3333;
    letter-spacing: 0.04em;
    color: var(--color-ink-3);
  }
  .stage[data-date="off"] .pc-date {
    display: none;
  }

  .pc-desc {
    margin-top: var(--pc-desc-gap);
    font-size: var(--pc-body-size);
    line-height: var(--pc-body-lead);
    letter-spacing: 0.01em;
    color: var(--color-ink-2);
    text-wrap: pretty;
  }
  /* -webkit-line-clamp is the only clamp with real support. The dial
     switches data-clamp rather than setting the count to 0, because 0
     is not a valid clamp and would silently collapse the paragraph. */
  .stage[data-clamp="on"] .pc-desc {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: var(--pc-clamp);
    line-clamp: var(--pc-clamp);
    overflow: hidden;
  }

  /* The measurement line: state, result, baseline, one row. */
  .pc-metric {
    display: none;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
    margin-top: var(--pc-metric-gap);
  }
  .stage[data-metric="on"] .pc-metric {
    display: flex;
  }
  .pc-metric-key {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    line-height: var(--text-label--line-height);
    letter-spacing: var(--text-label--letter-spacing);
    text-transform: uppercase;
    color: var(--color-ink-3);
  }
  .pc-metric-value {
    font-size: var(--text-label);
    color: var(--color-ink);
  }
  .pc-dot {
    width: 6px;
    height: 6px;
    flex: none;
    border-radius: 999px;
    background-color: var(--color-ink-4);
  }
  .pc-dot.is-live {
    background-color: var(--color-live);
  }
  .pc-dot.is-caution {
    background-color: var(--color-caution);
  }
  .pc-dot.is-muted {
    background-color: var(--color-ink-4);
  }
  /* Punctuation as a hairline rather than a slash: it should not be
     read out by a screen reader or land in a copied selection. */
  .pc-tick {
    width: 1px;
    height: 0.6875rem;
    flex: none;
    background-color: var(--color-ink-4);
    opacity: 0.6;
  }

  .pc-spec {
    display: none;
    grid-template-columns: 5.5rem 1fr;
    gap: 0.375rem 0.75rem;
    margin-top: var(--pc-desc-gap);
  }
  .pc-spec-key {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    line-height: var(--text-label--line-height);
    letter-spacing: var(--text-label--letter-spacing);
    text-transform: uppercase;
    color: var(--color-ink-3);
  }
  .pc-spec-val {
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    color: var(--color-ink);
  }

  .pc-chips {
    display: none;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: var(--pc-chips-gap);
  }
  .stage[data-chips="on"] .pc-chips {
    display: flex;
  }
  .pc-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    line-height: 1.125rem;
    letter-spacing: var(--text-label--letter-spacing);
    color: var(--color-ink-2);
    white-space: nowrap;
  }

  .pc-foot {
    margin-top: auto;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    border-top: var(--pc-border) dashed var(--color-line-2);
  }
  /*
     `a + a`, not `* + *`. The named-gap span is the footer's third
     child and is normally display:none, so a universal sibling rule
     would hand it a divider the moment it became the only visible
     cell.
  */
  .pc-foot > a + a {
    border-left: var(--pc-border) dashed var(--color-line-2);
  }
  .stage[data-divider="solid"] .pc-foot,
  .stage[data-divider="solid"] .pc-foot > a + a {
    border-style: solid;
  }
  .stage[data-divider="none"] .pc-foot {
    border-top-style: none;
  }
  .stage[data-divider="none"] .pc-foot > a + a {
    border-left-style: none;
  }

  .pc-action {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--pc-action-gap);
    /* The card's real targets, side by side, so they carry the full
       44px touch minimum rather than the 24px an inline link gets. */
    min-height: var(--pc-foot-h);
    padding: 0.5rem var(--pc-foot-x);
    font-size: var(--pc-body-size);
    line-height: 1.5;
    letter-spacing: 0.01em;
    color: var(--color-ink-2);
    transition:
      color var(--motion-hover),
      background-color var(--motion-hover);
  }
  /* Radii go on the first and last VISIBLE cell, so they follow the
     action count instead of landing on the hidden named gap. */
  .pc-foot > a:first-of-type {
    border-bottom-left-radius: var(--pc-frame-radius);
  }
  .pc-foot > a:last-of-type {
    border-bottom-right-radius: var(--pc-frame-radius);
  }
  .pc-action--empty {
    display: none;
    color: var(--color-caution);
    cursor: default;
    border-end-start-radius: var(--pc-frame-radius);
    border-end-end-radius: var(--pc-frame-radius);
  }
  :global(.pc-icon) {
    flex: none;
    width: var(--pc-icon);
    height: var(--pc-icon);
  }
  .stage[data-icons="off"] :global(.pc-icon) {
    display: none;
  }

  /* One action spans the card; zero swaps in the named gap. */
  .stage[data-actions="1"] .pc-foot > a:nth-of-type(2) {
    display: none;
  }
  .stage[data-actions="1"] .pc-foot > a:first-of-type {
    border-end-end-radius: var(--pc-frame-radius);
  }
  .stage[data-actions="0"] .pc-foot > a {
    display: none;
  }
  .stage[data-actions="0"] .pc-action--empty {
    display: flex;
  }

  /* ============================================================
     V2: PLATE. The artifact carries the measurement.

     Answers "what did this produce and how well" with no prose at all.
     Costs the sentence, so a poster that does not read at 342px wide
     leaves the card saying nothing.
     ============================================================ */
  /*
     THE PLATE SITS AT THE TOP, AND THAT IS NOT A PREFERENCE.

     It was at the bottom first, which is where a caption belongs. Every
     poster this site generates already carries its own plate in the
     bottom-left ("31 SPECTROGRAM / ring fault signature / 3-race
     defect, 1,400 RPM"), so a second plate down there landed directly
     on the generator's typography and both became unreadable. The top
     edge is the band the generator leaves clear.
  */
  .pc-plate {
    display: none;
    position: absolute;
    inset: 0 0 auto 0;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.625rem;
    background-image: linear-gradient(
      to bottom,
      color-mix(in oklab, var(--color-ground) 88%, transparent),
      transparent
    );
    font-family: var(--font-mono);
    font-size: var(--text-label);
    line-height: var(--text-label--line-height);
    letter-spacing: var(--text-label--letter-spacing);
    text-transform: uppercase;
  }
  .pc-plate-state,
  .pc-plate-label {
    color: var(--color-ink-3);
  }
  .pc-plate-value {
    font-size: var(--text-label);
    color: var(--color-ink);
  }

  .stage[data-variant="v2"] .pc-plate {
    display: flex;
  }
  .stage[data-variant="v2"] .pc-desc,
  .stage[data-variant="v2"] .pc-metric {
    display: none;
  }

  /* ============================================================
     V3: SPEC. No artifact, four fields.

     Answers "is the number believable" without a click, and puts a
     missing baseline on the same line as a present one. Costs the
     poster, which is the strongest asset the card has.
     ============================================================ */
  .stage[data-variant="v3"] .pc-frame {
    display: none;
  }
  .stage[data-variant="v3"] .pc-spec {
    display: grid;
  }
  .stage[data-variant="v3"] .pc-desc {
    display: none;
  }

  /* ============================================================
     V4: SPLIT. Artifact left, everything else right.

     Answers "what do six of these look like in a list" at roughly half
     the vertical cost. Costs the poster's size, and the title now has
     about 60% of the width to balance in.
     ============================================================ */
  .stage[data-variant="v4"] .pc {
    display: grid;
    grid-template-columns: var(--pc-split) 1fr;
    grid-template-areas:
      "frame body"
      "frame foot";
    grid-template-rows: 1fr auto;
  }
  .stage[data-variant="v4"] .pc-frame {
    grid-area: frame;
    aspect-ratio: auto;
    height: 100%;
    min-height: 8rem;
  }
  .stage[data-variant="v4"] .pc-body {
    grid-area: body;
  }
  .stage[data-variant="v4"] .pc-foot {
    grid-area: foot;
  }
  .stage[data-variant="v4"] .pc-action:first-child {
    border-bottom-left-radius: 0;
  }

  /* ============================================================
     V5: QUIET. No inner frame, no footer chrome.

     Answers "does the artifact hold the card on its own". The poster
     runs to the card edge and the actions become plain links, so the
     only drawn line left is the card's own. Costs the footer's
     affordance: two links in a row read as less clickable than two
     divided cells, and that is the thing to judge here.
     ============================================================ */
  .stage[data-variant="v5"] .pc {
    padding: 0;
    overflow: hidden;
  }
  .stage[data-variant="v5"] .pc-frame {
    border-radius: 0;
  }
  .stage[data-variant="v5"] .pc-body {
    padding: calc(var(--pc-body-y) + 4px) calc(var(--pc-body-x) + 8px);
  }
  .stage[data-variant="v5"] .pc-foot {
    display: flex;
    gap: 1.25rem;
    border-top-style: none;
    padding: 0 calc(var(--pc-body-x) + 8px) calc(var(--pc-body-y) + 4px);
  }
  .stage[data-variant="v5"] .pc-foot > * + * {
    border-left-style: none;
  }
  .stage[data-variant="v5"] .pc-action {
    justify-content: flex-start;
    min-height: var(--pc-foot-h);
    padding-inline: 0;
    color: var(--color-ink);
  }

  /* ============================================================
     Bounds. Every box outlined in one hairline, off by default.

     This is the control that makes the spacing dials answerable: a
     padding change of 2px is invisible on a flat card and obvious
     against an outlined one.
     ============================================================ */
  /*
     The frame's own outline goes on a pseudo-element, not on `outline`.

     It was on `outline` and it did not show. The poster is absolutely
     positioned at inset:0 inside the frame, and an abs-positioned child
     paints above its parent's outline and above an inset box-shadow, so
     both were sitting under the image. A ::after box at inset:0 paints
     with the children and wins. Both diagnostics route through it.
  */
  .pc-frame::after {
    content: "";
    position: absolute;
    inset: 0;
    border: 1px solid transparent;
    border-radius: inherit;
    pointer-events: none;
    transition: border-color var(--duration-moderate) var(--ease-out);
  }
  .stage[data-bounds="on"] .pc-frame::after {
    border-color: color-mix(in oklab, var(--color-note) 60%, transparent);
  }
  .stage[data-dragging="on"] .pc-frame::after {
    border-color: color-mix(in oklab, var(--color-note) 45%, transparent);
  }

  .stage[data-bounds="on"] .pc-body,
  .stage[data-bounds="on"] .pc-head,
  .stage[data-bounds="on"] .pc-foot,
  .stage[data-bounds="on"] .pc-action,
  .stage[data-bounds="on"] .pc-title,
  .stage[data-bounds="on"] .pc-date,
  .stage[data-bounds="on"] .pc-desc {
    outline: 1px solid color-mix(in oklab, var(--color-note) 60%, transparent);
    outline-offset: -1px;
  }

  /* ============================================================
     Hover and focus. Identical on both paths, or the keyboard route
     is a different and worse card.
     ============================================================ */
  @media (hover: hover) and (pointer: fine) {
    .pc:hover {
      border-color: var(--color-ink-4);
    }
    .stage[data-hoverzoom="on"] .pc:hover .pc-img {
      transform: scale(var(--pc-hover));
    }
    a.pc-action:hover {
      color: var(--color-ink);
      background-color: var(--color-sunken);
    }

    /* The glyph leads by 2px on hover. It is the smallest possible
       statement that the label goes somewhere, and it costs no layout
       because the flex row is centred. */
    a.pc-action:hover .pc-icon {
      transform: translateX(2px);
    }

    /* The plate lifts onto the artifact rather than sitting on it. 4px
       and a fade, so V2 reads as a caption arriving. */
    .pc:hover .pc-plate {
      transform: translateY(0);
      opacity: 1;
    }
  }
  .pc:focus-within {
    border-color: var(--color-ink-4);
  }
  .stage[data-hoverzoom="on"] .pc:focus-within .pc-img {
    transform: scale(var(--pc-hover));
  }

  /* ------------------------------------------------------------
     The underline draws from the left on the footer actions.

     A hairline that grows is doing the same job as a text-decoration
     and costs one composited property, so it animates on the GPU and
     never reflows the 44px row. transform-origin is the whole idea:
     from the centre it reads as a highlight, from the left it reads as
     a link being written.
     ------------------------------------------------------------ */
  .pc-action > span:first-child {
    position: relative;
  }
  .pc-action > span:first-child::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 1px;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--duration-fast) var(--ease-out);
  }
  a.pc-action:hover > span:first-child::after,
  a.pc-action:focus-visible > span:first-child::after {
    transform: scaleX(1);
  }

  .pc-icon {
    transition: transform var(--motion-hover);
  }

  .pc-plate {
    /* Resting state for the hover settle above. 3px and a tenth of
       opacity: legible without hover, because a caption you have to
       find is not a caption, and it still has somewhere to arrive. */
    transform: translateY(-3px);
    opacity: 0.9;
    transition:
      transform var(--motion-disclose),
      opacity var(--motion-disclose);
  }

  /* ------------------------------------------------------------
     ENTER, AND RE-ENTER ON VARIATION CHANGE.

     Four parts, 60ms apart, in reading order. The stagger is short
     enough to read as one card arriving rather than as four things
     animating, which is the line this kind of motion has to stay on.

     The same animation replays when the variation changes. Without it,
     V1 to V4 is a jump cut and the eye has to re-find the title; with
     it the card re-enters and the layout change is legible.
     ------------------------------------------------------------ */
  @keyframes pc-enter {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .pc-frame,
  .pc-head,
  .pc-desc,
  .pc-spec,
  .pc-chips,
  .pc-foot {
    /* moderate, not slow: at 450ms plus the stagger the replay was
       630ms, and clicking through five variations in a row felt like
       waiting for the page rather than reading the card. */
    animation: pc-enter var(--duration-moderate) var(--ease-out) both;
    animation-delay: calc(var(--enter-i, 0) * 50ms);
  }
  .pc-frame {
    --enter-i: 0;
  }
  .pc-head {
    --enter-i: 1;
  }
  .pc-desc,
  .pc-spec {
    --enter-i: 2;
  }
  .pc-chips,
  .pc-foot {
    --enter-i: 3;
  }
  /* The replay: JS strips this class, forces a reflow, puts it back. */
  .stage[data-enter="off"] .pc-frame,
  .stage[data-enter="off"] .pc-head,
  .stage[data-enter="off"] .pc-desc,
  .stage[data-enter="off"] .pc-spec,
  .stage[data-enter="off"] .pc-chips,
  .stage[data-enter="off"] .pc-foot {
    animation: none;
  }

  /* ------------------------------------------------------------
     THE ONE DECORATIVE PULSE, AND IT CARRIES MEANING.

     Only the live dot breathes. A deployed system is the single thing
     on this card that is actually running right now, so it is the only
     thing with any reason to move on its own. Caution and archived
     stay still, which is what makes the live one mean something.

     A ring on ::after, not opacity on the dot: a blinking dot reads as
     a fault indicator. A ring expanding out of it reads as a heartbeat.
     ------------------------------------------------------------ */
  @keyframes pc-pulse {
    0% {
      transform: scale(1);
      opacity: 0.5;
    }
    70%,
    100% {
      transform: scale(3.2);
      opacity: 0;
    }
  }
  .pc-dot {
    position: relative;
  }
  .pc-dot.is-live::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background-color: var(--color-live);
    animation: pc-pulse 2.6s var(--ease-out) infinite;
  }

  /* ------------------------------------------------------------
     Dragging a spacing dial outlines the boxes it moves.

     This is the interaction that makes the panel answerable. A 2px
     padding change is invisible on a flat card and obvious against an
     outlined one, so the outlines come up while a slider is held and
     fade out half a second after it is let go. It is the "Outline every
     box" switch, granted for the length of a drag.
     ------------------------------------------------------------ */
  .pc-body,
  .pc-head,
  .pc-foot,
  .pc-desc {
    outline: 1px solid transparent;
    outline-offset: -1px;
    transition: outline-color var(--duration-moderate) var(--ease-out);
  }
  .stage[data-dragging="on"] .pc-body,
  .stage[data-dragging="on"] .pc-head,
  .stage[data-dragging="on"] .pc-foot,
  .stage[data-dragging="on"] .pc-desc {
    outline-color: color-mix(in oklab, var(--color-note) 45%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .pc-img,
    .pc-action,
    .pc-icon,
    .pc-plate,
    .pc {
      transition: none;
    }
    .pc:hover .pc-img,
    .pc:focus-within .pc-img {
      transform: none;
    }
    .pc-plate {
      transform: none;
      opacity: 1;
    }
    /* The enter stagger, the pulse and the underline draw are all
       decoration. Reduced motion gets the card, in place, at once. */
    .pc-frame,
    .pc-head,
    .pc-desc,
    .pc-spec,
    .pc-chips,
    .pc-foot,
    .pc-dot.is-live::after {
      animation: none;
    }
    .pc-action > span:first-child::after,
    .pc-frame::after {
      transition: none;
    }
  }
