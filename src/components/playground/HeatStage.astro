---
/**
 * The contribution grid lab stage.
 *
 * V1 IS WHAT SHIPS, MEASURED. Every default below was read off the
 * rendered home page rather than guessed:
 *
 *   cell     11px, 3px gap, 2px radius, 7 rows, 52 columns
 *   grid     725px intrinsic (52 x 11 + 51 x 3), scrolls on its axis
 *   ramp     ink 7% for empty, then live at 26 / 50 / 74 / 100%
 *   caption  12px above, Fig. N + total + range + source, Less/More
 *   appear   260ms per cell, 8ms of delay per column, from scale 0.4
 *   hover    cell to 1.65 with a hairline outline, field to
 *            saturate(0.35) opacity(0.45)
 *
 * THE YEAR COMES FROM lib/heat.ts, the same module the shipped figure
 * reads, so the lab cannot drift from the thing it exists to judge.
 *
 * THE APPEAR ANIMATION IS THE SUBJECT HERE, NOT DECORATION. On the home
 * page the wipe is gated on `.js .reveal[data-seen]`, set by the site's
 * IntersectionObserver, because 364 concurrent animations below the
 * fold competed with the loader for the first frames. A lab has no
 * fold and no loader, so it runs the wipe off the stage's own
 * [data-enter] instead, which is the attribute DialKit already strips
 * and restores. That makes Replay and every variation switch re-run it.
 */
import { buildHeat, heatLevels, heatTitle } from "../../lib/heat";

const RANGE = "01.09.2025 - 27.08.2026";
const TOTAL = 1284;

/*
 * 78 weeks generated, 52 shown by default. The Span control reveals or
 * hides columns rather than regenerating, so changing it cannot
 * reshuffle the year: week 12 is the same week at every setting, which
 * is the only way "is 26 weeks enough" is answerable by looking.
 *
 * THREE BUILDS, NOT ONE, AND THAT IS THE POINT. The derived facts in V3
 * are read off the cells, and a stat computed over 78 weeks while 52
 * are on screen is a number that disagrees with the picture: the first
 * pass showed "Current 0 days" because the trailing day of week 78 is
 * empty and 26 weeks off the right edge. Because the generator is
 * seeded and its loop is sequential, the first 26 weeks of a 78-week
 * build are identical to a 26-week build, so three calls give three
 * consistent slices of one year and the visible span always gets its
 * own numbers.
 */
const spans = [26, 52, 78] as const;
const years = { 26: buildHeat(RANGE, 26), 52: buildHeat(RANGE, 52), 78: buildHeat(RANGE, 78) };
const year = years[78];
const cells = year.cells;
const weeks = year.weeks;
const levels = heatLevels;

/*
 * Bars are scaled to the 52-week peak at every span, deliberately. A
 * chart whose axis rescales when you change the window makes two
 * windows incomparable, which is the opposite of what the span control
 * is for.
 */
const barPeak = years[52].peakWeek;

/* Month boundaries for V2's top labels: the first week whose Monday
   lands in each month, so a label sits over the column it names. */
const [d0, m0, y0] = RANGE.split(" ")[0].split(".").map(Number);
const START = Date.UTC(y0, m0 - 1, d0);
const monthFmt = new Intl.DateTimeFormat("en-GB", {
  month: "short",
  timeZone: "UTC",
});
const monthMarks: { week: number; label: string }[] = [];
let lastMonth = -1;
for (let w = 0; w < weeks.length; w++) {
  const d = new Date(START + w * 7 * 86_400_000);
  const m = d.getUTCMonth();
  if (m !== lastMonth) {
    monthMarks.push({ week: w, label: monthFmt.format(d) });
    lastMonth = m;
  }
}

/* Sunday first, matching the grid's first row. Single letters, because
   three-letter days at 12px mono are wider than an 11px cell. */
const dayLabels = ["S", "M", "T", "W", "T", "F", "S"];

/* V3's stat row, one set per span. Every figure is read off the same
   cells the grid paints, so the numbers cannot disagree with the
   shades on screen. */
const statsFor = (y: (typeof years)[52]): [string, string][] => [
  ["Current", `${y.currentStreak} days`],
  ["Longest", `${y.longestStreak} days`],
  ["Active", `${Math.round((y.activeDays / y.totalDays) * 100)}%`],
  ["Busiest", `${y.busiestDay.count} on ${y.busiestDay.when.replace(/^\w+, /, "")}`],
];
---

<div
  class="stage"
  id="stage"
  data-variant="v1"
  data-weeks="52"
  data-hue="live"
  data-caption="on"
  data-legend="on"
  data-months="off"
  data-days="off"
  data-dim="on"
  data-outline="on"
  data-cross="on"
  data-readout="on"
  data-direction="ltr"
  data-bounds="off"
  data-grid="off"
  data-backdrop="ground"
>
  <div class="stage-scroll">
    <figure class="hm" data-heat-figure>
      {/* V3 only. What the grid shows but does not state, one set per
          span so the numbers always describe the visible columns. */}
      {
        spans.map((s) => (
          <div class="hm-stats" data-span={s}>
            {statsFor(years[s]).map(([k, v], i) => (
              <div class="hm-stat" style={`--s:${i}`}>
                <dt class="hm-stat-key">{k}</dt>
                <dd class="numeric hm-stat-val">{v}</dd>
              </div>
            ))}
          </div>
        ))
      }

      {/*
        The grid scrolls on its own axis rather than shrinking the
        cells: below ~700px a 52-week grid either becomes unreadable
        2px squares or forces the page to scroll sideways, and both are
        worse than an internally scrolling figure.
      */}
      <div class="hm-scroll">
        <div class="hm-rail">
          {/* V2 only. A label per month, positioned by column index so
              it sits over the week it names. */}
          <div class="hm-months">
            {
              monthMarks.map((m) => (
                <span class="hm-month" style={`--w:${m.week}`} data-w={m.week}>
                  {m.label}
                </span>
              ))
            }
          </div>

          <div class="hm-body">
            <div class="hm-days" aria-hidden="true">
              {dayLabels.map((d, i) => <span class="hm-day" style={`--d:${i}`}>{d}</span>)}
            </div>

            <div
              class="heat hm-grid"
              role="img"
              aria-label={`${TOTAL} contributions between ${RANGE}`}
            >
              {
                cells.map((c) => (
                  <span
                    class:list={["heat-cell", levels[c.level]]}
                    style={`--w:${c.week};--d:${c.day};--lv:${c.level}`}
                    data-w={c.week}
                    data-d={c.day}
                    data-lv={c.level}
                    title={heatTitle(c)}
                  />
                ))
              }
            </div>

            {/*
              V5 only. One bar per week, height scaled to the busiest
              week. Same records, one dimension instead of two.
            */}
            <div class="hm-bars" role="img" aria-label="Contributions per week">
              {
                weeks.map((w) => (
                  <span
                    class="hm-bar"
                    style={`--w:${w.week};--h:${Math.max(0.02, w.total / barPeak)}`}
                    data-w={w.week}
                    title={`${w.total} contributions in week ${w.week + 1}`}
                  />
                ))
              }
            </div>
          </div>
        </div>
      </div>

      <figcaption class="hm-cap">
        {/*
          Two sentences in one grid cell, stacked. The figure caption
          and the live readout occupy the same box, so swapping between
          them cannot move the legend or change the figure's height; the
          crossfade is the only thing that happens. The readout is
          aria-hidden because the cell's own title already carries the
          same text for assistive tech, and announcing every hovered day
          would be noise.
        */}
        <div class="hm-cap-stack">
          <p class="hm-cap-text">
            <span class="label">Fig. 1.</span>{" "}
            <span class="numeric hm-total">{TOTAL.toLocaleString("en-US")}</span>{" "}
            contributions, <span class="numeric">{RANGE}</span>. Source:{" "}
            <a href="https://github.com/" class="link-ref" rel="noopener">GitHub</a>.
          </p>
          <p class="hm-cap-live" aria-hidden="true">
            <span class="label">Fig. 1.</span>{" "}
            <span class="numeric hm-live-n" data-heat-n>0</span>{" "}
            <span data-heat-unit>contributions</span> on{" "}
            <span class="numeric hm-live-when" data-heat-when>{RANGE}</span>.
          </p>
        </div>

        {/*
          The legend is also a filter. Hovering a swatch isolates every
          cell at that level, which is the one question a ramp raises
          and cannot answer by itself: which days are a 3.
        */}
        <p class="hm-legend" data-heat-legend>
          <span class="hm-legend-word">Less</span>
          {
            [0, 1, 2, 3, 4].map((l) => (
              <span
                class:list={["hm-key heat-key", levels[l]]}
                style={`--s:${l}`}
                data-key={l}
                tabindex="0"
                role="button"
                aria-label={`Highlight level ${l} days`}
              />
            ))
          }
          <span class="hm-legend-word">More</span>
        </p>
      </figcaption>
    </figure>
  </div>
</div>

<style>
  /* ============================================================
     THE CONTRACT.

     Every value the dial can move is declared once here. The dial
     writes the same names onto #stage's inline style, which wins on
     specificity without touching a class, so "Copy CSS" from the panel
     produces a block that drops straight into a component.

     NOTHING HERE DEPENDS ON JS for its resting state. With scripting
     off the grid renders at shipped spec, fully visible; only the
     appear animation needs the stage attribute, and its end state is
     the resting state.
     ============================================================ */
  .stage {
    --hm-cell: 11px;
    --hm-gap: 3px;
    --hm-radius: 2px;

    /* The ramp, as mix percentages against the ground. */
    --hm-l0: 7%;
    --hm-l1: 26%;
    --hm-l2: 50%;
    --hm-l3: 74%;

    --hm-cap-gap: 12px;
    --hm-key: 10px;
    --hm-key-gap: 6px;
    --hm-label: 11px;

    /* Appear. 52 columns x 8ms is 416ms, inside the reveal budget. */
    --hm-in-dur: 260ms;
    --hm-stagger: 8ms;
    --hm-in-scale: 0.4;

    /* Hover. One veil opacity, because the dim is one element now. */
    --hm-hover: 1.65;
    --hm-dim: 0.62;

    --hm-bar-w: 8px;
    --hm-bar-h: 96px;
  }

  .hm {
    /* 52 x 11 + 51 x 3 = 725, plus 4px of gutter each side so a
       hover-scaled edge cell is not clipped by the scroll container. */
    max-width: 100%;
  }

  .hm-scroll {
    margin-inline: -4px;
    padding-bottom: 4px;
    overflow-x: auto;
  }
  .hm-rail {
    padding-inline: 4px;
    width: max-content;
  }

  .hm-body {
    display: flex;
    align-items: start;
    gap: var(--hm-gap);
  }

  .hm-grid {
    /* Positioned so the veil (::after) can cover it. */
    position: relative;
    display: grid;
    grid-auto-flow: column;
    grid-template-rows: repeat(7, var(--hm-cell));
    grid-auto-columns: var(--hm-cell);
    gap: var(--hm-gap);
  }
  /*
     position and z-index are STATIC. The first version toggled
     `position: relative; z-index: 1` on :hover, which creates and
     destroys a stacking context every time the pointer crosses a cell
     edge and forced layout each time (measured 100ms over a 100-move
     sweep, 0ms once static). Same for the outline: declared transparent
     here so only its colour changes on hover, which is paint, not
     layout. border-radius no longer changes on hover for the same
     reason.
  */
  .heat-cell {
    position: relative;
    z-index: 0;
    width: var(--hm-cell);
    height: var(--hm-cell);
    border-radius: var(--hm-radius);
    outline: 1px solid transparent;
    outline-offset: 1px;
  }

  /*
     The span is a reveal, not a regenerate. Columns past the setting
     are hidden, so week 12 is the same week at 26, 52 and 78 and the
     question "is half a year enough" is answerable by looking.
  */
  .stage[data-weeks="26"] .heat-cell:nth-child(n + 183),
  .stage[data-weeks="26"] .hm-bar:nth-child(n + 27),
  .stage[data-weeks="26"] .hm-month:nth-child(n + 8),
  .stage[data-weeks="52"] .heat-cell:nth-child(n + 365),
  .stage[data-weeks="52"] .hm-bar:nth-child(n + 53),
  .stage[data-weeks="52"] .hm-month:nth-child(n + 14) {
    display: none;
  }

  /* ============================================================
     THE RAMP.

     Mixed from a token rather than hardcoded, for three reasons: the
     ramp inherits the token's AA-corrected hue, one formula covers both
     themes because --color-ground flips with them, and a palette change
     moves the grid with it instead of stranding a literal green here.

     Mixing toward --color-ground (opaque) rather than transparent so a
     cell never picks up whatever it happens to sit over.

     --hm-ink is the hue source and it is a whole argument, which is why
     it is a control. The grid was monochrome once, on the grounds that
     this design reserves chroma for state and for the artifact posters
     and that 364 cells of signal green would be the loudest object on
     the page. It shipped green on the grounds that a page with no
     chroma anywhere reads unfinished rather than disciplined. Both
     positions are now one click apart.
     ============================================================ */
  .stage {
    --hm-ink: var(--color-live);
  }
  .stage[data-hue="ink"] {
    --hm-ink: var(--color-ink);
  }
  .stage[data-hue="note"] {
    --hm-ink: var(--color-note);
  }

  .heat-l0 {
    background-color: color-mix(
      in oklab,
      var(--color-ink) var(--hm-l0),
      var(--color-ground)
    );
  }
  .heat-l1 {
    background-color: color-mix(
      in oklab,
      var(--hm-ink) var(--hm-l1),
      var(--color-ground)
    );
  }
  .heat-l2 {
    background-color: color-mix(
      in oklab,
      var(--hm-ink) var(--hm-l2),
      var(--color-ground)
    );
  }
  .heat-l3 {
    background-color: color-mix(
      in oklab,
      var(--hm-ink) var(--hm-l3),
      var(--color-ground)
    );
  }
  .heat-l4 {
    background-color: var(--hm-ink);
  }

  /* ============================================================
     Month and weekday labels. Off in V1, on in V2.
     ============================================================ */
  .hm-months {
    display: none;
    position: relative;
    height: calc(var(--hm-label) + 6px);
    /* Offset by the weekday gutter so a label lands over its column. */
    margin-left: calc(var(--hm-daycol) + var(--hm-gap));
  }
  .hm-month {
    position: absolute;
    top: 0;
    /* Column origin: each week is one cell plus one gap wide. */
    left: calc(var(--w) * (var(--hm-cell) + var(--hm-gap)));
    font-family: var(--font-mono);
    font-size: var(--hm-label);
    line-height: 1.2;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-ink-3);
    white-space: nowrap;
  }
  .stage[data-months="on"] .hm-months {
    display: block;
  }

  .stage {
    --hm-daycol: 0px;
  }
  .hm-days {
    display: none;
    grid-template-rows: repeat(7, var(--hm-cell));
    gap: var(--hm-gap);
    width: var(--hm-daycol);
  }
  .hm-day {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    height: var(--hm-cell);
    font-family: var(--font-mono);
    font-size: var(--hm-label);
    line-height: 1;
    color: var(--color-ink-4);
  }
  /*
     MON, WED, FRI. Three of the seven, and specifically those three.

     All seven at 11px mono in an 11px row is a wall of S M T W T F S
     that reads as noise. The first cut kept the even rows, which is
     Sun, Tue, Thu, Sat: two of those are "S" and two are "T", so the
     column labelled four days ambiguously instead of three
     unambiguously. Mon, Wed, Fri is what GitHub labels for exactly
     this reason, and M W F share no initial with anything.

     nth-child is 1-based over seven rows, so hiding the odd positions
     (1, 3, 5, 7) hides indices 0, 2, 4, 6.
  */
  .hm-day:nth-child(odd) {
    visibility: hidden;
  }
  .stage[data-days="on"] {
    --hm-daycol: 14px;
  }
  .stage[data-days="on"] .hm-days {
    display: grid;
  }

  /* ============================================================
     Caption and legend.
     ============================================================ */
  .hm-cap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    margin-top: var(--hm-cap-gap);
  }
  .hm-cap-stack {
    display: grid;
    min-width: 0;
  }
  .hm-cap-stack > * {
    grid-area: 1 / 1;
  }
  .hm-cap-text,
  .hm-cap-live {
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    color: var(--color-ink-2);
    /* 80ms, the acknowledgment window. The readout is a response to the
       pointer, not a story about it, so it must not be seen arriving. */
    transition: opacity var(--duration-instant) var(--ease-swing);
  }
  .hm-cap-live {
    opacity: 0;
    pointer-events: none;
  }
  .hm-live-n {
    color: var(--color-ink);
  }
  /* The readout swaps in while a cell is hovered and the switch is on.
     data-live is written by the script; the figure caption fades under
     it and comes back the moment the pointer leaves the grid. */
  .stage[data-readout="on"] .hm[data-live="on"] .hm-cap-text {
    opacity: 0;
  }
  .stage[data-readout="on"] .hm[data-live="on"] .hm-cap-live {
    opacity: 1;
  }
  .stage[data-caption="off"] .hm-cap-stack {
    display: none;
  }

  .hm-legend {
    display: flex;
    align-items: center;
    gap: var(--hm-key-gap);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--text-label--letter-spacing);
    color: var(--color-ink-3);
  }
  .stage[data-legend="off"] .hm-legend {
    display: none;
  }
  .hm-key {
    width: var(--hm-key);
    height: var(--hm-key);
    border-radius: var(--hm-radius);
    cursor: pointer;
  }

  /* ============================================================
     THE HOVER. Two things happen, and the second is what makes it
     read as an instrument rather than a grid of divs.

       1. The hovered cell grows, on transform only, so it composites
          and never reflows its 363 neighbours.
       2. Every OTHER cell falls back. Isolating one cell by dimming the
          rest reads far more clearly than brightening the target,
          because the target is 11px and the field is 725px wide.

     Pointer-only. On touch there is no hover state to leave, so the
     grid would latch dimmed after a tap.
     ============================================================ */
  /*
     --duration-instant and --ease-swing, not --motion-hover.

     This is the highest-frequency motion on the site: one pass across
     the grid fires it a few hundred times. The perceptual thresholds
     put acknowledgment under 100ms and Atlassian's rule for anything
     triggered dozens of times a day is under 150ms; 150ms with a
     long-tailed ease-out sat at the ceiling of one and outside the
     other, and read as lag. Swing puts velocity at its maximum on frame
     one, so the cell is already growing when the pointer lands.

     Only transform and outline-color transition. Nothing here has
     will-change: it promoted 364 cells to permanent compositor layers
     for a transform only one of them runs at a time, and measured no
     benefit.
  */
  .heat-cell {
    transition:
      transform var(--duration-instant) var(--ease-swing),
      outline-color var(--duration-instant) var(--ease-swing);
  }
  .hm-key,
  .hm-bar {
    transition:
      transform var(--duration-instant) var(--ease-swing),
      filter var(--duration-instant) var(--ease-swing);
  }

  /* ============================================================
     THE VEIL. One element dims the field.

     The first version dimmed 363 cells by transitioning `filter:
     saturate() opacity()` on each of them, and the legend isolate
     added ten `:has()` rules anchored on the whole figure, each
     re-matching `:not([data-lv=n])` against every cell on every pointer
     move. Measured against the shipped figure on the same 364 cells:
     73.55ms of style recalculation per pointer move against 2.01ms.
     Thirty-six times, and 100ms of layout against 4.7.

     Now: the grid's ::after is a ground-coloured veil at opacity 0.
     Hovering raises it to --hm-dim and lifts the hovered cell above it
     with z-index. One opacity transition on one element. The hovered
     cell, its crosshair, and the isolated level are all just cells
     with a higher z-index than the veil, which is a paint-order change
     and never a layout.

     The tone is different from the old dim and better: a veil recedes
     the field, desaturation greyed it, and a greyed green reads as an
     error state.
     ============================================================ */
  .heat::after {
    content: "";
    position: absolute;
    inset: -4px;
    z-index: 1;
    border-radius: var(--hm-radius);
    background-color: var(--color-ground);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duration-instant) var(--ease-swing);
  }

  /* Raised above the veil: the hovered cell, its row and column (the
     crosshair), and whichever level the legend is isolating. Three
     tiers so the read is unambiguous: 3 is the target, 2 is context. */
  .heat .heat-cell.is-x {
    z-index: 2;
  }
  /* After .is-x in source on purpose. The hovered cell is in its own
     row and column so it carries .is-x too, and the two selectors tie
     on specificity (0,3,0); source order is what puts it on top. */
  .heat .heat-cell:hover {
    z-index: 3;
    transform: scale(var(--hm-hover));
  }

  @media (hover: hover) and (pointer: fine) {
    /* :has() with a child combinator: it only has to look one level
       down, and it is the one :has() left in the hot path. */
    .stage[data-dim="on"] .heat:has(> .heat-cell:hover)::after {
      opacity: var(--hm-dim);
    }
    .stage[data-outline="on"] .heat .heat-cell:hover {
      /* The outline rides the transform, so it stays a hairline at any
         scale instead of thickening with the cell. */
      outline-color: var(--color-ink);
    }
    .hm-key:hover {
      transform: scale(1.4);
    }
    .hm-bar:hover {
      filter: brightness(1.25);
    }
  }

  /* ============================================================
     THE LEGEND IS ALSO A FILTER, DRIVEN BY ONE ATTRIBUTE.

     Hovering or focusing a swatch isolates every cell at that level.
     It answers the one question a ramp raises and cannot answer by
     itself, which is "which days are a 3".

     A five-line script sets data-iso on the figure from a listener on
     the five swatches, and these rules match on that. The attribute
     changes when a swatch is entered or left, which is a handful of
     times per session. The :has() version changed nothing and cost
     3,600 selector evaluations per pointer move. Pointer, keyboard and
     touch all come through the same attribute, so parity is free.
     ============================================================ */
  .stage[data-dim="on"] .hm[data-iso] .heat::after {
    opacity: var(--hm-dim);
  }
  .hm[data-iso="0"] .heat-cell[data-lv="0"],
  .hm[data-iso="1"] .heat-cell[data-lv="1"],
  .hm[data-iso="2"] .heat-cell[data-lv="2"],
  .hm[data-iso="3"] .heat-cell[data-lv="3"],
  .hm[data-iso="4"] .heat-cell[data-lv="4"] {
    z-index: 2;
  }
  .hm[data-iso] .hm-key {
    opacity: 0.45;
  }
  .hm[data-iso="0"] .hm-key[data-key="0"],
  .hm[data-iso="1"] .hm-key[data-key="1"],
  .hm[data-iso="2"] .hm-key[data-key="2"],
  .hm[data-iso="3"] .hm-key[data-key="3"],
  .hm[data-iso="4"] .hm-key[data-key="4"] {
    opacity: 1;
    transform: scale(1.4);
  }

  .stage[data-cross="off"] .heat .heat-cell.is-x {
    z-index: 0;
  }

  /* ============================================================
     THE APPEAR, WHICH IS THE SUBJECT OF THIS LAB.

     A column-by-column wipe: the delay comes off the week index, so the
     year fills like a timeline rather than all at once. The direction
     control changes which index drives the delay, and that is the whole
     mechanism:

       ltr    the week, left to right, as shipped
       rtl    the week counted from the far end, so it fills toward now
       days   the DAY index, so it wipes top to bottom across all
              52 weeks at once and reads as a scan rather than a fill

     Driven by the stage's [data-enter], which DialKit strips and
     restores. That is what makes Replay and every variation switch
     re-run it, and it is why this does not use the site's `.js .reveal
     [data-seen]` gate: there is no fold here to wait for.
     ============================================================ */
  @keyframes heat-in {
    from {
      opacity: 0;
      transform: scale(var(--hm-in-scale));
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /*
     BACKWARDS, NOT BOTH, AND THIS IS THE BUG THE LAB FOUND.

     Every enter animation here was `both`. A forwards fill keeps the
     keyframe's end values applied after the animation finishes, and
     animations sit above every normal declaration in the cascade. So
     `transform: none` and `opacity: 1` from the last keyframe were held
     forever, and the hover's `transform: scale()`, the legend's
     `opacity: 0.45`, the caption's `opacity: 0` crossfade all silently
     lost. The hovered cell measured at matrix(1,0,0,1,0,0) with the
     hover rule matching. The shipped figure has the same fill and its
     hover scale has never fired after the reveal.

     `backwards` applies the `from` state during the delay, which is
     what hides a column until its turn, then releases. The natural
     state already IS the end state, so nothing needs holding.
  */
  .heat-cell {
    animation: heat-in var(--hm-in-dur) var(--ease-out) backwards;
    animation-delay: calc(var(--w) * var(--hm-stagger));
  }
  .stage[data-direction="rtl"] .heat-cell {
    animation-delay: calc((77 - var(--w)) * var(--hm-stagger));
  }
  .stage[data-direction="days"] .heat-cell {
    /* Seven rows rather than 52 columns, so the same per-step delay
       would finish in 56ms. Multiplied up to keep the total legible. */
    animation-delay: calc(var(--d) * var(--hm-stagger) * 7);
  }

  /* The legend fills in after the grid, left to right, so the ramp
     reads as the key to what just happened rather than as five squares
     that were always there. */
  .hm-key {
    animation: heat-in var(--hm-in-dur) var(--ease-out) backwards;
    animation-delay: calc(420ms + var(--s) * 40ms);
  }

  @keyframes hm-rise {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .hm-cap-text,
  .hm-month,
  .hm-day {
    animation: hm-rise var(--duration-moderate) var(--ease-out) backwards;
    animation-delay: 460ms;
  }
  /* Month labels arrive with the column they sit over. */
  .hm-month {
    animation-delay: calc(var(--w) * var(--hm-stagger));
  }

  /* V5's bars grow from the baseline on the same per-week clock, so
     switching to it reads as the same year told differently rather
     than as a different figure. */
  @keyframes hm-grow {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }
  .hm-bar {
    animation: hm-grow var(--hm-in-dur) var(--ease-out) backwards;
    animation-delay: calc(var(--w) * var(--hm-stagger));
  }

  .hm-stat {
    animation: hm-rise var(--duration-moderate) var(--ease-out) backwards;
    animation-delay: calc(var(--s) * 60ms);
  }

  /* The replay: DialKit strips this, forces a reflow, puts it back. */
  .stage[data-enter="off"] .heat-cell,
  .stage[data-enter="off"] .hm-key,
  .stage[data-enter="off"] .hm-cap-text,
  .stage[data-enter="off"] .hm-month,
  .stage[data-enter="off"] .hm-day,
  .stage[data-enter="off"] .hm-bar,
  .stage[data-enter="off"] .hm-stat {
    animation: none;
  }

  /* ============================================================
     V2: LABELLED. Months across, weekdays down.

     Answers "when exactly" without counting columns: a sprint can be
     located in calendar time. Costs about 17px of height and 14px of
     width, and it adds 20 text elements to a figure whose austerity is
     part of why it reads as evidence rather than as a widget.
     ============================================================ */
  .stage[data-variant="v2"] {
    --hm-daycol: 14px;
  }
  .stage[data-variant="v2"] .hm-months {
    display: block;
  }
  .stage[data-variant="v2"] .hm-days {
    display: grid;
  }

  /* ============================================================
     V3: STREAK. The grid plus what it does not say.

     Answers "is this consistent or is it two bursts", which the shades
     show and no caption states. Costs the austerity: four figures above
     a contribution grid is the exact shape of a vanity widget, and the
     defence is that every number is read off the same cells rather than
     supplied by an API nobody can check.
     ============================================================ */
  .hm-stats {
    display: none;
    flex-wrap: wrap;
    gap: 4px 24px;
    margin-bottom: 14px;
  }
  .hm-stat-key {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--text-label--letter-spacing);
    text-transform: uppercase;
    color: var(--color-ink-3);
  }
  .hm-stat-val {
    margin-top: 2px;
    font-size: var(--text-body);
    line-height: 1.3;
    color: var(--color-ink);
  }
  .stage[data-variant="v3"][data-weeks="26"] .hm-stats[data-span="26"],
  .stage[data-variant="v3"][data-weeks="52"] .hm-stats[data-span="52"],
  .stage[data-variant="v3"][data-weeks="78"] .hm-stats[data-span="78"] {
    display: flex;
  }

  /* ============================================================
     V4: DENSE. Half the width, no legend.

     Answers "can this sit beside something else" rather than owning a
     band of its own: at 7px cells the year is 468px and fits a sidebar
     or a two-column row. Costs a single day's shade, which at 7px is
     hard to place on the ramp by eye, so the grid stops being readable
     per-day and becomes a texture that shows shape only.
     ============================================================ */
  .stage[data-variant="v4"] {
    --hm-cell: 7px;
    --hm-gap: 2px;
    --hm-radius: 1px;
    --hm-hover: 2.2;
  }
  .stage[data-variant="v4"] .hm-legend {
    display: none;
  }

  /* ============================================================
     V5: BARS. The same year in one dimension.

     Answers "what was the shape of the year" immediately, which 364
     shades only imply: the two sprints and the two exam troughs are
     unmistakable. Costs day-level resolution entirely, and it costs the
     GitHub-native form that makes the grid legible without a caption.
     ============================================================ */
  .hm-bars {
    display: none;
    align-items: flex-end;
    gap: var(--hm-gap);
    height: var(--hm-bar-h);
  }
  .hm-bar {
    width: var(--hm-bar-w);
    height: calc(var(--h) * 100%);
    min-height: 2px;
    border-radius: var(--hm-radius);
    background-color: var(--hm-ink);
    transform-origin: bottom center;
  }
  .stage[data-variant="v5"] .hm-bars {
    display: flex;
  }
  .stage[data-variant="v5"] .hm-grid,
  .stage[data-variant="v5"] .hm-days,
  .stage[data-variant="v5"] .hm-legend {
    display: none;
  }

  /* ============================================================
     Bounds and drag outlines, the same diagnostics as the other labs.
     Cells are excluded on purpose: 364 outlines is not a diagnostic,
     it is a second grid.
     ============================================================ */
  .hm-grid,
  .hm-bars,
  .hm-cap,
  .hm-legend,
  .hm-stats,
  .hm-months {
    outline: 1px solid transparent;
    outline-offset: -1px;
    transition: outline-color var(--duration-moderate) var(--ease-out);
  }
  .stage[data-bounds="on"] .hm-grid,
  .stage[data-bounds="on"] .hm-bars,
  .stage[data-bounds="on"] .hm-cap,
  .stage[data-bounds="on"] .hm-legend,
  .stage[data-bounds="on"] .hm-stats,
  .stage[data-bounds="on"] .hm-months,
  .stage[data-dragging="on"] .hm-grid,
  .stage[data-dragging="on"] .hm-bars,
  .stage[data-dragging="on"] .hm-cap,
  .stage[data-dragging="on"] .hm-legend,
  .stage[data-dragging="on"] .hm-stats,
  .stage[data-dragging="on"] .hm-months {
    outline-color: color-mix(in oklab, var(--color-note) 45%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .heat-cell,
    .hm-key,
    .hm-cap-text,
    .hm-month,
    .hm-day,
    .hm-stat {
      animation: none;
      opacity: 1;
      transform: none;
    }
    /* The bars keep no animation but must keep their height, which is
       a transform-free property, so scaleY simply does not run. */
    .hm-bar {
      animation: none;
      transform: none;
    }
    .heat-cell,
    .hm-key,
    .hm-bar,
    .heat::after,
    .hm-cap-text,
    .hm-cap-live {
      transition: none;
    }
    /* The veil, crosshair and readout are state, not motion: they stay
       and simply arrive instantly. Only the scale is dropped, because a
       cell growing under the pointer is the one part that moves. */
    .heat .heat-cell:hover {
      transform: none;
    }
  }
</style>

{/*
  The interaction layer comes from scripts/heat.ts, the same module the
  shipped figure runs. The lab held its own copy for one pass and that
  is exactly how a lab starts disagreeing with the component it exists
  to judge.

  The lab's own additions are the three switches, which gate the CSS
  above by attribute; the script itself is identical on both surfaces.
*/}
<script>
  import { initHeatFigures } from "../../scripts/heat";
  initHeatFigures();
</script>
