---
/**
 * The post row lab's spec. Everything that makes it a panel lives in
 * DialKit.astro; this file is only the list of decisions a writing
 * list item contains.
 *
 * NO RADIUS LOCK HERE, UNLIKE THE CARD LAB. That lab has one because
 * inner = outer minus padding is a real rule for a rectangle nested
 * inside a padded rectangle. A cover sitting in a row is not nested
 * that way: the row has no border and its radius only exists on the
 * hover ground, so the same subtraction derived 0px for every sane row
 * padding. A control that computes a meaningless number is worse than
 * no control, so it is not offered.
 */
import DialKit from "./DialKit.astro";
import {
  canvasGroup,
  num,
  px,
  seg,
  toggle,
  type Group,
  type Variant,
} from "./dial-spec";

const variants: Variant[] = [
  {
    v: "v1",
    index: "V1",
    name: "Row",
    note: "What ships on the home page, measured. 64x44 cover, one-line title, one-line sentence, date over reading time on the right.",
  },
  {
    v: "v2",
    index: "V2",
    name: "Index",
    note: "Date leads at a fixed width, nothing else survives. Six titles fit where two V1 rows do. Costs the sentence and the cover, so a title has to carry the post alone.",
  },
  {
    v: "v3",
    index: "V3",
    name: "Editorial",
    note: "Date as an eyebrow, title at the card step, two lines of sentence. Costs the right-hand rail, so scanning by date or length is gone and rows roughly double in height.",
  },
  {
    v: "v4",
    index: "V4",
    name: "Plate",
    note: "The cover grows to 160x90 and becomes an artifact rather than a texture. Costs half the rows per screen, and it is a bet on the cover generator.",
  },
  {
    v: "v5",
    index: "V5",
    name: "Status",
    note: "Live and draft in one stream with the stage named. /writing splits them today, which can hide the newest thing on the site below the fold. Costs a column of the rail.",
  },
];

const groups: Group[] = [
  canvasGroup(),
  {
    title: "List",
    note: "736 is the shipped width: the 768px column minus two 16px gutters.",
    controls: [
      px("pr-w", "Width", "--pr-w", 736, 320, 1100),
      seg("rows", "Rows", "rows", "3", [
        ["1", "One"],
        ["3", "Three"],
        ["5", "Five"],
      ]),
      px("pr-py", "Block padding", "--pr-py", 12, 0, 40),
      px("pr-gap", "Column gap", "--pr-gap", 12, 0, 40),
      px("pr-rule", "Rule", "--pr-rule", 1, 0, 4),
      seg("rule", "Rule style", "rule", "solid", [
        ["solid", "Solid"],
        ["dashed", "Dashed"],
        ["none", "None"],
      ]),
      px("pr-radius", "Hover radius", "--pr-radius", 0, 0, 16),
      toggle("f-hoverground", "Hover ground", "hoverground", true),
    ],
  },
  {
    title: "Cover",
    note: "64x44 is 1.45, which is neither the 2:1 the covers are generated at nor any ratio elsewhere in the system. Worth a look.",
    controls: [
      toggle("f-thumb", "Cover", "thumb", true),
      px("pr-thumb-w", "Width", "--pr-thumb-w", 64, 0, 240),
      px("pr-thumb-h", "Height", "--pr-thumb-h", 44, 0, 160),
      px("pr-thumb-radius", "Radius", "--pr-thumb-radius", 6, 0, 24),
      seg("fit", "Fit", "fit", "cover", [
        ["cover", "Cover"],
        ["contain", "Contain"],
      ]),
      toggle("f-hoverzoom", "Hover scale", "hoverzoom", true),
      num("pr-hover", "Scale to", "--pr-hover", 1.03, 1, 1.2, 0.005),
    ],
  },
  {
    title: "Title",
    controls: [
      px("pr-title-size", "Size", "--pr-title-size", 16, 12, 32),
      num("pr-title-lead", "Leading", "--pr-title-lead", 1.5, 1, 2, 0.01),
      num("pr-title-track", "Tracking", "--pr-title-track", 0.01, -0.04, 0.04, 0.001),
      num("pr-title-weight", "Weight", "--pr-title-weight", 400, 400, 600, 100),
      seg("titleLines", "Lines", "titleLines", "1", [
        ["1", "One"],
        ["2", "Two"],
        ["3", "Three"],
      ]),
    ],
  },
  {
    title: "Sentence",
    controls: [
      toggle("f-desc", "Sentence", "desc", true),
      px("pr-desc-gap", "Title to sentence", "--pr-desc-gap", 2, 0, 24),
      px("pr-desc-size", "Size", "--pr-desc-size", 16, 11, 24),
      num("pr-desc-lead", "Leading", "--pr-desc-lead", 1.5, 1.1, 2, 0.01),
      num("pr-desc-clamp", "Line clamp", "--pr-desc-clamp", 1, 0, 5, 1, "descClamp"),
    ],
  },
  {
    title: "Rail",
    note: "The right column has to read as one rail down the page, not three independently placed dates. Give it a minimum width and the figures line up.",
    controls: [
      toggle("f-meta", "Rail", "meta", true),
      px("pr-meta-size", "Size", "--pr-meta-size", 12, 9, 18),
      px("pr-meta-gap", "Line gap", "--pr-meta-gap", 0, 0, 16),
      px("pr-meta-w", "Min width", "--pr-meta-w", 0, 0, 200),
      px("pr-lead-w", "V2 date column", "--pr-lead-w", 92, 60, 200),
      toggle("f-read", "Reading time", "read", true),
    ],
  },
  {
    title: "Content",
    note: "The lab lists live and draft together in date order. The home page filters to live and /writing splits them, which is what V5 argues with.",
    controls: [
      toggle("f-state", "Status", "state", false),
      toggle("f-tags", "Tags", "tags", false),
    ],
  },
];
---

<DialKit
  eyebrow="Post lab"
  variants={variants}
  groups={groups}
  storageKey="postlab.v1"
  selector=".pr"
  stress={{
    id: "f-longtitle",
    label: "Long title",
    target: "pr-title",
    /* The longest real title on the site is 58 characters. This is 78,
       which is the length the next one could plausibly be. */
    text: "Chunking is the model decision nobody calls a model decision, and here is why",
    group: "Content",
  }}
/>
