---
import { Icon } from "astro-icon/components";
import Card from "./Card.astro";
import { normalise, type Collection } from "../data/collections";

interface Props {
  collection: Collection;
  class?: string;
}

const { collection, class: className = "" } = Astro.props;
const { slug, title, meta } = collection;
const cards = normalise(collection.items);

// Gradients are per-instance, so the id has to be too.
const fillId = `folder-${slug}`;

/* One continuous silhouette - tab and body share an outline, joined by a wide
   concave sweep (r=34). A tight fillet reads as a notch cut out of a card; the
   long curve is what makes it read as a folder. viewBox matches the wrapper's
   aspect so nothing skews. */
const back = `M0,26 A26,26 0 0 1 26,0 L154,0 A26,26 0 0 1 180,26
  A34,34 0 0 0 214,60 L370,60 A30,30 0 0 1 400,90 L400,310
  A30,30 0 0 1 370,340 L30,340 A30,30 0 0 1 0,310 Z`;
---

<a
  href={`/${slug}`}
  data-folder={slug}
  data-title={title}
  data-meta={meta}
  class:list={["folder group block", className]}
>
  <div class="relative aspect-20/17 w-full [perspective:1000px]">
    <svg viewBox="0 0 400 340" class="back absolute inset-0 h-full w-full" aria-hidden="true">
      <defs>
        <linearGradient id={fillId} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#f4f4f4"></stop>
          <stop offset="1" stop-color="#e2e2e2"></stop>
        </linearGradient>
      </defs>
      <path d={back} fill={`url(#${fillId})`}></path>
      <path d={back} fill="none" stroke="white" stroke-opacity="0.8"></path>
    </svg>

    {/* contents - sized in % of the folder so cards keep their own shape */}
    <div class="absolute inset-0 z-0">
      {
        cards.map((card, i) => (
          <div
            data-folder-item
            data-w={card.w}
            data-kind={card.kind}
            class="item absolute left-1/2"
            style={`top:${card.top}%;width:${card.w}%;margin-left:${-card.w / 2}%;aspect-ratio:${card.ratio}`}
          >
            <Card card={card} />
          </div>
        ))
      }
    </div>

    {/* front flap - the only other edge, so it reads as a fold, not a card */}
    <div
      data-folder-flap
      class="flap absolute inset-x-0 top-[24%] bottom-0 z-10 inset-ring inset-ring-white/60 [transform-origin:bottom_center] [box-shadow:0_-2px_6px_-1px_rgb(0_0_0/0.08)]"
    >
      <div class="absolute inset-x-0 bottom-0 flex items-end justify-between p-5">
        <div class="min-w-0">
          <p class="truncate text-sm font-medium text-neutral-800">{title}</p>
          {meta && <p class="mt-0.5 truncate text-xs text-neutral-500">{meta}</p>}
        </div>
        <Icon name="ph:arrow-up-right-bold" class="size-4 shrink-0 text-neutral-400" />
      </div>
    </div>
  </div>
</a>

<style>
  .folder {
    transition: transform 160ms var(--ease-out);
    outline: none;
  }

  /* Three stacked shadows rather than one: a tight contact shadow to seat the
     folder, a mid layer for form, and a wide ambient one for depth. Each is faint
     on its own - a single shadow dark enough to read here would look like a drop
     shadow instead of light. drop-shadow follows the folder's silhouette, which
     box-shadow can't do around the tab. */
  .back {
    filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.06))
      drop-shadow(0 6px 12px rgb(0 0 0 / 0.06))
      drop-shadow(0 18px 32px rgb(0 0 0 / 0.07));
  }

  /* The back panel's corners are SVG units that scale with the folder, so a fixed
     rem radius here drifts out of sync at any size but one. Percentage radii track
     it exactly: r=30 against a 400-wide viewBox and a 258.4-tall flap. */
  .flap {
    border-radius: 7.5% / 11.6%;
    /* Frosted glass: the tint has to stay thin enough to see through, and the
       saturation boost puts back the colour that blurring washes out. */
    background-image: linear-gradient(
      to bottom,
      rgb(255 255 255 / 0.5),
      rgb(255 255 255 / 0.38)
    );
    backdrop-filter: blur(16px) saturate(180%);
  }

  /* Presses should feel heard, but only where there's a real pointer. */
  @media (hover: hover) and (pointer: fine) {
    .folder:active {
      transform: scale(0.98);
    }
  }
</style>

{/* Stage chrome is created by the script, so these can't be scoped styles -
    Astro's scope attribute never lands on JS-built elements. */}
<style is:global>
  .fstage {
    position: fixed;
    inset: 0;
    z-index: 40;
    background: rgb(250 250 250 / 0.86);
    backdrop-filter: blur(24px) saturate(140%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 240ms var(--ease-out);
  }

  .fstage.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .fstage-bar {
    position: absolute;
    inset: 0 0 auto;
    display: flex;
    align-items: start;
    justify-content: space-between;
    padding: 1.5rem;
  }

  .fstage-title {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-neutral-800);
  }

  .fstage-meta {
    margin-top: 0.125rem;
    font-size: 0.75rem;
    color: var(--color-neutral-500);
  }

  .fstage-close {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    cursor: pointer;
    color: var(--color-neutral-500);
    background: rgb(255 255 255 / 0.7);
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.05);
    transition:
      color 160ms var(--ease-out),
      transform 160ms var(--ease-out);
  }

  .fstage-close svg {
    width: 1rem;
    height: 1rem;
  }

  .fstage-close:active {
    transform: scale(0.94);
  }

  @media (hover: hover) and (pointer: fine) {
    .fstage-close:hover {
      color: var(--color-neutral-800);
    }
  }

  .fstage-hint {
    position: absolute;
    inset: auto 0 1.75rem;
    text-align: center;
    font-size: 0.75rem;
    color: var(--color-neutral-400);
  }

  /* The staged folder rises above the scrim, and its press feedback is retired
     while the stage owns the motion. !important because the scoped .folder
     rules compile to equal specificity. */
  a.folder.is-stage {
    position: relative;
    z-index: 50;
    transition: none !important;
    transform: none !important;
  }

  .folder.is-stage [data-folder-flap] {
    pointer-events: none;
  }

  .folder.is-stage [data-folder-item] {
    cursor: pointer;
  }

  /* In the folder a note is a cropped miniature page; on stage the same card
     is the reading surface, so it gets to scroll. */
  .folder.is-stage .note {
    overflow-y: auto;
  }

  /* --radius is a fixed cqw proportion of the card's own width, which is right
     at folder scale (a few px) but reads as over-rounded once the same card is
     300–800px on stage - corner radius has to shrink relative to size to keep
     looking like a corner rather than a stadium shape.

     This is its own class, not is-stage: is-stage only comes off once the
     closing cards have fully landed and the flap has shut, which is exactly
     the wrong moment for this — it made the radius snap back visibly on an
     already-settled card. is-scaled flips at the instant the flight starts in
     either direction, so it's mid-transition (and masked by everything else
     moving) by the time you'd notice it. */
  .folder.is-scaled .frame {
    --radius: 3.5cqw;
  }
</style>

<script>
  import { animate, hover } from "motion";

  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const instant = { duration: 0 } as const;
  const spring = (s: object) => (reduced ? instant : s);

  /* Hover springs: showing off on open, out of the way on close, quick when
     singling out one card (that happens too often to bounce like a toy).
     Stage springs: the flight out to centre stage, steps between cards, the
     flight home, and the flap shutting over the landed cards. */
  const openSpring = { type: "spring", duration: 0.55, bounce: 0.35 } as const;
  const closeSpring = { type: "spring", duration: 0.3, bounce: 0.1 } as const;
  const focusSpring = { type: "spring", duration: 0.3, bounce: 0.18 } as const;
  const flingSpring = { type: "spring", duration: 0.45, bounce: 0.2 } as const;
  const stageSpring = { type: "spring", duration: 0.55, bounce: 0.18 } as const;
  const homeSpring = { type: "spring", duration: 0.5, bounce: 0.12 } as const;
  const shutSpring = { type: "spring", duration: 0.6, bounce: 0.25 } as const;

  const PUSH = 4; // how far neighbours yield on hover, in % of the folder's width
  const SIDE = 0.6; // side-card scale on stage
  const GAP = 0.08; // gap between staged cards, in units of card size

  /* Hashed off the index rather than Math.random, so a card is tilted the same
     way every visit - a photo that lands at a different angle each time reads
     as a glitch, not as character. */
  const tilt = (i: number) => {
    const n = Math.sin((i + 1) * 127.1) * 43758.5453;
    return (n - Math.floor(n)) * 12 - 6;
  };

  interface Controller {
    slug: string;
    folder: HTMLElement;
    wrap: HTMLElement;
    flap: HTMLElement;
    items: HTMLElement[];
    offset: (i: number) => number;
    gaps: number;
    closedPct: (i: number) => object;
    closedRotate: (i: number) => number;
    restack: () => void;
    deactivate: () => void;
  }

  const controllers = new Map<string, Controller>();

  let stage: {
    slug: string;
    c: Controller;
    active: number;
    base: { x: number; y: number }[];
    closing: boolean;
  } | null = null;

  /* ------------------------------------------------------------------ */
  /* Folders: hover fan, single-out, press                               */
  /* ------------------------------------------------------------------ */

  document.querySelectorAll<HTMLElement>("[data-folder]").forEach((folder) => {
    const slug = folder.dataset.folder ?? "";
    const flap = folder.querySelector<HTMLElement>("[data-folder-flap]")!;
    const wrap = flap.parentElement!;
    const items = [...folder.querySelectorAll<HTMLElement>("[data-folder-item]")];
    const mid = (items.length - 1) / 2;
    const offset = (i: number) => i - mid;

    /* Fanned out, the stack should just about span the folder. Cards are mixed
       widths, so the track is budgeted in folder-% off the widest card, then
       converted per card - translate percentages resolve against the element's
       own width, so an identical offset moves a narrow card further. */
    const gaps = Math.max(items.length - 1, 1);
    const widthOf = (el: HTMLElement) => Number(el.dataset.w) || 36;
    const step = (100 - Math.max(...items.map(widthOf))) / gaps;
    const toEl = (i: number, folderPct: number) =>
      `${(folderPct / widthOf(items[i])) * 100}%`;

    let expanded = false;
    let focused: number | null = null;

    // Centre card sits on top of the stack, the rest tuck behind it.
    const naturalZ = (i: number) => items.length - Math.round(Math.abs(offset(i)));
    const restack = () =>
      items.forEach((item, i) => {
        item.style.zIndex = String(i === focused ? items.length + 1 : naturalZ(i));
      });

    const closedRotate = (i: number) => offset(i) * (6 / gaps);
    const closedPct = (i: number) => ({
      x: toEl(i, offset(i) * 6),
      y: "0%",
      rotate: closedRotate(i),
      scale: 1,
      opacity: 1,
    });

    const positionOf = (i: number) => {
      if (!expanded) return closedPct(i);
      /* The singled-out card straightens up and rises, the way you'd pull one
         print out of a fanned stack to look at it; the rest lean away. */
      const isFocus = i === focused;
      const yields = focused !== null && !isFocus;
      return {
        x: toEl(i, offset(i) * step + (yields ? Math.sign(i - focused!) * PUSH : 0)),
        y: isFocus ? "-34%" : "-24%",
        rotate: isFocus ? 0 : offset(i) * (11 / gaps),
        scale: isFocus ? 1.05 : 1,
      };
    };

    const apply = (s: object, stagger = 0) =>
      items.forEach((item, i) =>
        animate(item, positionOf(i), {
          ...s,
          delay: Math.abs(offset(i)) * stagger,
        }),
      );

    restack();
    apply(instant);

    const setOpen = (isOpen: boolean) => {
      expanded = isOpen;
      if (!isOpen) focused = null;
      restack();
      animate(flap, { rotateX: isOpen ? -30 : 0 }, spring(isOpen ? openSpring : closeSpring));
      apply(spring(isOpen ? openSpring : closeSpring), isOpen ? 0.04 : 0.02);
    };

    controllers.set(slug, {
      slug,
      folder,
      wrap,
      flap,
      items,
      offset,
      gaps,
      closedPct,
      closedRotate,
      restack,
      deactivate() {
        expanded = false;
        focused = null;
      },
    });

    /* Every hover handler stands down while the stage owns the cards - the
       cleanup half too, or leaving the folder mid-stage would fold everything
       back into it. */
    hover(folder, () => {
      if (stage) return;
      setOpen(true);
      return () => {
        if (stage) return;
        setOpen(false);
      };
    });

    /* Whichever card was singled out last keeps the top of the stack until
       another takes it. Dropping it back on pointer-out would flick it behind
       its neighbours halfway through settling. */
    items.forEach((item, i) =>
      hover(item, () => {
        if (stage) return;
        focused = i;
        restack();
        apply(spring(focusSpring));
        return () => {
          if (stage) return;
          if (focused === i) focused = null;
          apply(spring(focusSpring));
        };
      }),
    );

    // Keyboard parity for the linked variant.
    folder.addEventListener("focusin", () => !stage && setOpen(true));
    folder.addEventListener("focusout", () => !stage && setOpen(false));

    folder.addEventListener("click", (event) => {
      event.preventDefault();
      if (stage?.c === controllers.get(slug) && !stage.closing) {
        // On stage, clicking a side card steps to it; anywhere else closes.
        const hit = (event.target as HTMLElement).closest<HTMLElement>("[data-folder-item]");
        if (hit) go(items.indexOf(hit));
        else requestClose();
        return;
      }
      if (!stage) openStage(slug, true);
    });
  });

  /* ------------------------------------------------------------------ */
  /* Stage: the folder's own cards fly out and become the carousel        */
  /* ------------------------------------------------------------------ */

  const overlay = document.createElement("div");
  overlay.className = "fstage";
  overlay.innerHTML = `
    <header class="fstage-bar">
      <div>
        <p class="fstage-title"></p>
        <p class="fstage-meta"></p>
      </div>
      <button class="fstage-close" type="button" aria-label="Close">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M4 4l8 8M12 4l-8 8" stroke-linecap="round"></path>
        </svg>
      </button>
    </header>
    <p class="fstage-hint">← →</p>`;
  document.body.appendChild(overlay);
  const overlayTitle = overlay.querySelector<HTMLElement>(".fstage-title")!;
  const overlayMeta = overlay.querySelector<HTMLElement>(".fstage-meta")!;

  const isNote = (c: Controller, i: number) => c.items[i].dataset.kind === "note";

  /* Where a card sits with no transform applied - offsetLeft/Top ignore
     transforms, so this is stable however far the fan has moved things. */
  const baseCenter = (c: Controller, i: number) => {
    const rect = c.wrap.getBoundingClientRect();
    const item = c.items[i];
    return {
      x: rect.left + item.offsetLeft + item.offsetWidth / 2,
      y: rect.top + item.offsetTop + item.offsetHeight / 2,
    };
  };

  /* Lay the cards out around the active one: centre card full size and
     straight, neighbours at 60% with their tilt back, everything on one
     vertical centreline. All in px - the stage is viewport-space. */
  const render = (opts: object, stagger = 0) => {
    if (!stage) return;
    const { c, active, base } = stage;
    const unit = Math.min(innerWidth * 0.46, innerHeight * 0.52);

    /* An article at centre gets a bigger budget than a picture - it's being
       read, not looked at. Same card, just allowed more of the screen. */
    const fit = (i: number) => {
      const item = c.items[i];
      if (i === active && isNote(c, i))
        return Math.min(
          (innerWidth * 0.6) / item.offsetWidth,
          (innerHeight * 0.82) / item.offsetHeight,
        );
      const s = unit / Math.max(item.offsetWidth, item.offsetHeight);
      return i === active ? s : s * SIDE;
    };

    /* Spacing pitches off the centre card's real visual width, so neighbours
       clear it whether it's a photo at unit size or a full-width article. */
    const halfCentre = (fit(active) * c.items[active].offsetWidth) / 2;
    const reach = halfCentre + unit * GAP + (unit * SIDE) / 2;

    c.items.forEach((item, i) => {
      const d = i - active;
      const x =
        d === 0
          ? innerWidth / 2
          : innerWidth / 2 +
            Math.sign(d) * (reach + (Math.abs(d) - 1) * unit * (SIDE + GAP));
      item.style.zIndex = String(30 + c.items.length - Math.abs(d));
      animate(
        item,
        {
          x: x - base[i].x,
          y: innerHeight / 2 - base[i].y,
          scale: fit(i),
          rotate: d === 0 ? 0 : tilt(i),
          opacity: Math.max(0.3, 1 - Math.abs(d) * 0.16),
        },
        { ...opts, delay: Math.abs(d) * stagger },
      );
    });
  };

  const openStage = (slug: string, push: boolean) => {
    const c = controllers.get(slug);
    if (!c || stage) return;
    stage = { slug, c, active: 0, base: [], closing: false };

    if (push) history.pushState({ folder: slug }, "", `/${slug}`);
    overlayTitle.textContent = c.folder.dataset.title ?? "";
    overlayMeta.textContent = c.folder.dataset.meta ?? "";
    overlay.classList.add("is-open");
    document.documentElement.style.overflow = "hidden";
    c.folder.classList.add("is-stage", "is-scaled");

    /* Hand each card from the %-based hover system to the px-based stage at
       exactly its current pose: the computed matrix is that pose, whatever
       hover state the click interrupted. Same visual, new units - so the
       springs launch from where the cards actually are. */
    c.items.forEach((item, i) => {
      stage!.base[i] = baseCenter(c, i);
      const m = new DOMMatrix(getComputedStyle(item).transform);
      animate(
        item,
        {
          x: m.e,
          y: m.f,
          scale: Math.hypot(m.a, m.b),
          rotate: (Math.atan2(m.b, m.a) * 180) / Math.PI,
        },
        instant,
      );
    });

    // The flap flings right out of the way and vanishes; the cards pour out.
    animate(c.flap, { rotateX: -80, opacity: 0 }, spring(flingSpring));
    render(spring(stageSpring), 0.05);
  };

  const closeStage = async () => {
    if (!stage || stage.closing) return;
    stage.closing = true;
    const { c } = stage;

    overlay.classList.remove("is-open");
    document.documentElement.style.overflow = "";
    // Radius starts easing back now, in step with the shrink about to start —
    // not after it, once the cards have already landed.
    c.folder.classList.remove("is-scaled");

    /* The reverse flight: cards fan back into the still-open folder first,
       centre card leading, then the flap swings up into view and shuts over
       them. Sequencing rather than overlapping is the point - the shut only
       reads if the cards are already home. */
    const w = c.wrap.offsetWidth;
    await Promise.all(
      c.items.map(
        (item, i) =>
          animate(
            item,
            {
              x: ((c.offset(i) * 6) / 100) * w,
              y: 0,
              rotate: c.closedRotate(i),
              scale: 1,
              opacity: 1,
            },
            { ...spring(homeSpring), delay: Math.abs(c.offset(i)) * 0.03 },
          ).finished,
      ),
    );

    await animate(c.flap, { rotateX: 0, opacity: 1 }, spring(shutSpring)).finished;

    /* Hand the cards back to the hover system in its own units - same pose.
       Deliberately NOT restacking: the card you were just looking at keeps the
       top of the pile, the way a real folder remembers what you last pulled
       out. Reordering here was a visible z-snap the instant they landed. */
    c.deactivate();
    c.items.forEach((item, i) => animate(item, c.closedPct(i), instant));
    c.folder.classList.remove("is-stage");
    stage = null;
  };

  const go = (next: number) => {
    if (!stage || stage.closing) return;
    const clamped = Math.max(0, Math.min(stage.c.items.length - 1, next));
    if (clamped === stage.active) return;
    stage.active = clamped;
    render(spring(stageSpring));
  };

  /* Closing goes through history when we put an entry there, so the back
     button and the close button are the same path - popstate does the work. */
  const requestClose = () => {
    if (history.state?.folder) history.back();
    else closeStage();
  };

  overlay.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;
    if (target === overlay || target.closest(".fstage-close")) requestClose();
  });

  addEventListener("keydown", (event) => {
    if (!stage || stage.closing) return;
    if (event.key === "ArrowRight") go(stage.active + 1);
    else if (event.key === "ArrowLeft") go(stage.active - 1);
    else if (event.key === "Escape") requestClose();
    else return;
    event.preventDefault();
  });

  addEventListener("popstate", () => {
    const slug = location.pathname.replace(/^\/+|\/+$/g, "");
    if (stage) {
      if (slug !== stage.slug) closeStage();
    } else if (controllers.has(slug)) {
      openStage(slug, false);
    }
  });

  /* Stage geometry is viewport-derived, so a resize invalidates both the base
     centres and the targets. Snap rather than animate - a resize is not a
     state change the user is watching. */
  addEventListener("resize", () => {
    if (!stage || stage.closing) return;
    stage.base = stage.c.items.map((_, i) => baseCenter(stage.c, i));
    render(instant);
  });
</script>
