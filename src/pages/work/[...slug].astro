---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";
import MetricStrip from "../../components/portfolio/MetricStrip.astro";
import DecisionList from "../../components/portfolio/DecisionList.astro";
import EvalCard from "../../components/portfolio/EvalCard.astro";
import Diagram from "../../components/portfolio/Diagram.astro";
import Section from "../../components/portfolio/Section.astro";
import Toast from "../../components/portfolio/Toast.astro";

export const getStaticPaths: GetStaticPaths = async () => {
  const systems = await getCollection("systems", ({ data }) => !data.draft);
  return systems.map((system) => ({
    params: { slug: system.id },
    props: { system },
  }));
};

const { system } = Astro.props;
const { data } = system;
const { Content } = await render(system);

const nav = [
  { id: "decisions", label: "Decisions" },
  { id: "evaluation", label: "Eval" },
];
---

<PageLayout title={`${data.title} — case study`} description={data.outcome} nav={nav}>
  <a href="/portfolio" class="text-xs text-ink-4 transition-colors duration-fast ease-out hover:text-ink">
    &larr; back
  </a>

  <h1 class="enter mt-8 max-w-2xl text-2xl leading-tight font-medium tracking-tight text-ink sm:text-3xl">
    {data.outcome}
  </h1>
  <p class="enter mt-3 text-[15px] text-ink-3" style="--enter-index:1">{data.title}</p>

  {/* Live demo is the second element on the page: only ~23% of ML
      practitioners have ever deployed, so it is the cheapest differentiator. */}
  <div class="enter mt-6 flex flex-wrap gap-2" style="--enter-index:2">
    {data.liveDemo && (
      <a href={data.liveDemo} class="flex items-center gap-2 rounded-well bg-ink px-4 py-2 text-[13px] font-medium text-ground transition-opacity duration-fast ease-out hover:opacity-90">
        <span class="h-1.5 w-1.5 rounded-full bg-ground"></span> Live demo
      </a>
    )}
    {data.artifacts.map((a) => (
      <a href={a.url} class="rounded-well px-4 py-2 text-[13px] ring-1 ring-line transition-colors duration-fast ease-out hover:bg-sunken hover:text-ink">
        {a.label ?? a.kind}
      </a>
    ))}
  </div>

  {data.relevanceNote && (
    <blockquote class="enter mt-8 border-l-2 border-line pl-4" style="--enter-index:3">
      <p class="text-[11px] text-ink-4">Why this is relevant</p>
      <p class="mt-1 text-[14px] leading-relaxed">{data.relevanceNote}</p>
    </blockquote>
  )}

  <div class="spine mt-(--space-section)">
    <Section id="measured" title="Measured">
      <MetricStrip metrics={data.metrics} />
    </Section>

    {data.diagram && (
      <Section id="architecture" title="Architecture" note="Legible without reading the prose below it.">
        <Diagram diagram={data.diagram} />
      </Section>
    )}

    {data.decisions.length > 0 && (
      <Section id="decisions" title="Decisions" note="What was chosen, what it cost, and what it changed downstream.">
        <DecisionList decisions={data.decisions} />
      </Section>
    )}

    {data.evals.length > 0 && (
      <Section id="evaluation" title="Evaluation">
        <div class="space-y-3">
          {data.evals.map((result) => <EvalCard result={result} />)}
        </div>
      </Section>
    )}

    {data.limitations.length > 0 && (
      <Section id="limitations" title="Limitations">
        <ul class="reveal space-y-2 text-[13px]">
          {data.limitations.map((l) => (
            <li class="flex gap-2"><span class="text-caution">&bull;</span>{l}</li>
          ))}
        </ul>
      </Section>
    )}

    <div class="reveal prose-sm max-w-none text-[14px] leading-relaxed">
      <Content />
    </div>

    {data.talkingPoint && (
      <aside class="reveal well">
        <p class="text-[11px] text-measured">Ask me about</p>
        <p class="mt-1.5 text-[14px] leading-relaxed">{data.talkingPoint}</p>
      </aside>
    )}
  </div>

  <Toast />
</PageLayout>
