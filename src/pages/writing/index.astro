---
/**
 * Writing.
 *
 * One surface for everything written: the essays (posts) and the
 * one-idea explainers (lab). The old writing index was a row list;
 * this page uses the card grid with the figure on top, because the
 * figures are the argument here and the rows buried them.
 *
 * The tilt (transitions.dev 19-card-tilt, reduced to a 3D lean plus
 * a cursor-tracked glare) lives on these cards and nowhere else: one
 * grid of tilting cards is a texture, a site of them is a novelty.
 *
 * Drafts render as a visible queue below, each with its real stage.
 * "Outlined" is information; "coming soon" is a promise with no date
 * on it, which is why the schema has no such option.
 */
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import PageLayout from "../../layouts/PageLayout.astro";
import Band from "../../components/ui/Band.astro";
import { machineWritingIndex } from "../../lib/machine";

const posts = (await getCollection("posts")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const live = posts.filter((p) => p.data.status === "live");
const drafts = posts.filter((p) => p.data.status === "draft");
const lab = (await getCollection("lab")).sort(
  (a, b) => a.data.order - b.data.order
);

const fmt = (d: Date) =>
  new Intl.DateTimeFormat("en-GB", {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
  })
    .format(d)
    .replace(/\//g, ".");

/* One card model for both kinds. Essays lead (they are dated and
   current), explainers follow in their curated order. */
const cards = [
  ...live.map((p) => ({
    slug: p.id,
    title: p.data.title,
    blurb: p.data.description,
    visual: p.data.cover,
    meta: `${fmt(p.data.date)} / ${p.data.readingTime}`,
    kind: "essay" as const,
  })),
  ...lab.map((e) => ({
    slug: e.id,
    title: e.data.title,
    blurb: e.data.blurb,
    visual: e.data.visual,
    meta: "explainer / one idea",
    kind: "explainer" as const,
  })),
];

const machineDoc = machineWritingIndex(
  live.map((p) => ({
    title: p.data.title,
    description: p.data.description,
    slug: p.id,
    date: p.data.date,
    readingTime: p.data.readingTime,
  })),
  drafts.map((p) => ({ title: p.data.title, stage: p.data.stage }))
);
---

<PageLayout
  machine={machineDoc}
  section="writing"
  title="Writing, Ashutosh Rana"
  description="Essays on measurement and one-idea explainers of the mechanisms underneath, each with a figure that carries the explanation."
>
  <Band
    title="Writing"
    count={cards.length}
    note="Essays on measurement, and one-idea explainers of the mechanisms underneath. Each carries a figure, because drawing something is how I find out whether I understood it."
    as="h1"
  >
    <ul class="grid gap-4 sm:grid-cols-2">
      {
        cards.map((card, i) => (
          <li class="reveal" style={`--enter-index:${i}`}>
            <a href={`/writing/${card.slug}`} class="t-tilt group block">
              <div class="t-tilt-card overflow-hidden rounded-xl border border-line-2 bg-surface">
                <img
                  src={card.visual}
                  alt=""
                  width="900"
                  height="600"
                  loading={i < 2 ? "eager" : "lazy"}
                  decoding="async"
                  class="block aspect-[9/5] w-full border-b border-line-2 bg-surface object-cover"
                />
                <div class="p-3.5">
                  <p class="relative inline-block text-ink">
                    <span class="link-draw-child relative">{card.title}</span>
                  </p>
                  <p class="mt-1 line-clamp-2 text-ink-3">{card.blurb}</p>
                  <p class="numeric mt-2.5 text-label tracking-[0.04em] text-ink-4 uppercase">
                    {card.meta}
                  </p>
                </div>
                <span class="t-tilt-glare" aria-hidden="true" />
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </Band>

  {
    drafts.length > 0 && (
      <Band
        title="In the queue"
        count={drafts.length}
        note="What is being written right now, with its real stage. No dates, because I would miss them."
      >
        <div class="rows border-t border-line-2">
          {drafts.map((post) => (
            <div class="flex items-center gap-3 py-3">
              <span
                class="grid size-9 shrink-0 place-items-center rounded-md border border-line-2 bg-surface text-ink-4"
                aria-hidden="true"
              >
                <Icon name="ph:pencil-simple-line" class="size-4" />
              </span>
              <span class="min-w-0 flex-1">
                <span class="block truncate text-ink-2">{post.data.title}</span>
                <span class="numeric mt-0.5 block text-label tracking-[0.04em] text-ink-4 uppercase">
                  {post.data.stage ?? "queued"}
                </span>
              </span>
              <span class="chip shrink-0 border-caution/40 text-caution">
                <span>Draft</span>
              </span>
            </div>
          ))}
        </div>
      </Band>
    )
  }
</PageLayout>

<style>
  /*
   * transitions.dev / 19-card-tilt. The pointer is tracked on the
   * flat outer wrapper, not the card that rotates: binding it to the
   * rotating element makes the edges slip under the cursor and the
   * hover flickers.
   */
  .t-tilt {
    perspective: 900px;
  }
  .t-tilt-card {
    position: relative;
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transform-style: preserve-3d;
    transition:
      transform var(--duration-moderate) var(--ease-out),
      border-color var(--motion-hover);
    will-change: transform;
  }
  .t-tilt:hover .t-tilt-card {
    border-color: var(--color-ink-4);
  }
  .t-tilt-glare {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--motion-hover);
    background: radial-gradient(
      220px circle at var(--gx, 50%) var(--gy, 50%),
      rgb(255 255 255 / 0.09),
      transparent 65%
    );
  }
  .t-tilt:hover .t-tilt-glare {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .t-tilt-card {
      transform: none !important;
      transition: border-color var(--motion-hover);
    }
    .t-tilt-glare {
      display: none;
    }
  }
</style>

<script>
  const MAX = 5; /* degrees. Past about 6 the text starts to smear. */

  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.querySelectorAll<HTMLElement>(".t-tilt").forEach((wrap) => {
      const card = wrap.querySelector<HTMLElement>(".t-tilt-card");
      const glare = wrap.querySelector<HTMLElement>(".t-tilt-glare");
      if (!card) return;

      wrap.addEventListener("pointermove", (e) => {
        const r = wrap.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width;
        const py = (e.clientY - r.top) / r.height;
        card.style.setProperty("--ry", `${(px - 0.5) * 2 * MAX}deg`);
        card.style.setProperty("--rx", `${-(py - 0.5) * 2 * MAX}deg`);
        glare?.style.setProperty("--gx", `${px * 100}%`);
        glare?.style.setProperty("--gy", `${py * 100}%`);
      });

      wrap.addEventListener("pointerleave", () => {
        card.style.setProperty("--ry", "0deg");
        card.style.setProperty("--rx", "0deg");
      });
    });
  }
</script>
