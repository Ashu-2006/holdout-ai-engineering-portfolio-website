---
/**
 * /playground/card - the project card lab.
 *
 * WHAT THIS PAGE IS FOR: dialling. One card, dead centre, and every
 * value that was a decision in the Figma node (31:1950) exposed as a
 * live control on the right. V1 is that node measured rather than
 * approximated, and it is what ships on / and /work; V2 to V5 are four
 * arguments about what the card could be instead, sharing its tokens so
 * the comparison stays a comparison.
 *
 * The frame, the stage and the panel are all shared with the other
 * labs. See LabShell and DialKit.
 */
import LabShell from "../../layouts/LabShell.astro";
import CardStage from "../../components/playground/CardStage.astro";
import CardDial from "../../components/playground/CardDial.astro";
---

<LabShell title="Card lab" storageKey="cardlab.v1">
  <CardStage />
  <CardDial />
</LabShell>
