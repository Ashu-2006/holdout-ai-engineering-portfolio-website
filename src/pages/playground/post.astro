---
/**
 * /playground/post - the writing list item lab.
 *
 * WHAT THIS PAGE IS FOR: dialling. A short list, dead centre, and
 * every value that was a decision in the shipped row exposed as a live
 * control on the right. V1 is the home page's row measured rather than
 * approximated; V2 to V5 are four arguments about what a writing index
 * could be instead, sharing its tokens so the comparison stays a
 * comparison of layouts.
 *
 * A LIST, NOT ONE ITEM, and the Rows dial collapses it to one. Half of
 * what a row is made of only exists in relation to its neighbours: the
 * separating rule, the vertical rhythm, and the right column that has
 * to form a rail rather than three loose dates.
 *
 * The frame, the stage and the panel are shared with /playground/card.
 * See LabShell and DialKit.
 */
import LabShell from "../../layouts/LabShell.astro";
import PostStage from "../../components/playground/PostStage.astro";
import PostDial from "../../components/playground/PostDial.astro";
---

<LabShell title="Post lab" storageKey="postlab.v1">
  <PostStage />
  <PostDial />
</LabShell>
